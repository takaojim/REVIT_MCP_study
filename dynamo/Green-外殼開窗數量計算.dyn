{
  "Uuid": "98035b7f-3586-48cd-88b6-37b1485f5fd4",
  "IsCustomNode": false,
  "Description": "",
  "Name": "Green-外殼開窗數量計算",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "abcec05e13fc4118a348c76295fcb057",
      "Name": "String",
      "Type": "string",
      "Type2": "string",
      "Value": "產出開窗方位跟數量公EEWH使用--明細表\"EEWH 綠建築方位檢討表\"窗戶有修改宅型\r\noutdoor_keywords\r\n陽台, 花台, 露台,陽臺, 花臺, 露臺...算是室外 ",
      "Description": "建立一個字串。"
    },
    {
      "Id": "d170654e36b0426a9c3dbd0de0365ecc",
      "Name": "1.選擇階段",
      "Type": "selection",
      "Type2": "dropdownSelection",
      "Value": "",
      "Description": "從作用中的文件選取現有的 Revit 階段。",
      "SelectedIndex": -1
    },
    {
      "Id": "4963091559dd43dabef01d61ee8110d7",
      "Name": "2.產生明細表?",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "啟用在 True 與 False 之間選取"
    }
  ],
  "Outputs": [
    {
      "Id": "905b00e5b8e548d8bd41a8cd7117f1b2",
      "Name": "Watch",
      "Type": "string",
      "InitialValue": "運算完成！已自動寫入方位，並完美建立含數量、排序、過濾的明細表。",
      "Description": "視覺化節點的輸出"
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 載入 Dynamo 服務\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 脫外套 (Unwrap) 處理 IN[0]\r\nphase = UnwrapElement(IN[0]) if isinstance(IN[0], list) else UnwrapElement(IN[0])\r\n\r\n# 16 方位計算\r\ndef get_16_direction(vector_x, vector_y):\r\n    angle_rad = math.atan2(vector_x, vector_y)\r\n    angle_deg = math.degrees(angle_rad)\r\n    if angle_deg < 0: angle_deg += 360\r\n    idx = int((angle_deg + 11.25) / 22.5) % 16\r\n    dirs = [\"北 (N)\", \"北北東 (NNE)\", \"東北 (NE)\", \"東北東 (ENE)\",\r\n            \"東 (E)\", \"東南東 (ESE)\", \"東南 (SE)\", \"南南東 (SSE)\",\r\n            \"南 (S)\", \"南南西 (SSW)\", \"西南 (SW)\", \"西南西 (WSW)\",\r\n            \"西 (W)\", \"西北西 (WNW)\", \"西北 (NW)\", \"北北西 (NNW)\"]\r\n    return dirs[idx]\r\n\r\n# 取得階段 ID 的兼容寫法 (Revit 2024+)\r\ndef get_phase_id(ph):\r\n    return ph.Id.Value if hasattr(ph.Id, \"Value\") else ph.Id.IntegerValue\r\n\r\n# 取得樓層參數\r\ndef get_level_param_id(doc):\r\n    params = [BuiltInParameter.SCHEDULE_LEVEL_PARAM, BuiltInParameter.FAMILY_LEVEL_PARAM, BuiltInParameter.INSTANCE_REFERENCE_LEVEL_PARAM]\r\n    for p in params:\r\n        param_id = ElementId(p)\r\n        if doc.GetElement(param_id) or True: # 確保不報錯\r\n            return param_id\r\n    return ElementId(BuiltInParameter.SCHEDULE_LEVEL_PARAM)\r\n\r\n# 執行運算\r\nall_windows = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Windows).WhereElementIsNotElementType().ToElements()\r\nproject_pos = doc.ActiveProjectLocation.GetProjectPosition(XYZ.Zero)\r\ntrue_north_rotation = Transform.CreateRotation(XYZ.BasisZ, project_pos.Angle)\r\n\r\n# 小明哥專屬的戶外關鍵字 (含異體字)\r\noutdoor_keywords = [\"陽台\", \"花台\", \"露台\", \"雨遮\", \"戶外\", \"陽臺\", \"花臺\", \"露臺\"]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor win in all_windows:\r\n    # 檢查階段\r\n    if phase:\r\n        p_id = get_phase_id(phase)\r\n        c_id = win.CreatedPhaseId.Value if hasattr(win.CreatedPhaseId, \"Value\") else win.CreatedPhaseId.IntegerValue\r\n        if c_id != p_id: continue\r\n\r\n    # 改用 FacingOrientation (窗戶家族正面朝向) 解決牆角誤判問題\r\n    if not hasattr(win, \"FacingOrientation\"): continue\r\n    normal = win.FacingOrientation\r\n    \r\n    # 簡單室內外判斷\r\n    win_pt = win.Location.Point\r\n    win_level = doc.GetElement(win.LevelId)\r\n    if not win_level: continue\r\n    \r\n    pt1 = XYZ(win_pt.X + normal.X*2, win_pt.Y + normal.Y*2, win_level.Elevation + 1)\r\n    pt2 = XYZ(win_pt.X - normal.X*2, win_pt.Y - normal.Y*2, win_level.Elevation + 1)\r\n    \r\n    room1 = doc.GetRoomAtPoint(pt1, phase) if phase else None\r\n    room2 = doc.GetRoomAtPoint(pt2, phase) if phase else None\r\n    \r\n    r1_name = room1.get_Parameter(BuiltInParameter.ROOM_NAME).AsString() if room1 else \"\"\r\n    r2_name = room2.get_Parameter(BuiltInParameter.ROOM_NAME).AsString() if room2 else \"\"\r\n    \r\n    is_r1_out = (room1 is None) or any(kw in r1_name for kw in outdoor_keywords)\r\n    is_r2_out = (room2 is None) or any(kw in r2_name for kw in outdoor_keywords)\r\n    \r\n    # 無視語言，直接用 Revit 底層 ID 抓取「備註 (Comments)」參數\r\n    comments_param = win.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\r\n    \r\n    if comments_param:\r\n        if not (is_r1_out or is_r2_out):\r\n            comments_param.Set(\"室內不計\")\r\n        else:\r\n            # 校正正北\r\n            true_v = true_north_rotation.OfVector(normal if is_r1_out else normal.Negate())\r\n            comments_param.Set(get_16_direction(true_v.X, true_v.Y))\r\n\r\n# 處理明細表 (如果沒有才建立)\r\nschedule_name = \"EEWH 綠建築方位檢討表\"\r\nschedules = FilteredElementCollector(doc).OfClass(ViewSchedule).ToElements()\r\ntarget_schedule = next((s for s in schedules if s.Name == schedule_name), None)\r\n\r\nif not target_schedule:\r\n    target_schedule = ViewSchedule.CreateSchedule(doc, ElementId(BuiltInCategory.OST_Windows))\r\n    target_schedule.Name = schedule_name\r\n    def_s = target_schedule.Definition\r\n    \r\n    # 取得明細表支援的所有可用欄位，確保絕對相容\r\n    sf_list = def_s.GetSchedulableFields()\r\n    def get_sf(param_id):\r\n        for sf in sf_list:\r\n            if sf.ParameterId == param_id:\r\n                return sf\r\n        return None\r\n        \r\n    sf_level = get_sf(get_level_param_id(doc))\r\n    sf_mark = get_sf(ElementId(BuiltInParameter.ALL_MODEL_TYPE_MARK))\r\n    sf_width = get_sf(ElementId(BuiltInParameter.WINDOW_WIDTH))\r\n    sf_height = get_sf(ElementId(BuiltInParameter.WINDOW_HEIGHT))\r\n    sf_comments = get_sf(ElementId(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)) or get_sf(ElementId(BuiltInParameter.ALL_MODEL_COMMENTS))\r\n    \r\n    # 依序加入欄位\r\n    f_level = def_s.AddField(sf_level) if sf_level else None\r\n    f_mark = def_s.AddField(sf_mark) if sf_mark else None\r\n    f_width = def_s.AddField(sf_width) if sf_width else None\r\n    f_height = def_s.AddField(sf_height) if sf_height else None\r\n    f_comments = def_s.AddField(sf_comments) if sf_comments else None\r\n    \r\n    # 【無視語系】強制加入「數量(Count)」欄位\r\n    f_count = def_s.AddField(ScheduleFieldType.Count)\r\n    \r\n    # 設定篩選、排序、群組與頁尾\r\n    if f_comments:\r\n        def_s.AddFilter(ScheduleFilter(f_comments.FieldId, ScheduleFilterType.NotEqual, \"室內不計\"))\r\n        \r\n    if f_level:\r\n        sort_level = ScheduleSortGroupField(f_level.FieldId)\r\n        sort_level.HasFooter = True\r\n        sort_level.HasBlankLine = True\r\n        def_s.AddSortGroupField(sort_level)\r\n        \r\n    if f_comments:\r\n        def_s.AddSortGroupField(ScheduleSortGroupField(f_comments.FieldId))\r\n        \r\n    if f_mark:\r\n        def_s.AddSortGroupField(ScheduleSortGroupField(f_mark.FieldId))\r\n        \r\n    # 取消逐項列舉，讓數量自動加總\r\n    def_s.IsItemized = False\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = \"運算完成！已自動寫入方位，並完美建立含數量、排序、過濾的明細表。\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b616e230e12144829b08c19a5b498154",
      "NodeType": "PythonScriptNode",
