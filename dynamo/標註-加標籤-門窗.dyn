    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 載入 Revit 服務\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# ========================================================\r\n# 🎛️ 讀取 IN[0] & IN[1] 設定\r\n# ========================================================\r\nif IN[0] is None:\r\n    apply_to_all_views = False\r\nelif isinstance(IN[0], list):\r\n    apply_to_all_views = IN[0][0]\r\nelse:\r\n    apply_to_all_views = IN[0]\r\n\r\nif IN[1] is None:\r\n    paper_offset_mm = 5.0  \r\nelif isinstance(IN[1], list):\r\n    paper_offset_mm = IN[1][0]\r\nelse:\r\n    paper_offset_mm = IN[1]\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nactive_view = doc.ActiveView\r\n\r\n# ========================================================\r\n# 🗺️ 決定要處理的視圖清單 (【ID字串】絕對比對法！)\r\n# ========================================================\r\nviews_to_process = []\r\ntarget_type_name = \"未知類型\" \r\n\r\nif apply_to_all_views:\r\n    # 💡 核心防護 1：把目標類型 ID 強制轉成「字串 (String)」\r\n    target_type_id_str = str(active_view.GetTypeId())\r\n    \r\n    # 💡 核心防護 2：繞過 .Name 報錯 Bug，安全抓取目標名稱用於顯示\r\n    target_type_elem = doc.GetElement(active_view.GetTypeId())\r\n    if target_type_elem:\r\n        param = target_type_elem.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\r\n        if param:\r\n            target_type_name = param.AsString()\r\n            \r\n    # 3. 篩選所有同類型視圖\r\n    all_views = FilteredElementCollector(doc).OfClass(View).ToElements()\r\n    for v in all_views:\r\n        if v.IsTemplate: continue\r\n        \r\n        # 🐛 終極抓蟲：直接比對字串化的 ID，避開屬性讀取錯誤！\r\n        if str(v.GetTypeId()) == target_type_id_str:\r\n            views_to_process.append(v)\r\nelse:\r\n    views_to_process.append(active_view)\r\n\r\n# 開始交易\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\ntotal_deleted = 0\r\ntotal_created = 0\r\nerror_messages = []\r\n\r\n# 建立過濾器\r\ndoor_filter = ElementCategoryFilter(BuiltInCategory.OST_Doors)\r\nwindow_filter = ElementCategoryFilter(BuiltInCategory.OST_Windows)\r\nor_filter = LogicalOrFilter(door_filter, window_filter)\r\n\r\n# ========================================================\r\n# 🔄 開始跨視圖大迴圈！\r\n# ========================================================\r\nfor v in views_to_process:\r\n    \r\n    # 📐 比例換算\r\n    try:\r\n        v_scale = v.Scale if hasattr(v, 'Scale') and v.Scale else 100\r\n        window_offset = (paper_offset_mm * v_scale) / 304.8\r\n    except:\r\n        window_offset = 1.5 \r\n\r\n    # 1. 刪除舊標籤\r\n    try:\r\n        tag_collector = FilteredElementCollector(doc, v.Id).OfClass(IndependentTag).ToElements()\r\n        for tag in tag_collector:\r\n            if tag.Category is not None:\r\n                tag_category = tag.Category.Name\r\n                if \"Window\" in tag_category or \"窗\" in tag_category or \"Door\" in tag_category or \"門\" in tag_category:\r\n                    doc.Delete(tag.Id)\r\n                    total_deleted += 1\r\n    except:\r\n        pass \r\n\r\n    # 2. 建立新標籤\r\n    collector = FilteredElementCollector(doc, v.Id) \\\r\n                .WherePasses(or_filter) \\\r\n                .WhereElementIsNotElementType() \\\r\n                .ToElements()\r\n                \r\n    for elem in collector:\r\n        try:\r\n            ref = Reference(elem)\r\n            bbox = elem.get_BoundingBox(v)\r\n            if bbox is None: continue \r\n            \r\n            cx = (bbox.Min.X + bbox.Max.X) / 2.0\r\n            cy = (bbox.Min.Y + bbox.Max.Y) / 2.0\r\n            cz = (bbox.Min.Z + bbox.Max.Z) / 2.0\r\n            center_pt = XYZ(cx, cy, cz)\r\n            \r\n            category_name = elem.Category.Name\r\n            \r\n            # 如果是窗戶，依照 FacingOrientation 偏移\r\n            if \"Window\" in category_name or \"窗\" in category_name:\r\n                try:\r\n                    facing_vec = elem.FacingOrientation \r\n                    pt = center_pt.Add(facing_vec.Multiply(window_offset))\r\n                except:\r\n                    pt = center_pt\r\n            else:\r\n                pt = center_pt\r\n                \r\n            # 建立標籤\r\n            tag = IndependentTag.Create(doc, v.Id, ref, False, TagMode.TM_ADDBY_CATEGORY, TagOrientation.Horizontal, pt)\r\n            doc.Regenerate()\r\n            tag.TagHeadPosition = pt\r\n            total_created += 1\r\n            \r\n        except Exception as e:\r\n            error_messages.append(str(e))\r\n\r\n# 結束交易\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# ========================================================\r\n# 📊 輸出超狂戰績\r\n# ========================================================\r\nif total_created == 0 and len(error_messages) > 0:\r\n    unique_errors = list(set(error_messages))\r\n    OUT = \"❌ 失敗！\\nRevit 錯誤訊息：\\n{}\".format(\"\\n\".join(unique_errors))\r\nelse:\r\n    OUT = \"✅ 報告小明哥哥！PRO模式精準鎖定成功！\\n🎯 目標視圖類型：[{}]\\n🧹 清除 {} 個舊標籤\\n➕ 新增 {} 個新標籤！\".format(target_type_name, total_deleted, total_created)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
