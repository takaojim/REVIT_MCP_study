      "Name": "2.窗標籤與牆距離(3.5mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "3.5",
      "NumberType": "Double",
      "Description": "建立一個數字。"
    }
  ],
  "Outputs": [
    {
      "Id": "4a9a084589ae4ec5b698338ce5bf8053",
