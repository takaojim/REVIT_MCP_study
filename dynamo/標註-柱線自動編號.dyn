    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport re\r\n\r\n# 匯入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- 定義名稱遞增函式 ---\r\ndef get_next_name(start_val, index):\r\n    # 情況 1: 純數字 (1, 2, 3...)\r\n    if start_val.isdigit():\r\n        return str(int(start_val) + index)\r\n    \r\n    # 情況 2: 純字母 (A, B, C...)\r\n    elif start_val.isalpha() and len(start_val) == 1:\r\n        return chr(ord(start_val) + index)\r\n    \r\n    # 情況 3: 前綴 + 數字 (X1, Y1, Grid-1...)\r\n    else:\r\n        match = re.search(r'([a-zA-Z]+)(\\d+)', start_val)\r\n        if match:\r\n            prefix = match.group(1)\r\n            num = int(match.group(2))\r\n            return \"{}{}\".format(prefix, num + index)\r\n        return start_val + str(index)\r\n\r\n# 1. 抓取所有柱網\r\ngrids = FilteredElementCollector(doc).OfClass(Grid).ToElements()\r\n\r\nh_start = str(IN[0])\r\nv_start = str(IN[1])\r\n\r\nhorizontal_grids = []\r\nvertical_grids = []\r\n\r\n# 2. 判斷水平或垂直 (依據線段向量)\r\nfor g in grids:\r\n    curve = g.Curve\r\n    p1 = curve.GetEndPoint(0)\r\n    p2 = curve.GetEndPoint(1)\r\n    \r\n    dx = abs(p1.X - p2.X)\r\n    dy = abs(p1.Y - p2.Y)\r\n    \r\n    # 如果 Y 的變化量大於 X，代表它偏向垂直線；反之為水平線\r\n    if dy > dx:\r\n        vertical_grids.append(g)\r\n    else:\r\n        horizontal_grids.append(g)\r\n\r\n# 3. 排序\r\n# 垂直線：由左至右 (X 座標由小到大)\r\nvertical_grids.sort(key=lambda x: x.Curve.GetEndPoint(0).X + x.Curve.GetEndPoint(1).X)\r\n# 水平線：由下至上 (Y 座標由小到大)\r\nhorizontal_grids.sort(key=lambda x: x.Curve.GetEndPoint(0).Y + x.Curve.GetEndPoint(1).Y)\r\n\r\n# --- 開始執行變更 ---\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# Step A: 先全部改為臨時名稱 (避免名稱衝突)\r\nfor i, g in enumerate(grids):\r\n    try:\r\n        g.Name = \"TEMP_\" + str(1000 + i)\r\n    except:\r\n        pass\r\n\r\n# Step B: 依照排序重新編號\r\n# 處理水平 (IN[0])\r\nfor i, g in enumerate(horizontal_grids):\r\n    g.Name = get_next_name(h_start, i)\r\n\r\n# 處理垂直 (IN[1])\r\nfor i, g in enumerate(vertical_grids):\r\n    g.Name = get_next_name(v_start, i)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = \"完成！已重新編號 {} 條水平柱網與 {} 條垂直柱網。\".format(len(horizontal_grids), len(vertical_grids))",
      "Engine": "CPython3",
      "VariableInputPorts": true,
