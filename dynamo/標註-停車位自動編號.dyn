      "Description": "視覺化節點的輸出"
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 載入事務管理\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- 1. 讀取 Dynamo 輸入 ---\r\nstart_num_cars = int(IN[0])     # 汽車起始編號 \r\nstart_num_motors = int(IN[1])   # 機車起始編號 \r\nparam_name = IN[2]              # 參數名稱 \r\n\r\n# --- 2. 核心功能：座標分群排序函數 ---\r\ndef get_sorted_elements(elements):\r\n    if not elements:\r\n        return []\r\n    \r\n    data_list = []\r\n    for e in elements:\r\n        loc = e.Location\r\n        if isinstance(loc, LocationPoint):\r\n            pt = loc.Point\r\n            data_list.append({\"elem\": e, \"pt\": pt, \"x\": pt.X, \"y\": pt.Y})\r\n    \r\n    cluster_tolerance = 12.0 \r\n    clusters = []\r\n    visited = set()\r\n    \r\n    for i, d1 in enumerate(data_list):\r\n        if i in visited: continue\r\n        current_cluster = []\r\n        queue = [i]\r\n        visited.add(i)\r\n        while queue:\r\n            curr_idx = queue.pop(0)\r\n            current_cluster.append(data_list[curr_idx])\r\n            for j, d2 in enumerate(data_list):\r\n                if j not in visited:\r\n                    dist = ((data_list[curr_idx][\"pt\"].X - d2[\"pt\"].X)**2 + (data_list[curr_idx][\"pt\"].Y - d2[\"pt\"].Y)**2)**0.5\r\n                    if dist < cluster_tolerance:\r\n                        visited.add(j)\r\n                        queue.append(j)\r\n        clusters.append(current_cluster)\r\n    \r\n    cluster_info = []\r\n    for c in clusters:\r\n        cy = sum([item[\"y\"] for item in c]) / float(len(c))\r\n        cx = sum([item[\"x\"] for item in c]) / float(len(c))\r\n        cluster_info.append({\"cluster\": c, \"cy\": cy, \"cx\": cx})\r\n    \r\n    cluster_info.sort(key=lambda c: c[\"cy\"], reverse=True) \r\n    \r\n    block_rows = []\r\n    curr_b_row = []\r\n    if cluster_info:\r\n        curr_b_row.append(cluster_info[0])\r\n        for c in cluster_info[1:]:\r\n            if abs(c[\"cy\"] - curr_b_row[0][\"cy\"]) < 15.0:\r\n                curr_b_row.append(c)\r\n            else:\r\n                block_rows.append(curr_b_row)\r\n                curr_b_row = [c]\r\n        block_rows.append(curr_b_row)\r\n    \r\n    sorted_clusters = []\r\n    for b_row in block_rows:\r\n        b_row.sort(key=lambda c: c[\"cx\"]) \r\n        for c in b_row: sorted_clusters.append(c[\"cluster\"])\r\n    \r\n    final_ordered = []\r\n    for c in sorted_clusters:\r\n        c.sort(key=lambda item: item[\"y\"], reverse=True)\r\n        rows = []\r\n        curr_row = []\r\n        if c:\r\n            curr_row.append(c[0])\r\n            for item in c[1:]:\r\n                if abs(item[\"y\"] - curr_row[0][\"y\"]) < 5.0:\r\n                    curr_row.append(item)\r\n                else:\r\n                    rows.append(curr_row)\r\n                    curr_row = [item]\r\n            rows.append(curr_row)\r\n        for row in rows:\r\n            row.sort(key=lambda item: item[\"x\"])\r\n            for r in row: final_ordered.append(r[\"elem\"])\r\n            \r\n    return final_ordered\r\n\r\n# --- 3. 收集目前視圖中的所有停車位並分類 ---\r\nactive_view_id = doc.ActiveView.Id \r\ncollector = FilteredElementCollector(doc, active_view_id).OfCategory(BuiltInCategory.OST_Parking).WhereElementIsNotElementType()\r\n\r\ncars_to_process = []\r\nmotors_to_process = []\r\n\r\nfor e in collector:\r\n    if not isinstance(e, FamilyInstance): continue\r\n    \r\n    # 🔴 核心修正：同時抓取「類型名稱」與「族群名稱」\r\n    type_name = e.Name               # 取得類型名稱 (例如: 1m x 2m 法定停車位(機車))\r\n    fam_name = e.Symbol.Family.Name  # 取得族群名稱 (例如: 法規停車位_V4)\r\n    \r\n    # 只要類型或族群名稱其中一個包含「機車」，就判定為機車位\r\n    if \"機車\" in type_name or \"機車\" in fam_name:\r\n        motors_to_process.append(e)\r\n    else:\r\n        cars_to_process.append(e)\r\n\r\n# --- 4. 分別執行排序 ---\r\nsorted_cars = get_sorted_elements(cars_to_process)\r\nsorted_motors = get_sorted_elements(motors_to_process)\r\n\r\n# --- 5. 寫入參數 ---\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# 處理汽車編號\r\ncurrent_car = start_num_cars\r\nfor car in sorted_cars:\r\n    p = car.LookupParameter(param_name)\r\n    if p and not p.IsReadOnly:\r\n        val = str(current_car) if p.StorageType == StorageType.String else current_car\r\n        p.Set(val)\r\n        current_car += 1\r\n\r\n# 處理機車編號\r\ncurrent_motor = start_num_motors\r\nfor motor in sorted_motors:\r\n    p = motor.LookupParameter(param_name)\r\n    if p and not p.IsReadOnly:\r\n        val = str(current_motor) if p.StorageType == StorageType.String else current_motor\r\n        p.Set(val)\r\n        current_motor += 1\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# --- 6. 輸出結果 ---\r\nOUT = {\r\n    \"1_鎖定視圖\": doc.ActiveView.Name,\r\n    \"2_汽車編號數量\": len(sorted_cars),\r\n    \"3_機車編號數量\": len(sorted_motors),\r\n    \"4_總計編號數量\": len(sorted_cars) + len(sorted_motors)\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
