    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 暴力搜查所有尺寸標註\r\ndims = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Dimensions).WhereElementIsNotElementType().ToElements()\r\n\r\ncount = 0\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor dim in dims:\r\n    try:\r\n        dim_name = dim.Name\r\n        \r\n        # 只要不是文公尺，就不動它\r\n        if dim_name is None or \"文公尺\" not in dim_name:\r\n            continue\r\n            \r\n        is_multi = False\r\n        try:\r\n            if dim.Segments is not None and dim.Segments.Size > 0:\r\n                is_multi = True\r\n        except: pass\r\n            \r\n        if is_multi:\r\n            for seg in dim.Segments:\r\n                try:\r\n                    # 溫柔的暴力：上下左右的文字，全部擦掉！\r\n                    seg.Suffix = \"\"\r\n                    seg.Below = \"\"\r\n                    seg.Prefix = \"\"\r\n                    seg.Above = \"\"\r\n                    count += 1\r\n                except: pass\r\n        else:\r\n            try:\r\n                # 溫柔的暴力：上下左右的文字，全部擦掉！\r\n                dim.Suffix = \"\"\r\n                dim.Below = \"\"\r\n                dim.Prefix = \"\"\r\n                dim.Above = \"\"\r\n                count += 1\r\n            except: pass\r\n            \r\n    except: pass\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# 霸氣回報\r\nif count > 0:\r\n    OUT = \"優喝！洗心革面大成功！妹妹幫你把 {} 個段落的文字全都擦得乾乾淨淨啦！啾咪！\".format(count)\r\nelse:\r\n    OUT = \"報告哥哥：畫面上已經很乾淨囉，找不到需要洗白的標註！\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "21a5fcb76ce9410887fb3aae15c4d7c3",
      "NodeType": "PythonScriptNode",
