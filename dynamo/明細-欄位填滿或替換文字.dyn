        }
      ],
      "Replication": "Disabled",
      "Description": "建立一個字串。",
      "InputValue": "門窗備註"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nactive_view = doc.ActiveView\r\n\r\n# IN[0]: 目標欄位名稱\r\n# IN[1]: 要尋找的字串 (A)\r\n# IN[2]: 要替換的字串 (B)\r\n# IN[3]: 欲填充的統一字串 (填滿)\r\n\r\nif len(IN) < 4:\r\n    OUT = \"⚠️ 錯誤：需要 4 個輸入端喔！請確認接線 (欄位, 找A, 換B, 填滿)\"\r\nelse:\r\n    param_name = IN[0]\r\n    find_str = str(IN[1]) if IN[1] else \"\"\r\n    replace_str = str(IN[2]) if IN[2] else \"\"\r\n    fill_value = IN[3]\r\n\r\n    is_fill_mode = False\r\n    if fill_value and str(fill_value).strip() != \"\":\r\n        is_fill_mode = True\r\n        fill_value = str(fill_value)\r\n\r\n    # 【進化 1】超強大參數尋找器：無視唯讀分身，直搗黃龍！\r\n    def get_writable_param(element, p_name):\r\n        params = element.GetParameters(p_name)\r\n        for p in params:\r\n            if not p.IsReadOnly:\r\n                return p\r\n        return None\r\n\r\n    if isinstance(active_view, ViewSchedule):\r\n        elements = list(FilteredElementCollector(doc, active_view.Id).WhereElementIsNotElementType().ToElements())\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        \r\n        success_count = 0\r\n        processed_types = []\r\n        log = [] # 錯誤紀錄本\r\n        \r\n        for el in elements:\r\n            target_param = None\r\n            is_type_param = False\r\n            \r\n            # 先找實體，找不到就去挖類型\r\n            p_inst = get_writable_param(el, param_name)\r\n            if p_inst:\r\n                target_param = p_inst\r\n            else:\r\n                tid = el.GetTypeId()\r\n                if tid != ElementId.InvalidElementId:\r\n                    etype = doc.GetElement(tid)\r\n                    if etype:\r\n                        p_type = get_writable_param(etype, param_name)\r\n                        if p_type:\r\n                            target_param = p_type\r\n                            is_type_param = True\r\n                            \r\n            if not target_param:\r\n                continue\r\n                \r\n            if is_type_param:\r\n                if tid in processed_types:\r\n                    continue\r\n                processed_types.append(tid)\r\n\r\n            # 執行寫入，這次如果有錯絕不吞掉！\r\n            try:\r\n                if is_fill_mode:\r\n                    target_param.Set(fill_value)\r\n                    success_count += 1\r\n                else:\r\n                    current_val = target_param.AsValueString() or target_param.AsString() or \"\"\r\n                    \r\n                    # 【進化 2】神級判斷：如果 Revit 裡是空的，但你要找 \"無\"，直接算你中！\r\n                    if find_str == \"無\" and current_val.strip() == \"\":\r\n                        target_param.Set(replace_str)\r\n                        success_count += 1\r\n                    elif find_str and find_str in current_val:\r\n                        new_val = current_val.replace(find_str, replace_str)\r\n                        target_param.Set(new_val)\r\n                        success_count += 1\r\n            except Exception as e:\r\n                if str(e) not in log:\r\n                    log.append(str(e))\r\n                    \r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        \r\n        mode_str = \"「霸道填滿」\" if is_fill_mode else \"「尋找取代」\"\r\n        if len(log) > 0:\r\n            OUT = \"⚠️ 發現 Revit 底層阻擋！成功 {} 個，但遇到錯誤：{}\".format(success_count, log[0])\r\n        else:\r\n            OUT = \"【優呵！破案成功】使用{}模式，成功更新了 {} 個「類型」項目！啾咪！\".format(mode_str, success_count)\r\n    else:\r\n        OUT = \"錯誤：小明哥哥，請記得切換到明細表視窗喔！\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
