    {
      "ConcreteType": "CoreNodeModels.Watch, CoreNodeModels",
      "WatchWidth": 50.0,
      "WatchHeight": 40.0,
      "Id": "85d1615ad68945f8877a80c6a38ee4e5",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "ae5d3c608b834482aaae913987484bb8",
          "Name": "",
          "Description": "要顯示其輸出的節點",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e185d1a8f22e4eed826ee0250305bc01",
          "Name": "",
          "Description": "節點輸出",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "視覺化節點的輸出"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import StructuralType\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# --- 1. 讀取與解包 IN 節點 ---\r\nroom = UnwrapElement(IN[0])\r\nacc_count = IN[1]\r\nmove_cols = IN[2]\r\ncar_symbol = UnwrapElement(IN[3]) \r\nis_center_mode = IN[4] \r\nis_rotated = IN[5]     \r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# --- 2. 自動提取參數 ---\r\ncar_w_ft = 250.0 / 30.48\r\ncar_l_ft = 550.0 / 30.48\r\n\r\nif car_symbol:\r\n    param_w = car_symbol.LookupParameter(\"停車位寬\")\r\n    param_l = car_symbol.LookupParameter(\"停車位長\")\r\n    if param_w: car_w_ft = param_w.AsDouble()\r\n    if param_l: car_l_ft = param_l.AsDouble()\r\n\r\n# --- 3. 虛擬測量：探針偵測族群偏差 ---\r\nif car_symbol and not car_symbol.IsActive:\r\n    car_symbol.Activate()\r\n\r\nroom_level = doc.GetElement(room.LevelId)\r\nbbox_room = room.get_BoundingBox(None)\r\nroom_z = bbox_room.Min.Z if bbox_room else 0.0\r\n\r\nprobe_origin = XYZ.Zero\r\nprobe_inst = doc.Create.NewFamilyInstance(probe_origin, car_symbol, room_level, StructuralType.NonStructural)\r\ndoc.Regenerate()\r\n\r\nprobe_bbox = probe_inst.get_BoundingBox(None)\r\noffset_vec = XYZ.Zero\r\n\r\nif probe_bbox:\r\n    geom_center = XYZ((probe_bbox.Min.X + probe_bbox.Max.X)/2, (probe_bbox.Min.Y + probe_bbox.Max.Y)/2, 0)\r\n    offset_vec = probe_origin.Subtract(geom_center)\r\n\r\ndoc.Delete(probe_inst.Id)\r\n\r\n# --- 4. 自動清場 (舊車位回收) ---\r\nexisting_cars = FilteredElementCollector(doc).OfClass(FamilyInstance).WhereElementIsNotElementType().ToElements()\r\nfor old_car in existing_cars:\r\n    if old_car.Symbol.Id == car_symbol.Id:\r\n        loc = old_car.Location\r\n        if isinstance(loc, LocationPoint):\r\n            test_pt = XYZ(loc.Point.X, loc.Point.Y, room_z + 1.0)\r\n            if room.IsPointInRoom(test_pt):\r\n                doc.Delete(old_car.Id)\r\n\r\n# --- 5. 尋找出入口與計算向量 ---\r\ndef is_safe(pt):\r\n    return room.IsPointInRoom(XYZ(pt.X, pt.Y, room_z + 1.0))\r\n\r\nroom_center = XYZ((bbox_room.Min.X + bbox_room.Max.X)/2, (bbox_room.Min.Y + bbox_room.Max.Y)/2, room_z) if bbox_room else XYZ.Zero\r\nentrance_pt = None\r\n\r\ncollector = FilteredElementCollector(doc).OfClass(FamilyInstance)\r\nfor inst in collector:\r\n    if inst.Symbol.Family.Name == \"停車場性質標記\":\r\n        loc = inst.Location\r\n        if isinstance(loc, LocationPoint) and room.IsPointInRoom(loc.Point):\r\n            type_elem = doc.GetElement(inst.GetTypeId())\r\n            p = type_elem.LookupParameter(\"出入性質\")\r\n            if p and p.AsString() == \"出入口\":\r\n                entrance_pt = XYZ(loc.Point.X, loc.Point.Y, room_z)\r\n                break\r\n\r\nopt = SpatialElementBoundaryOptions()\r\nopt.SpatialElementBoundaryLocation = SpatialElementBoundaryLocation.Finish\r\nboundaries = room.GetBoundarySegments(opt)\r\nouter_lines = [seg.GetCurve() for seg in boundaries[0]] if boundaries else []\r\n\r\ncut_vector = XYZ.BasisX\r\ncut_origin = room_center\r\n\r\nif entrance_pt and outer_lines:\r\n    closest_curve = min(outer_lines, key=lambda c: c.Project(entrance_pt).Distance)\r\n    line_dir = closest_curve.Direction\r\n    normal_vec = XYZ(-line_dir.Y, line_dir.X, 0).Normalize()\r\n    cut_vector = line_dir.Normalize() if is_rotated else normal_vec\r\n    cut_origin = room_center if is_center_mode else entrance_pt\r\n\r\n# --- 6. 智慧生成、校正與【動線開挖】 ---\r\nplaced_count = 0\r\nband_width_ft = 1700.0 / 30.48\r\naisle_half_ft = 300.0 / 30.48\r\nshift_dist = aisle_half_ft + (car_l_ft / 2.0)\r\n\r\nspine_dir = cut_vector.CrossProduct(XYZ.BasisZ).Normalize()\r\nangle_rad_A = math.atan2(cut_vector.Y, cut_vector.X) + (math.pi / 2.0)\r\nangle_rad_B = angle_rad_A + math.pi\r\n\r\n# 🚗 【動線開挖魔法】：主動線保留區半徑 (3公尺 = 6公尺寬的車道)\r\nmain_aisle_radius_ft = 300.0 / 30.48\r\n\r\ndef is_in_main_driveway(pt):\r\n    if not entrance_pt: return False # 如果沒放標記就不開挖\r\n    vec = pt.Subtract(entrance_pt)\r\n    \r\n    # 計算車位中心到「十字主車道」的垂直距離\r\n    dist_to_spine_axis = abs(vec.DotProduct(cut_vector)) \r\n    dist_to_cut_axis = abs(vec.DotProduct(spine_dir))\r\n    \r\n    # 如果車位落入 6m 十字車道範圍內，就判定為擋道！\r\n    if dist_to_spine_axis < main_aisle_radius_ft or dist_to_cut_axis < main_aisle_radius_ft:\r\n        return True\r\n    return False\r\n\r\ndef place_calibrated(target_center, rot_angle):\r\n    # 1. 🛡️ 動線開挖檢查：擋到主車道就不放車！\r\n    if is_in_main_driveway(target_center):\r\n        return False\r\n        \r\n    # 2. 校正插入點\r\n    transform = Transform.CreateRotation(XYZ.BasisZ, rot_angle)\r\n    corrected_insertion_pt = target_center.Add(transform.OfVector(offset_vec))\r\n    \r\n    # 3. 邊界碰撞偵測\r\n    w_vec = spine_dir.Multiply(car_w_ft / 2.0)\r\n    l_vec = cut_vector.Multiply(car_l_ft / 2.0)\r\n    corners = [\r\n        target_center.Add(w_vec).Add(l_vec),\r\n        target_center.Subtract(w_vec).Add(l_vec),\r\n        target_center.Subtract(w_vec).Subtract(l_vec),\r\n        target_center.Add(w_vec).Subtract(l_vec),\r\n        target_center\r\n    ]\r\n    \r\n    if all(is_safe(c) for c in corners):\r\n        inst = doc.Create.NewFamilyInstance(corrected_insertion_pt, car_symbol, room_level, StructuralType.NonStructural)\r\n        axis = Line.CreateBound(corrected_insertion_pt, corrected_insertion_pt.Add(XYZ.BasisZ))\r\n        ElementTransformUtils.RotateElement(doc, inst.Id, axis, rot_angle)\r\n        return True\r\n    return False\r\n\r\n# 佈置無限網格\r\nfor j in range(-15, 16):\r\n    band_base = cut_origin.Add(cut_vector.Multiply(j * band_width_ft))\r\n    for i in range(-50, 51):\r\n        spot_line = band_base.Add(spine_dir.Multiply(i * car_w_ft))\r\n        \r\n        if place_calibrated(spot_line.Add(cut_vector.Multiply(shift_dist)), angle_rad_A): \r\n            placed_count += 1\r\n        if place_calibrated(spot_line.Subtract(cut_vector.Multiply(shift_dist)), angle_rad_B): \r\n            placed_count += 1\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# --- 7. 最終報告 ---\r\nOUT = {\r\n    \"狀態\": \"🛣️ 摩西分海！主動線開挖完成！\",\r\n    \"目前起點模式\": \"1: 中心輻射\" if is_center_mode else \"0: 貼齊邊緣 (出入口)\",\r\n    \"成功生成數量\": placed_count\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "95bbe8bf7820436e9f45cc01a454c159",
