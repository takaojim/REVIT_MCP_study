    },
    {
      "ConcreteType": "CoreNodeModels.Input.DoubleInput, CoreNodeModels",
      "NumberType": "Double",
      "Id": "6123d60b9647479db5e67cea431ea0ce",
      "NodeType": "NumberInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "c8ec61a46b654c77971ecb5d115103c7",
          "Name": "",
          "Description": "Double",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "建立一個數字。",
      "InputValue": 42.854
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 輸入參數\r\n# IN[0] = 文公尺單位長 (預設 42.854)\r\n# IN[1] = 欲查詢的長度 (公分，例如 557)\r\n\r\ncycle_len_cm = IN[0] if IN[0] else 42.854\r\ntarget_cm = IN[1]\r\n\r\n# 八字訣與吉數索引 (0:財, 3:義, 4:官, 7:本)\r\nlist_8 = [\"吉-財\", \"凶-病\", \"凶-離\", \"吉-義\", \"吉-官\", \"凶-劫\", \"凶-害\", \"吉-本\"]\r\ngood_indices = [0, 3, 4, 7]\r\n\r\n# 每個字訣的長度區間\r\nstep = cycle_len_cm / 8.0\r\n\r\ndef get_sector_info(abs_index):\r\n    \"\"\"根據絕對索引值，計算對應的字訣與公分區間\"\"\"\r\n    c = abs_index // 8\r\n    idx = abs_index % 8\r\n    start_cm = c * cycle_len_cm + idx * step\r\n    end_cm = c * cycle_len_cm + (idx + 1) * step\r\n    return list_8[idx], start_cm, end_cm\r\n\r\n# 1. 計算當前輸入長度所在的區間與字訣\r\ncurrent_abs_idx = int(target_cm / step)\r\ncurrent_name, current_start, current_end = get_sector_info(current_abs_idx)\r\n\r\n# 2. 往回找 2 個比這個數字小，且屬於「吉」的區間\r\nsmaller_results = []\r\nsmaller_idx = current_abs_idx - 1\r\nwhile smaller_idx >= 0 and len(smaller_results) < 2:\r\n    if (smaller_idx % 8) in good_indices:\r\n        s_name, s_start, s_end = get_sector_info(smaller_idx)\r\n        smaller_results.append(\"{} (長度區間: {:.2f} cm ~ {:.2f} cm)\".format(s_name, s_start, s_end))\r\n    smaller_idx -= 1\r\n\r\n# 3. 往前找 2 個比這個數字大，且屬於「吉」的區間\r\nlarger_results = []\r\nlarger_idx = current_abs_idx + 1\r\nwhile len(larger_results) < 2:\r\n    if (larger_idx % 8) in good_indices:\r\n        l_name, l_start, l_end = get_sector_info(larger_idx)\r\n        larger_results.append(\"{} (長度區間: {:.2f} cm ~ {:.2f} cm)\".format(l_name, l_start, l_end))\r\n    larger_idx += 1\r\n\r\n# 4. 整理輸出結果給哥哥\r\nout_text = \"文公查詢完畢：\\n\"\r\nout_text += \"▶ 輸入長度: {} cm = {}\\n\".format(target_cm, current_name)\r\nout_text += \"--------------------------------------\\n\"\r\n\r\nout_text += \"【 較小的「吉」數區間 】\\n\"\r\nif len(smaller_results) > 0:\r\n    for i, txt in enumerate(smaller_results):\r\n        out_text += \"   {}. {}\\n\".format(i+1, txt)\r\nelse:\r\n    out_text += \"   已經沒有更小的吉數區間囉！\\n\"\r\n\r\nout_text += \"\\n【 較大的「吉」數區間 】\\n\"\r\nfor i, txt in enumerate(larger_results):\r\n    out_text += \"   {}. {}\\n\".format(i+1, txt)\r\n\r\nOUT = out_text",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "38b5dec5699b4b1db3d8ccec467cecc0",
      "NodeType": "PythonScriptNode",
      "Inputs": [
