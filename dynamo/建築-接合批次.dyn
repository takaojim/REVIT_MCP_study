      "Description": "從給定的輸入製作新清單"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\n# 引入 C# 的 List 資料結構\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 接收字串清單\r\ncategory_names = IN[0]\r\n\r\n# 建立 Revit 類別字典\r\ncategory_dict = {}\r\nfor c in doc.Settings.Categories:\r\n    category_dict[c.Name] = c.Id\r\n\r\nlist_of_groups = []\r\n\r\n# 把字串轉成實體物件\r\nfor name in category_names:\r\n    if name in category_dict:\r\n        cat_id = category_dict[name]\r\n        elements = FilteredElementCollector(doc).OfCategoryId(cat_id).WhereElementIsNotElementType().ToElements()\r\n        list_of_groups.append(elements)\r\n    else:\r\n        list_of_groups.append([])\r\n\r\njoined_count = 0\r\nswitched_count = 0\r\n\r\n# 🌟 開門密語：跟 Dynamo 說我們要開始改模型囉\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i in range(len(list_of_groups)):\r\n    high_priority_elements = list_of_groups[i]\r\n    \r\n    for j in range(i + 1, len(list_of_groups)):\r\n        low_priority_elements = list_of_groups[j]\r\n        \r\n        for high_el in high_priority_elements:\r\n            if high_el is None: continue\r\n            \r\n            bbox = high_el.get_BoundingBox(None)\r\n            if bbox is None: continue\r\n            \r\n            outline = Outline(bbox.Min, bbox.Max)\r\n            filter = BoundingBoxIntersectsFilter(outline)\r\n            \r\n            low_el_ids = List[ElementId]()\r\n            for el in low_priority_elements:\r\n                if el is not None:\r\n                    low_el_ids.Add(el.Id)\r\n            \r\n            if low_el_ids.Count == 0: continue\r\n            \r\n            collector = FilteredElementCollector(doc, low_el_ids)\r\n            intersecting_els = collector.WherePasses(filter).ToElements()\r\n            \r\n            for low_el in intersecting_els:\r\n                try:\r\n                    if not JoinGeometryUtils.AreElementsJoined(doc, high_el, low_el):\r\n                        JoinGeometryUtils.JoinGeometry(doc, high_el, low_el)\r\n                        joined_count += 1\r\n                    \r\n                    if not JoinGeometryUtils.IsFirstElementCutting(doc, high_el, low_el):\r\n                        JoinGeometryUtils.SwitchJoinOrder(doc, high_el, low_el)\r\n                        switched_count += 1\r\n                except:\r\n                    continue\r\n\r\n# 🌟 關門密語修正：Dynamo 專屬的完成交易指令\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = \"報告小明哥哥！處理完成！新建接合數：{}，切換順序數：{}\".format(joined_count, switched_count)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "67e49f259d034e38adedacd85fd3cf62",
      "NodeType": "PythonScriptNode",
