      "ConcreteType": "CoreNodeModels.Watch, CoreNodeModels",
      "WatchWidth": 200.0,
      "WatchHeight": 40.0,
      "Id": "af994813d4ae4ff7b5d24e34fe97aaea",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "04eacf1261c24234bbe2acfa803e9ce6",
          "Name": "",
          "Description": "要顯示其輸出的節點",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "064d03cd67694cf19195709c7668a1b7",
          "Name": "",
          "Description": "節點輸出",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "視覺化節點的輸出"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\nimport traceback\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nroom = UnwrapElement(IN[0])\r\nsink_type = UnwrapElement(IN[1])    \r\ntoilet_type = UnwrapElement(IN[2])  \r\nshower_type = UnwrapElement(IN[3])  \r\n\r\nspacing_m = IN[4] if len(IN) > 4 and IN[4] else [0.6, 1.5, 2.4]\r\npush_outs_m = IN[5] if len(IN) > 5 and IN[5] else [0.0, 0.145, 0.0]\r\n\r\ndef get_room_door(rm):\r\n    all_doors = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Doors).WhereElementIsNotElementType().ToElements()\r\n    for d in all_doors:\r\n        if (d.ToRoom and d.ToRoom.Id == rm.Id) or (d.FromRoom and d.FromRoom.Id == rm.Id):\r\n            return d\r\n    return None\r\n\r\n# 🌟 修正點：解除了偏移的封印，讓外部數字可以寫入\r\ndef adjust_height_and_offset(instance, offset_val):\r\n    try:\r\n        # 將 IN[5] 的偏移值，正式寫入「距離主體的偏移」參數\r\n        p1 = instance.get_Parameter(BuiltInParameter.INSTANCE_FREE_HOST_OFFSET_PARAM)\r\n        if p1 and not p1.IsReadOnly: p1.Set(offset_val)\r\n        \r\n        # 高度依然保持歸零，防飛天\r\n        p2 = instance.get_Parameter(BuiltInParameter.INSTANCE_ELEVATION_PARAM)\r\n        if p2 and not p2.IsReadOnly: p2.Set(0.0)\r\n        p3 = instance.get_Parameter(BuiltInParameter.FAMILY_BASE_LEVEL_OFFSET_PARAM)\r\n        if p3 and not p3.IsReadOnly: p3.Set(0.0)\r\n    except:\r\n        pass\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nresults = []\r\nlog_msgs = []\r\n\r\ntry:\r\n    types = [sink_type, toilet_type, shower_type]\r\n    names = [\"洗臉盆\", \"馬桶\", \"淋浴間\"]\r\n    for t in types:\r\n        if t and not t.IsActive:\r\n            t.Activate()\r\n            doc.Regenerate()\r\n\r\n    opt = SpatialElementBoundaryOptions()\r\n    boundary_segments = room.GetBoundarySegments(opt)[0]\r\n    \r\n    door = get_room_door(room)\r\n    door_loc = door.Location.Point if door else None\r\n    \r\n    wall_dict = {}\r\n    for seg in boundary_segments:\r\n        curve = seg.GetCurve()\r\n        if door_loc and curve.Distance(door_loc) < 1.6: \r\n            continue\r\n        eid = seg.ElementId\r\n        if str(eid) == \"-1\": continue \r\n        \r\n        if eid not in wall_dict:\r\n            wall_dict[eid] = []\r\n        wall_dict[eid].append(curve)\r\n        \r\n    best_wall_id = None\r\n    max_total_len = 0\r\n    for eid, curves in wall_dict.items():\r\n        total_len = sum([c.Length for c in curves])\r\n        if total_len > max_total_len:\r\n            max_total_len = total_len\r\n            best_wall_id = eid\r\n\r\n    if not best_wall_id:\r\n        raise Exception(\"找不到適合的靠背牆。\")\r\n\r\n    host_wall = doc.GetElement(best_wall_id)\r\n    best_curves = wall_dict[best_wall_id]\r\n    \r\n    pts = []\r\n    for c in best_curves:\r\n        pts.append(c.GetEndPoint(0))\r\n        pts.append(c.GetEndPoint(1))\r\n        \r\n    p0 = pts[0]\r\n    p1 = pts[0]\r\n    true_max_dist = 0\r\n    for i in range(len(pts)):\r\n        for j in range(i+1, len(pts)):\r\n            d = pts[i].DistanceTo(pts[j])\r\n            if d > true_max_dist:\r\n                true_max_dist = d\r\n                p0 = pts[i]\r\n                p1 = pts[j]\r\n\r\n    if door_loc and p1.DistanceTo(door_loc) < p0.DistanceTo(door_loc):\r\n        start_pt = p1\r\n        end_pt = p0\r\n    else:\r\n        start_pt = p0\r\n        end_pt = p1\r\n\r\n    direction = XYZ(end_pt.X - start_pt.X, end_pt.Y - start_pt.Y, end_pt.Z - start_pt.Z).Normalize()\r\n    wall_normal = XYZ(-direction.Y, direction.X, 0).Normalize()\r\n    \r\n    room_bb = room.get_BoundingBox(None)\r\n    room_center = XYZ((room_bb.Min.X + room_bb.Max.X)/2, (room_bb.Min.Y + room_bb.Max.Y)/2, 0)\r\n    mid_pt = start_pt.Add(direction.Multiply(true_max_dist/2))\r\n    to_center = XYZ(room_center.X - mid_pt.X, room_center.Y - mid_pt.Y, 0).Normalize()\r\n    \r\n    if wall_normal.DotProduct(to_center) < 0:\r\n        wall_normal = XYZ(-wall_normal.X, -wall_normal.Y, 0)\r\n\r\n    offsets_ft = [x * 3.28084 for x in spacing_m]\r\n    push_outs_ft = [x * 3.28084 for x in push_outs_m]\r\n    \r\n    level_z = room.Level.Elevation\r\n\r\n    for i, dist_ft in enumerate(offsets_ft):\r\n        if dist_ft < true_max_dist:\r\n            place_pt = start_pt.Add(direction.Multiply(dist_ft))\r\n            target_pt = XYZ(place_pt.X, place_pt.Y, level_z).Add(wall_normal.Multiply(push_outs_ft[i]))\r\n            \r\n            instance = None\r\n            try:\r\n                instance = doc.Create.NewFamilyInstance(target_pt, types[i], host_wall, room.Level, Structure.StructuralType.NonStructural)\r\n                log_msgs.append(names[i] + \" -> 成功(依附牆)\")\r\n            except Exception as e1:\r\n                try:\r\n                    instance = doc.Create.NewFamilyInstance(target_pt, types[i], room.Level, Structure.StructuralType.NonStructural)\r\n                    log_msgs.append(names[i] + \" -> 成功(依附樓層)\")\r\n                except Exception as e2:\r\n                    continue\r\n            \r\n            if instance:\r\n                # 🌟 呼叫更新版的神器，把偏移量傳進去\r\n                adjust_height_and_offset(instance, push_outs_ft[i])\r\n                \r\n                try:\r\n                    axis_line = Line.CreateBound(target_pt, target_pt.Add(XYZ.BasisZ))\r\n                    angle = XYZ.BasisY.AngleTo(wall_normal)\r\n                    cross = XYZ.BasisY.CrossProduct(wall_normal)\r\n                    if cross.Z < 0:\r\n                        angle = 2 * math.pi - angle\r\n                    \r\n                    angle = angle + math.pi\r\n                    ElementTransformUtils.RotateElement(doc, instance.Id, axis_line, angle)\r\n                except:\r\n                    pass \r\n                \r\n                results.append(instance)\r\n\r\n    OUT = [\"設備放置報告：\"] + log_msgs + [results]\r\n\r\nexcept Exception as e:\r\n    OUT = \"執行失敗: \" + str(e) + \"\\n\" + traceback.format_exc()\r\n\r\nTransactionManager.Instance.TransactionTaskDone()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
