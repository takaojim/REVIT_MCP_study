    {
      "Id": "4ee6a1c7ae5747d2b64963e5ebce069c",
      "Name": "String",
      "Type": "string",
      "Type2": "string",
      "Value": "左右位置微調：找 offsets_m = [0.6, 1.5, 2.4] 這行。這代表洗臉盆離起點 60cm，馬桶 150cm，淋浴間 240cm。房間變大變小就改這裡。\n\n前後靠牆微調：找 push_outs_m = [0.0, 0.35, 0.0] 這行。如果換了另一個牌子的馬桶，發現它又吃進牆裡或是離牆太遠，就調整中間那個 0.35（35公分）。",
      "Description": "建立一個字串。"
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Nodes.DSModelElementSelection, DSRevitNodesUI",
      "NodeType": "ExtensionNode",
