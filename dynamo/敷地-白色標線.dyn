  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport traceback \r\nimport math\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# === 加入 Revit API 相關模組 ===\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import ElementId, BuiltInCategory, DirectShape, FilteredElementCollector\r\nfrom Autodesk.Revit.DB import FillPatternElement, OverrideGraphicSettings, Color as RvtColor\r\nfrom Autodesk.Revit.DB import Material as RvtMaterial\r\nfrom System.Collections.Generic import List\r\n\r\n# ==========================================\r\n# VER: 跑道球場_自訂寬度白線_v2.0_PRO (抗 Toposolid 地形版)\r\n# ==========================================\r\n\r\ntry:\r\n    doc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n    if len(IN) < 4:\r\n        raise Exception(\"節點輸入端不足！請確保依序輸入：IN[0]厚度, IN[1]線段, IN[2]自訂線寬, IN[3]表面\")\r\n\r\n    thk_in = IN[0]\r\n    if isinstance(thk_in, list) and len(thk_in) > 0: thk_in = thk_in[0]\r\n    thickness = float(thk_in) if thk_in is not None else 0.2\r\n    \r\n    raw_curves = IN[1] if isinstance(IN[1], list) else [IN[1]]\r\n    \r\n    width_in = IN[2]\r\n    if isinstance(width_in, list) and len(width_in) > 0: width_in = width_in[0]\r\n    line_width = float(width_in) if width_in is not None else 10.0\r\n    \r\n    raw_face = IN[3] \r\n\r\n    ref_surface = None\r\n    \r\n    # 支援 Toposolid 的強效解析 (支援 Surface 與 PolySurface)\r\n    def extract_surface(obj):\r\n        if isinstance(obj, list):\r\n            if len(obj) > 0: return extract_surface(obj[0])\r\n            return None\r\n        try:\r\n            geom = obj.Geometry()\r\n            for g in geom:\r\n                return g # 回傳找到的第一個幾何體 (Surface/PolySurface)\r\n        except: \r\n            if hasattr(obj, \"SurfaceGeometry\"): return obj.SurfaceGeometry()\r\n        return obj\r\n\r\n    if raw_face is not None:\r\n        ref_surface = extract_surface(raw_face)\r\n        if not ref_surface: raise Exception(\"IN[3] 無法解析成有效平面！\")\r\n\r\n    parsed_curves = []\r\n    for rc in raw_curves:\r\n        if rc is None: continue\r\n        if hasattr(rc, \"StartPoint\") and hasattr(rc, \"PointAtParameter\"):\r\n            parsed_curves.append(rc)\r\n            continue\r\n        if hasattr(rc, \"CurveGeometry\"):\r\n            try: parsed_curves.append(rc.CurveGeometry); continue\r\n            except: pass\r\n        if hasattr(rc, \"GeometryCurve\"):\r\n            try: parsed_curves.append(rc.GeometryCurve.ToProtoType()); continue\r\n            except: pass\r\n        try:\r\n            for g in rc.Geometry():\r\n                if hasattr(g, \"PointAtParameter\"): parsed_curves.append(g)\r\n        except: pass\r\n\r\n    if not parsed_curves: raise Exception(\"IN[1] 找不到有效線段！\")\r\n\r\n    def chain_and_join_curves(curves, tol=0.01):\r\n        if not curves: return []\r\n        if len(curves) == 1: return curves\r\n        unprocessed = list(curves)\r\n        chains = []\r\n        while unprocessed:\r\n            current_chain = [unprocessed.pop(0)]\r\n            added = True\r\n            while added:\r\n                added = False\r\n                chain_start = current_chain[0].StartPoint\r\n                chain_end = current_chain[-1].EndPoint\r\n                for i in range(len(unprocessed)-1, -1, -1):\r\n                    c = unprocessed[i]\r\n                    c_start = c.StartPoint\r\n                    c_end = c.EndPoint\r\n                    if chain_end.DistanceTo(c_start) <= tol:\r\n                        current_chain.append(c); unprocessed.pop(i); added = True; break\r\n                    elif chain_end.DistanceTo(c_end) <= tol:\r\n                        current_chain.append(c.Reverse()); unprocessed.pop(i); added = True; break\r\n                    elif chain_start.DistanceTo(c_end) <= tol:\r\n                        current_chain.insert(0, c); unprocessed.pop(i); added = True; break\r\n                    elif chain_start.DistanceTo(c_start) <= tol:\r\n                        current_chain.insert(0, c.Reverse()); unprocessed.pop(i); added = True; break\r\n            chains.append(current_chain)\r\n        joined_curves = []\r\n        for chain in chains:\r\n            if len(chain) == 1: joined_curves.append(chain[0])\r\n            else:\r\n                try: joined_curves.append(PolyCurve.ByJoinedCurves(chain))\r\n                except: joined_curves.extend(chain)\r\n        return joined_curves\r\n\r\n    input_curves = chain_and_join_curves(parsed_curves)\r\n\r\n    # 🌟 妹妹的抗地形迴圈補面法 (Perimeter Patch) 🌟\r\n    def create_ribbon_solid(curve, width, thk, ref_surf):\r\n        try:\r\n            length = curve.Length\r\n            if length < 0.1: return None \r\n            \r\n            # 球場線通常較直，但我們還是保留足夠解析度貼合地形\r\n            num_points = max(int(length / 20.0), 2)\r\n            left_pts = []\r\n            right_pts = []\r\n            \r\n            for i in range(num_points + 1):\r\n                param = i / float(num_points)\r\n                pt = curve.PointAtParameter(param)\r\n                tangent = curve.TangentAtParameter(param)\r\n                \r\n                # 直接投影到 Toposolid 表面\r\n                if ref_surf:\r\n                    try:\r\n                        proj_geom = ref_surf.ClosestPointTo(pt)\r\n                        if proj_geom: pt = proj_geom\r\n                    except: pass\r\n                \r\n                # 捨棄容易報錯的表面法線，統一使用 Z 軸計算偏移方向 (適用於球場與道路)\r\n                offset_dir = Vector.ZAxis().Cross(tangent).Normalized()\r\n                \r\n                left_pts.append(pt.Translate(offset_dir, width / 2.0))\r\n                right_pts.append(pt.Translate(offset_dir, -width / 2.0))\r\n                \r\n            # 將點陣列接合成封閉迴圈 (左側順向 + 右側反向)\r\n            loop_pts = left_pts + list(reversed(right_pts))\r\n            \r\n            # 清理過於接近的點以防 PolyCurve 報錯\r\n            clean_pts = []\r\n            for p in loop_pts:\r\n                if not clean_pts or clean_pts[-1].DistanceTo(p) > 0.1:\r\n                    clean_pts.append(p)\r\n            if clean_pts and clean_pts[0].DistanceTo(clean_pts[-1]) < 0.1:\r\n                clean_pts.pop()\r\n            clean_pts.append(clean_pts[0])\r\n            \r\n            # 建立封閉外框\r\n            lines = []\r\n            for i in range(len(clean_pts) - 1):\r\n                lines.append(Line.ByStartPointEndPoint(clean_pts[i], clean_pts[i+1]))\r\n                \r\n            poly = PolyCurve.ByJoinedCurves(lines)\r\n            surf = Surface.ByPatch(poly)\r\n            if not surf: return None\r\n            \r\n            # 嘗試加厚，若地形太極端導致加厚失敗，則回傳無厚度貼面保底\r\n            if thk > 0:\r\n                try: \r\n                    solid = surf.Thicken(thk)\r\n                    if solid: return solid\r\n                except: pass\r\n            \r\n            return surf\r\n        except Exception as e:\r\n            return None\r\n\r\n    output_solids = []\r\n\r\n    for curve in input_curves:\r\n        solid = create_ribbon_solid(curve, line_width, thickness, ref_surface)\r\n        if solid: output_solids.append(solid)\r\n\r\n    if not output_solids: raise Exception(\"實體清單為空！地形過度複雜導致貼面失敗。\")\r\n\r\n    # === Bake 轉換為 Revit 元件 ===\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    \r\n    mat_name = \"球場跑道標線_白色\"\r\n    cr, cg, cb = 255, 255, 255\r\n    elem_name = f\"自訂白線_寬{line_width}\"\r\n\r\n    fill_pattern_id = None\r\n    collector = FilteredElementCollector(doc).OfClass(FillPatternElement)\r\n    for fp in collector:\r\n        if fp.GetFillPattern().IsSolidFill:\r\n            fill_pattern_id = fp.Id\r\n            break\r\n            \r\n    rvt_cat = doc.Settings.Categories.get_Item(BuiltInCategory.OST_GenericModel)\r\n    \r\n    # 處理 2024 版本 API\r\n    cat_id_int = getattr(rvt_cat.Id, \"Value\", getattr(rvt_cat.Id, \"IntegerValue\", None))\r\n    \r\n    created_ids = List[ElementId]()\r\n    \r\n    for dyn_solid in output_solids:\r\n        try:\r\n            rvt_solids = dyn_solid.ToRevitType() \r\n            ds = DirectShape.CreateElement(doc, rvt_cat.Id)\r\n            ds.SetShape(rvt_solids)\r\n            ds.Name = elem_name\r\n            \r\n            if fill_pattern_id:\r\n                ogs = OverrideGraphicSettings()\r\n                ogs.SetSurfaceForegroundPatternId(fill_pattern_id)\r\n                ogs.SetSurfaceForegroundPatternColor(RvtColor(cr, cg, cb))\r\n                doc.ActiveView.SetElementOverrides(ds.Id, ogs)\r\n                \r\n            created_ids.Add(ds.Id)\r\n        except: pass\r\n            \r\n    final_output = None\r\n    if created_ids.Count > 1:\r\n        group = doc.Create.NewGroup(created_ids)\r\n        group.GroupType.Name = f\"標線群組_自訂白線_W{line_width}\"\r\n        final_output = group\r\n    elif created_ids.Count == 1:\r\n        final_output = doc.GetElement(created_ids[0])\r\n        \r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    OUT = final_output\r\n\r\nexcept Exception as e:\r\n    OUT = traceback.format_exc()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "e17edb0f45714ada996677f3aaa6c524",
      "NodeType": "PythonScriptNode",
