    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n# 載入 Windows 原生的 Forms 與 Drawing 模組 (不需安裝任何套件)\r\nclr.AddReference(\"System.Windows.Forms\")\r\nclr.AddReference(\"System.Drawing\")\r\n\r\nimport System.Windows.Forms as WinForms\r\nfrom System.Drawing import Point, Size\r\n\r\n# 定義我們自己的彈出視窗類別\r\nclass DropdownForm(WinForms.Form):\r\n    def __init__(self, options):\r\n        # 視窗基本設定\r\n        self.Text = \"交通標線選擇器\"\r\n        self.Width = 320\r\n        self.Height = 180\r\n        self.StartPosition = WinForms.FormStartPosition.CenterScreen\r\n        self.MaximizeBox = False\r\n        self.MinimizeBox = False\r\n        self.FormBorderStyle = WinForms.FormBorderStyle.FixedDialog\r\n        self.TopMost = True # 確保視窗保持在最上層，不會被 Revit 擋住\r\n        \r\n        # 建立標籤 (Label)\r\n        self.label = WinForms.Label()\r\n        self.label.Text = \"請選擇要繪製的標線類型：\"\r\n        self.label.Location = Point(20, 20)\r\n        self.label.AutoSize = True\r\n        \r\n        # 建立下拉選單 (ComboBox)\r\n        self.combo = WinForms.ComboBox()\r\n        self.combo.Location = Point(20, 50)\r\n        self.combo.Width = 260\r\n        self.combo.DropDownStyle = WinForms.ComboBoxStyle.DropDownList # 限制只能下拉，不能亂輸入\r\n        \r\n        # 將選項加入 ComboBox (使用迴圈確保相容於 IronPython 與 CPython3)\r\n        for opt in options:\r\n            self.combo.Items.Add(opt)\r\n        \r\n        # 預設選擇第一個項目\r\n        if self.combo.Items.Count > 0:\r\n            self.combo.SelectedIndex = 0\r\n            \r\n        # 建立確定按鈕 (Button)\r\n        self.btn = WinForms.Button()\r\n        self.btn.Text = \"確認選取\"\r\n        self.btn.Location = Point(180, 95)\r\n        self.btn.Width = 100\r\n        self.btn.Click += self.button_clicked # 綁定點擊事件\r\n        \r\n        # 將控制項加入視窗\r\n        self.Controls.Add(self.label)\r\n        self.Controls.Add(self.combo)\r\n        self.Controls.Add(self.btn)\r\n        \r\n        # 儲存結果的變數\r\n        self.selected_value = None\r\n        \r\n    def button_clicked(self, sender, args):\r\n        # 按下按鈕後，記錄選到的值並關閉視窗\r\n        self.selected_value = self.combo.SelectedItem\r\n        self.Close()\r\n\r\n# --- 主程式執行區 ---\r\n\r\n# IN[0] 作為觸發開關\r\nrun_it = IN[0] \r\n\r\n# IN[1] 接收外部清單，如果沒有接，就給預設值\r\nif isinstance(IN[1], list) and len(IN[1]) > 0:\r\n    line_options = IN[1]\r\nelse:\r\n    line_options = [\r\n        \"單白實線\", \r\n        \"單黃實線\", \r\n        \"雙白線\", \r\n        \"雙黃線\", \r\n        \"單白虛線\", \r\n        \"單黃虛線\", \r\n        \"行人穿越道 (斑馬線)\", \r\n        \"停止線\",\r\n        \"機車停等區\",\r\n        \"直行箭頭\",\r\n        \"左轉箭頭\",\r\n        \"右轉箭頭\",\r\n        \"直左箭頭\",\r\n        \"直右箭頭\"\r\n    ]\r\n\r\n# 判斷是否彈出視窗\r\nif run_it:\r\n    # 實體化視窗\r\n    form = DropdownForm(line_options)\r\n    # 使用 ShowDialog() 阻塞執行，直到使用者選完關閉視窗\r\n    form.ShowDialog()\r\n    \r\n    # 輸出選取結果\r\n    OUT = form.selected_value\r\nelse:\r\n    OUT = \"請將 IN[0] 切換為 True 以開啟選單\"",
