      "Name": "2.選一或多條基準線",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "9c5c6e04-1922-4664-afde-4c37d3eb8c1e-000c57fd:0:LINEAR",
      "Description": "選取多條邊緣。"
    }
  ],
  "Outputs": [
    {
      "Id": "a7ca055c4b3f49789b8ad696a36b2ecf",
      "Name": "Watch",
      "Type": "unknown",
