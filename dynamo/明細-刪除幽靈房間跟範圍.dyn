{
  "Uuid": "f671e4f4-7101-4dbe-98c7-ca90aea15b02",
  "IsCustomNode": false,
  "Description": "",
  "Name": "明細-刪除幽靈房間跟範圍",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "4d4e10e5c00140e6ae9a96f03dc4197d",
      "Name": "String",
      "Type": "string",
      "Type2": "string",
      "Value": "刪除幽靈的房間及範圍",
      "Description": "建立一個字串。"
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import FilteredElementCollector, BuiltInCategory, SpatialElement\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# 取得目前的 Revit 檔案\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 直接使用 Revit API 抓取專案中所有的房間 (Rooms) 與面積 (Areas)\r\nrooms = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Rooms).WhereElementIsNotElementType().ToElements()\r\nareas = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Areas).WhereElementIsNotElementType().ToElements()\r\n\r\n# 將房間與面積的清單合併\r\nall_spatial_elements = list(rooms) + list(areas)\r\n\r\ndeleted_count = 0\r\n\r\n# 開啟 Transaction 進行修改\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor item in all_spatial_elements:\r\n    try:\r\n        # 確保是 SpatialElement\r\n        if isinstance(item, SpatialElement):\r\n            # 判斷是否為未放置 (Location 為 None) 或是未正確圍合 (Area 為 0)\r\n            if item.Area == 0 or item.Location is None:\r\n                doc.Delete(item.Id)\r\n                deleted_count += 1\r\n    except Exception as e:\r\n        pass\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# 輸出結果，不需要再設定任何 IN 輸入\r\nOUT = f\"清理完成！自動抓取並刪除了 {deleted_count} 個未放置的房間與面積。\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b7e0fd163c2643c1a5c1e5922efd4597",
      "NodeType": "PythonScriptNode",
      "Inputs": [],
      "Outputs": [
