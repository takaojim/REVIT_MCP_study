    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 載入 Revit 節點與幾何轉換\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\n# 載入事務管理\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- 讀取 Dynamo 輸入 ---\r\n# 族群名稱的 IN 已經移除了，輸入端順序往前遞補！\r\nstart_num = int(IN[0])     # 起始編號 (原 IN[1])\r\ncurve_input = UnwrapElement(IN[1]) # 雲形線 (原 IN[2])\r\nparam_name = IN[2]         # 參數名稱 (原 IN[3])\r\n\r\n# --- 1. 取得 Revit 曲線幾何 ---\r\nrevit_curve = None\r\nif hasattr(curve_input, \"GeometryCurve\"):\r\n    revit_curve = curve_input.GeometryCurve\r\nelif hasattr(curve_input, \"Location\"):\r\n    revit_curve = curve_input.Location.Curve\r\n\r\nif not revit_curve:\r\n    OUT = \"錯誤：請確認 IN[1] 輸入的是 Revit 中的模型線或細部線。\"\r\n    sys.exit()\r\n\r\n# --- 2. 收集所有的停車位 (不限族群名稱) ---\r\n# 妹妹改用 Revit 內建的「停車 (OST_Parking)」品類來抓取\r\n# 這樣不管你有幾種大車、小車、機車的族群，只要品類是停車位就會被抓進來！\r\ncollector = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Parking).WhereElementIsNotElementType()\r\nparking_spaces = [e for e in collector if isinstance(e, FamilyInstance)]\r\n\r\n# --- 取得 Z 軸加厚範圍 ---\r\nz_values = []\r\nfor space in parking_spaces:\r\n    loc = space.Location\r\n    if isinstance(loc, LocationPoint):\r\n        z_values.append(loc.Point.Z)\r\n\r\nz_buffer = 0.5\r\nif not z_values:\r\n    OUT = \"模型中找不到任何『停車』品類的物件\"\r\n    sys.exit()\r\n\r\nmin_z = min(z_values) - z_buffer\r\nmax_z = max(z_values) + z_buffer\r\n\r\nintersecting_spaces = []\r\n\r\n# 🔴 關鍵修改：將 XY 平面的感應距離大幅增加到 30 英呎 (約 9 公尺)\r\n# 這樣即使線畫得比較偏或有大弧度，也能順利掃描到車位\r\nxy_tolerance = 30.0 \r\n\r\n# --- 3. 找出符合範圍的車位 ---\r\nfor space in parking_spaces:\r\n    loc = space.Location\r\n    if isinstance(loc, LocationPoint):\r\n        pt = loc.Point\r\n        \r\n        # Z 軸過濾\r\n        if pt.Z < min_z or pt.Z > max_z:\r\n            continue \r\n            \r\n        result = revit_curve.Project(pt)\r\n        \r\n        if result:\r\n            # 🔴 使用加大的容許距離\r\n            if result.Distance < xy_tolerance: \r\n                intersecting_spaces.append({\r\n                    \"param\": result.Parameter,\r\n                    \"space\": space\r\n                })\r\n\r\nintersecting_spaces.sort(key=lambda x: x[\"param\"])\r\n\r\n# --- 4. 寫入參數 ---\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\ncurrent_num = start_num\r\nsuccess_elements = []\r\n\r\nfor item in intersecting_spaces:\r\n    space = item[\"space\"]\r\n    p = space.LookupParameter(param_name)\r\n    \r\n    if p and not p.IsReadOnly:\r\n        if p.StorageType == StorageType.String:\r\n            p.Set(str(current_num))\r\n        elif p.StorageType == StorageType.Integer:\r\n            p.Set(current_num)\r\n        \r\n        success_elements.append(space)\r\n        current_num += 1\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# --- 輸出結果：加入總編號數量統計 ---\r\nOUT = {\r\n    \"1_總共編了多少車位\": str(len(success_elements)) + \" 個\",\r\n    \"2_成功處理的車位清單\": success_elements\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5846903ba825494d8a7cab80625d6ae2",
