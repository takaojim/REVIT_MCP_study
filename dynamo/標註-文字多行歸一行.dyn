{
  "Uuid": "42afa282-fc72-4560-9b7d-25ade0f8af58",
  "IsCustomNode": false,
  "Description": "",
  "Name": "標註-文字多行歸一行",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "aefe88c537214d3ab9f6bf6f162bf142",
      "Name": "String",
      "Type": "string",
      "Type2": "string",
      "Value": "散掉了多行文字合併成一行",
      "Description": "建立一個字串。"
    },
    {
      "Id": "bd7f69763acb4474b2472d5339e3cc86",
      "Name": "選取要合併的文字",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "cbdc1b47-dc17-47de-b5d9-476cf34a73fc-000c53fa",
      "Description": "從 Revit 文件中選取多個元素。"
    }
  ],
  "Outputs": [
    {
      "Id": "3dc85381a91f45438dcc2f33360ec7b7",
      "Name": "Watch",
      "Type": "string",
      "InitialValue": "⚠️ 請選取兩個以上的文字註解。",
      "Description": "視覺化節點的輸出"
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 載入 Revit 服務與交易管理\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# 取得目前的 Revit 文件\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 取得輸入的元素\r\nelements = UnwrapElement(IN[0])\r\n\r\nif not isinstance(elements, list):\r\n    elements = [elements]\r\n\r\n# 過濾出文字註解\r\ntext_notes = [e for e in elements if isinstance(e, TextNote)]\r\nresult = \"\"\r\n\r\nif len(text_notes) > 1:\r\n    # 依照 X 座標 (由左至右) 排序\r\n    sorted_notes = sorted(text_notes, key=lambda tn: tn.Coord.X)\r\n\r\n    # 提取文字並「清除所有換行符號」(\\r 與 \\n)\r\n    full_text = \"\".join([tn.Text.replace('\\r', '').replace('\\n', '') for tn in sorted_notes])\r\n\r\n    primary_note = sorted_notes[0]\r\n    notes_to_delete = sorted_notes[1:]\r\n\r\n    # 開啟 Transaction 修改模型\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    try:\r\n        # 寫入乾淨的單行文字\r\n        primary_note.Text = full_text\r\n\r\n        # 刪除多餘文字方塊\r\n        for note in notes_to_delete:\r\n            doc.Delete(note.Id)\r\n        \r\n        result = \"✅ 合併成功並已清除換行: \" + full_text\r\n    except Exception as e:\r\n        result = \"❌ 發生錯誤: \" + str(e)\r\n\r\n    # 結束 Transaction\r\n    TransactionManager.Instance.TransactionTaskDone()\r\nelse:\r\n    result = \"⚠️ 請選取兩個以上的文字註解。\"\r\n\r\nOUT = result",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "180f67338969435eb3e8214f84008bb8",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "7894e6d0ff8e4095beb604e73b3f8f32",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
