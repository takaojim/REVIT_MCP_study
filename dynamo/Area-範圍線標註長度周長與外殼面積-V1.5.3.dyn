  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# AREA PERIMETER Script Version: 2026.07.20-V1.5.3\nimport clr\nimport math\nimport traceback\n\nclr.AddReference('System')\nfrom System.Collections.Generic import List\n\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\n\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nview = doc.ActiveView\n\nFT_TO_M = 0.3048\nTAG = \"CODEX_AREA_PERIMETER_V1\"\nLINE_STYLE_NAME = \"AREA_周長範圍線_黑色虛線\"\nLEGACY_LINE_STYLE_NAMES = (\"AREA_周長範圍線_紫\", \"AREA_周長範圍線_洋紅虛線\", \"AREA_周長範圍線_RGB000-166-000_虛線\")\nLINE_PATTERN_NAME = \"AREA_周長_虛線3mm_間隔1.5mm\"\nSEG_TEXT_NAME = \"AREA_邊長_2.5mm\"\nTOTAL_TEXT_NAME = \"AREA_周長合計_3.5mm\"\n\ndef get_num(idx, default):\n    try:\n        value = IN[idx]\n        if isinstance(value, list):\n            value = value[0] if value else default\n        return float(value)\n    except:\n        return default\n\ndef get_bool(idx, default):\n    try:\n        value = IN[idx]\n        if isinstance(value, list):\n            value = value[0] if value else default\n        if isinstance(value, str):\n            return value.strip().lower() == \"true\"\n        return bool(value)\n    except:\n        return default\n\ndecimals = max(0, min(6, int(get_num(0, 2))))\nlabel_offset_mm = max(0.0, get_num(1, 2.5))\ndraw_boundary = get_bool(2, True)\ninclude_inner = get_bool(3, False)\nclear_only = get_bool(4, False)\ntotal_offset_mm = max(0.0, get_num(5, 10.0))\n\ndef format_m(value):\n    text = (\"{0:.\" + str(decimals) + \"f}\").format(value)\n    if \".\" in text:\n        text = text.rstrip(\"0\").rstrip(\".\")\n    return text + \" m\"\n\ndef get_type_name(element_type):\n    p = element_type.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n    return p.AsString() if p else \"\"\n\ndef get_or_create_text_type(name, size_mm):\n    types = list(FilteredElementCollector(doc).OfClass(TextNoteType).ToElements())\n    for text_type in types:\n        if get_type_name(text_type) == name:\n            return text_type.Id\n    if not types:\n        raise Exception(\"文件中找不到可複製的文字註解型別。\")\n    new_type = types[0].Duplicate(name)\n    size_param = new_type.get_Parameter(BuiltInParameter.TEXT_SIZE)\n    if size_param and not size_param.IsReadOnly:\n        size_param.Set(size_mm / 304.8)\n    return new_type.Id\n\ndef get_or_create_dash_pattern():\n    for pattern_element in FilteredElementCollector(doc).OfClass(LinePatternElement):\n        if pattern_element.Name == LINE_PATTERN_NAME:\n            return pattern_element\n\n    pattern = LinePattern(LINE_PATTERN_NAME)\n    segments = List[LinePatternSegment]()\n    segments.Add(LinePatternSegment(LinePatternSegmentType.Dash, 3.0 / 304.8))\n    segments.Add(LinePatternSegment(LinePatternSegmentType.Space, 1.5 / 304.8))\n    pattern.SetSegments(segments)\n    return LinePatternElement.Create(doc, pattern)\n\ndef get_or_create_line_style():\n    lines = doc.Settings.Categories.get_Item(BuiltInCategory.OST_Lines)\n    if lines.SubCategories.Contains(LINE_STYLE_NAME):\n        subcat = lines.SubCategories.get_Item(LINE_STYLE_NAME)\n    else:\n        subcat = doc.Settings.Categories.NewSubcategory(lines, LINE_STYLE_NAME)\n\n    dash_pattern = get_or_create_dash_pattern()\n    subcat.LineColor = Color(0, 0, 0)\n    subcat.SetLineWeight(3, GraphicsStyleType.Projection)\n    subcat.SetLinePatternId(dash_pattern.Id, GraphicsStyleType.Projection)\n    return subcat.GetGraphicsStyle(GraphicsStyleType.Projection)\n\ndef set_tag(element):\n    p = element.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    if p and not p.IsReadOnly:\n        p.Set(TAG)\n\ndef has_tag(element):\n    p = element.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    return p is not None and p.AsString() == TAG\n\ndef readable_angle(curve):\n    try:\n        tangent = curve.ComputeDerivatives(0.5, True).BasisX\n        angle = math.atan2(tangent.Y, tangent.X)\n    except:\n        p0 = curve.GetEndPoint(0)\n        p1 = curve.GetEndPoint(1)\n        angle = math.atan2(p1.Y - p0.Y, p1.X - p0.X)\n    while angle > math.pi:\n        angle -= 2.0 * math.pi\n    while angle <= -math.pi:\n        angle += 2.0 * math.pi\n    if angle > math.pi / 2.0:\n        angle -= math.pi\n    elif angle < -math.pi / 2.0:\n        angle += math.pi\n    return angle\n\ndef loop_points(loop):\n    points = []\n    for segment in loop:\n        curve = segment.GetCurve()\n        try:\n            tess = list(curve.Tessellate())\n            if points and tess:\n                tess = tess[1:]\n            points.extend(tess)\n        except:\n            points.append(curve.GetEndPoint(0))\n    return points\n\ndef signed_area_xy(points):\n    if len(points) < 3:\n        return 0.0\n    total = 0.0\n    for i in range(len(points)):\n        a = points[i]\n        b = points[(i + 1) % len(points)]\n        total += a.X * b.Y - b.X * a.Y\n    return total * 0.5\n\ndef loop_centroid(points):\n    if not points:\n        return XYZ(0, 0, 0)\n    return XYZ(\n        sum(p.X for p in points) / len(points),\n        sum(p.Y for p in points) / len(points),\n        sum(p.Z for p in points) / len(points)\n    )\n\ndef element_id_number(element_id):\n    # Revit 2024+ uses the 64-bit Value property; older releases use IntegerValue.\n    if hasattr(element_id, \"Value\"):\n        return int(element_id.Value)\n    return int(element_id.IntegerValue)\n\ndef plain_number(value):\n    text = (\"{0:.\" + str(decimals) + \"f}\").format(value)\n    if \".\" in text:\n        text = text.rstrip(\"0\").rstrip(\".\")\n    return text\n\ndef sum_formula(values):\n    parts = [plain_number(v) for v in values]\n    if not parts:\n        return \"0\"\n    lines = []\n    for i in range(0, len(parts), 8):\n        lines.append(\" + \".join(parts[i:i + 8]))\n    return (\"\\n+ \").join(lines)\n\nall_levels = sorted(\n    list(FilteredElementCollector(doc).OfClass(Level).ToElements()),\n    key=lambda level: level.Elevation\n)\n\ndef get_floor_height(area):\n    current_level = doc.GetElement(area.LevelId)\n    if current_level is None and hasattr(view, \"GenLevel\"):\n        current_level = view.GenLevel\n    if current_level is None:\n        return None, None, None\n    next_level = next(\n        (level for level in all_levels\n         if level.Elevation > current_level.Elevation + 0.0001),\n        None\n    )\n    if next_level is None:\n        return current_level, None, None\n    height_m = (next_level.Elevation - current_level.Elevation) * FT_TO_M\n    return current_level, next_level, height_m\n\nareas = list(\n    FilteredElementCollector(doc, view.Id)\n    .OfCategory(BuiltInCategory.OST_Areas)\n    .WhereElementIsNotElementType()\n    .ToElements()\n)\n\nif not areas and not clear_only:\n    OUT = [\"目前視圖中沒有 Area。\"]\nelse:\n    tx = Transaction(doc, \"Area 範圍線、邊長與周長\")\n    tx.Start()\n    try:\n        segment_text_id = get_or_create_text_type(SEG_TEXT_NAME, 2.5)\n        total_text_id = get_or_create_text_type(TOTAL_TEXT_NAME, 3.5)\n        line_style = get_or_create_line_style()\n\n        # Always remove results produced by older runs before generating.\n        # Use three identifiers because some Revit element classes do not expose Comments.\n        generated_ids = []\n        for text_note in FilteredElementCollector(doc, view.Id).OfClass(TextNote).ToElements():\n            text_type = doc.GetElement(text_note.GetTypeId())\n            type_name = get_type_name(text_type) if text_type else \"\"\n            if has_tag(text_note) or type_name in (SEG_TEXT_NAME, TOTAL_TEXT_NAME):\n                generated_ids.append(text_note.Id)\n\n        for curve_element in FilteredElementCollector(doc, view.Id).OfClass(CurveElement).ToElements():\n            style_name = \"\"\n            try:\n                if curve_element.LineStyle is not None:\n                    style_name = curve_element.LineStyle.Name\n            except:\n                pass\n            if has_tag(curve_element) or style_name in ((LINE_STYLE_NAME,) + LEGACY_LINE_STYLE_NAMES):\n                generated_ids.append(curve_element.Id)\n\n        unique_ids = []\n        seen_ids = set()\n        for element_id in generated_ids:\n            value = element_id_number(element_id)\n            if value not in seen_ids:\n                seen_ids.add(value)\n                unique_ids.append(element_id)\n\n        for element_id in unique_ids:\n            doc.Delete(element_id)\n        deleted_count = len(unique_ids)\n\n        if clear_only:\n            tx.Commit()\n            OUT = [\"清除完成\", \"已刪除 {0} 個上次產生的圖元。\".format(deleted_count)]\n        else:\n            seg_options = TextNoteOptions(segment_text_id)\n            seg_options.HorizontalAlignment = HorizontalTextAlignment.Center\n            seg_options.VerticalAlignment = VerticalTextAlignment.Middle\n\n            total_options = TextNoteOptions(total_text_id)\n            total_options.HorizontalAlignment = HorizontalTextAlignment.Left\n            total_options.VerticalAlignment = VerticalTextAlignment.Top\n\n            boundary_options = SpatialElementBoundaryOptions()\n            boundary_options.SpatialElementBoundaryLocation = SpatialElementBoundaryLocation.Finish\n\n            segment_offset_ft = (label_offset_mm / 304.8) * view.Scale\n            total_offset_ft = (total_offset_mm / 304.8) * view.Scale\n            results = []\n\n            for index, area in enumerate(areas, 1):\n                loops = area.GetBoundarySegments(boundary_options)\n                if not loops:\n                    results.append(\"Area {0}: 無有效邊界\".format(element_id_number(area.Id)))\n                    continue\n\n                loop_data = []\n                for loop in loops:\n                    points = loop_points(loop)\n                    loop_data.append((loop, points, abs(signed_area_xy(points))))\n\n                loop_data.sort(key=lambda item: item[2], reverse=True)\n                selected = loop_data if include_inner else loop_data[:1]\n                perimeter_ft = 0.0\n                segment_lengths_m = []\n                all_points = []\n\n                for loop, points, _ in selected:\n                    all_points.extend(points)\n                    for segment in loop:\n                        curve = segment.GetCurve()\n                        length_ft = curve.Length\n                        perimeter_ft += length_ft\n                        segment_lengths_m.append(length_ft * FT_TO_M)\n\n                        if draw_boundary:\n                            detail = doc.Create.NewDetailCurve(view, curve)\n                            if line_style:\n                                detail.LineStyle = line_style\n                            set_tag(detail)\n\n                        mid = curve.Evaluate(0.5, True)\n                        try:\n                            tangent = curve.ComputeDerivatives(0.5, True).BasisX.Normalize()\n                            normal = XYZ(-tangent.Y, tangent.X, 0)\n                        except:\n                            normal = XYZ(0, 1, 0)\n                        text_point = mid.Add(normal.Multiply(segment_offset_ft))\n                        text = format_m(length_ft * FT_TO_M)\n                        note = TextNote.Create(doc, view.Id, text_point, text, seg_options)\n                        set_tag(note)\n                        angle = readable_angle(curve)\n                        axis = Line.CreateBound(text_point, text_point.Add(XYZ.BasisZ))\n                        ElementTransformUtils.RotateElement(doc, note.Id, axis, angle)\n\n                perimeter_m = perimeter_ft * FT_TO_M\n                area_name = \"\"\n                try:\n                    area_name = area.Name or \"\"\n                except:\n                    pass\n                title = area_name if area_name else \"Area {0}\".format(element_id_number(area.Id))\n\n                # Place the calculation block to the right of the boundary.\n                max_x = max(p.X for p in all_points)\n                max_y = max(p.Y for p in all_points)\n                base_z = sum(p.Z for p in all_points) / len(all_points)\n                total_point = XYZ(max_x + total_offset_ft, max_y, base_z)\n\n                formula = sum_formula(segment_lengths_m)\n                current_level, next_level, floor_height_m = get_floor_height(area)\n                if current_level is not None and current_level.Name:\n                    calculation_heading = \"{0}外殼面積計算式\".format(current_level.Name)\n                else:\n                    calculation_heading = \"樓層外殼面積計算式\"\n                block_lines = [\n                    calculation_heading,\n                    \"周長算式 = {0} = {1}\".format(formula, format_m(perimeter_m))\n                ]\n\n                shell_area_m2 = None\n                if floor_height_m is not None:\n                    shell_area_m2 = perimeter_m * floor_height_m\n                    block_lines.append(\n                        \"樓高 = {0} - {1} = {2}\".format(\n                            next_level.Name,\n                            current_level.Name,\n                            format_m(floor_height_m)\n                        )\n                    )\n                    block_lines.append(\n                        \"外殼面積 = {0} × {1} = {2} m²\".format(\n                            plain_number(perimeter_m),\n                            plain_number(floor_height_m),\n                            plain_number(shell_area_m2)\n                        )\n                    )\n                elif current_level is None:\n                    block_lines.append(\"樓高 = 找不到 Area 所屬樓層\")\n                    block_lines.append(\"外殼面積 = 無法計算\")\n                else:\n                    block_lines.append(\n                        \"樓高 = {0} 上方沒有更高樓層\".format(current_level.Name)\n                    )\n                    block_lines.append(\"外殼面積 = 無法計算\")\n\n                total_note = TextNote.Create(\n                    doc,\n                    view.Id,\n                    total_point,\n                    \"\\n\".join(block_lines),\n                    total_options\n                )\n                set_tag(total_note)\n                results.append({\n                    \"AreaId\": element_id_number(area.Id),\n                    \"Name\": title,\n                    \"Perimeter_m\": round(perimeter_m, decimals),\n                    \"FloorHeight_m\": (\n                        round(floor_height_m, decimals)\n                        if floor_height_m is not None else None\n                    ),\n                    \"ShellArea_m2\": (\n                        round(shell_area_m2, decimals)\n                        if shell_area_m2 is not None else None\n                    ),\n                    \"LoopCount\": len(selected)\n                })\n\n            tx.Commit()\n            OUT = results\n    except Exception as ex:\n        if tx.HasStarted():\n            tx.RollBack()\n        OUT = [\"執行失敗，已回復本次變更。\", str(ex), traceback.format_exc()]\n",
      "Engine": "CPython3",
