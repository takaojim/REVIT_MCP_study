  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\nimport math\r\nimport time\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef flatten_list(lst):\r\n    result = []\r\n    for i in lst:\r\n        if isinstance(i, list) or type(i).__name__ == 'list':\r\n            result.extend(flatten_list(i))\r\n        else:\r\n            result.append(i)\r\n    return result\r\n\r\n# --- 1. 取得所有輸入參數 ---\r\n# IN[0]: 屋頂曲面 (Surface)\r\nin0 = flatten_list(IN[0] if isinstance(IN[0], list) else [IN[0]])\r\nroof_srf = in0[0] if in0 else None\r\n\r\n# IN[1]: 洩水方向參考平面\r\ntry: ref_plane_element = UnwrapElement(IN[1])\r\nexcept: ref_plane_element = None\r\n\r\n# IN[2]: 邊緣線 (Curve)\r\nin2 = flatten_list(IN[2] if isinstance(IN[2], list) else [IN[2]])\r\nedge_curve = in2[0] if in2 else None\r\nif hasattr(edge_curve, \"GeometryCurve\"):\r\n    edge_curve = edge_curve.GeometryCurve\r\n\r\n# IN[3]: 深度距離 (cm)\r\ntry: depth = float(IN[3])\r\nexcept: depth = 60.0\r\n\r\n# IN[4]: 長度比例 (0.0 ~ 1.0)\r\ntry: ratio = float(IN[4])\r\nexcept: ratio = 0.9\r\nif ratio > 1.0: ratio = ratio / 100.0\r\nif ratio <= 0.0 or ratio > 1.0: ratio = 1.0\r\n\r\n# IN[5]: 溝頭的直徑 (cm)\r\ntry: tile_diameter = float(IN[5])\r\nexcept: tile_diameter = 12.0\r\ntile_radius = tile_diameter / 2.0\r\n\r\n# IN[6]: 兩溝頭間的間距 (cm)\r\ntry: spacing = float(IN[6])\r\nexcept: spacing = 15.0\r\nif spacing <= 0: spacing = 15.0\r\n\r\n# 💡 IN[7]: 滴水厚度 (cm)\r\ntry: drip_thickness = float(IN[7]) if len(IN) > 7 and IN[7] else 2.5\r\nexcept: drip_thickness = 2.5\r\n\r\n# 💡 IN[8]: 溝頭厚度 (cm)\r\ntry: wadang_thickness = float(IN[8]) if len(IN) > 8 and IN[8] else 4.0\r\nexcept: wadang_thickness = 4.0\r\n\r\n# 💡 IN[9]: 材質名稱\r\ntry: mat_name = IN[9] if len(IN) > 9 and IN[9] else \"傳統青灰瓦\"\r\nexcept: mat_name = \"傳統青灰瓦\"\r\nif not isinstance(mat_name, str): mat_name = \"傳統青灰瓦\"\r\n\r\ndebug_log = [\"--- 妹妹的山牆邊緣勾頭滴水報告 ---\"]\r\nsolids = []\r\n\r\nif roof_srf and ref_plane_element and edge_curve:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    \r\n    try:\r\n        debug_log.append(\"🔍 參數: 深度={} | 直徑={} | 間距={} | 滴水厚={} | 溝頭厚={}\".format(depth, tile_diameter, spacing, drip_thickness, wadang_thickness))\r\n        \r\n        # --- 2. 處理邊緣曲線與比例 ---\r\n        # 確保曲線是從高處(屋脊)往低處(屋簷)走\r\n        if edge_curve.StartPoint.Z < edge_curve.EndPoint.Z:\r\n            edge_curve = edge_curve.Reverse()\r\n            \r\n        total_len = edge_curve.Length\r\n        target_len = total_len * ratio\r\n        \r\n        # 使用 Fuzzy 絕對弧長均分法，算出每個瓦當的精準座標點\r\n        num_tiles = int(math.floor(target_len / spacing))\r\n        if num_tiles < 1: num_tiles = 1\r\n        actual_spacing = target_len / num_tiles\r\n        \r\n        pts = []\r\n        for i in range(num_tiles + 1):\r\n            l = i * actual_spacing\r\n            if l > total_len: l = total_len\r\n            pts.append(edge_curve.PointAtSegmentLength(l))\r\n            \r\n        debug_log.append(\"📏 邊緣總長: {:.1f}cm, 目標比例: {}, 生成瓦當數量: {}\".format(total_len, ratio, len(pts)))\r\n\r\n        # --- 3. 智慧向內探測雷達 (判斷往左長還是往右長) ---\r\n        base_plane = ref_plane_element.GetPlane().ToPlane()\r\n        v_ref = base_plane.Normal \r\n        \r\n        mid_pt = edge_curve.PointAtParameter(0.5)\r\n        \r\n        p_test_pos = mid_pt.Translate(v_ref, 50.0)\r\n        p_test_neg = mid_pt.Translate(v_ref.Reverse(), 50.0)\r\n        \r\n        dist_pos = p_test_pos.DistanceTo(roof_srf.ClosestPointTo(p_test_pos))\r\n        dist_neg = p_test_neg.DistanceTo(roof_srf.ClosestPointTo(p_test_neg))\r\n        \r\n        if dist_pos < dist_neg:\r\n            v_in = v_ref\r\n        else:\r\n            v_in = v_ref.Reverse()\r\n            \r\n        debug_log.append(\"📡 智慧雷達已鎖定屋頂內部方向！\")\r\n\r\n        # --- 4. 生成勾頭與滴水幾何實體 ---\r\n        success_count = 0\r\n        for i in range(len(pts)):\r\n            try:\r\n                pA = pts[i]\r\n                uvA = roof_srf.UVParameterAtPoint(pA)\r\n                upA = roof_srf.NormalAtParameter(uvA.U, uvA.V) \r\n                \r\n                # 🛠️ 生成勾頭 (Wadang)\r\n                planeA = Plane.ByOriginNormal(pA, v_in)\r\n                circleA = Circle.ByPlaneRadius(planeA, tile_radius)\r\n                \r\n                # 💡 勾頭蓋(瓦當)套用 IN[8] 厚度\r\n                wadang_head = circleA.ExtrudeAsSolid(v_in.Reverse(), wadang_thickness)\r\n                solids.append(wadang_head)\r\n                \r\n                line_body = Line.ByStartPointDirectionLength(pA, v_in, depth)\r\n                wadang_body = Solid.BySweep(circleA, line_body)\r\n                solids.append(wadang_body)\r\n                \r\n                # 🛠️ 生成滴水 (Drip)\r\n                if i < len(pts) - 1:\r\n                    pB = pts[i+1]\r\n                    uvB = roof_srf.UVParameterAtPoint(pB)\r\n                    upB = roof_srf.NormalAtParameter(uvB.U, uvB.V)\r\n                    \r\n                    vec_AB = Vector.ByTwoPoints(pA, pB)\r\n                    \r\n                    v_down = vec_AB.Cross(v_in).Normalized()\r\n                    if v_down.Z > 0: v_down = v_down.Reverse()\r\n                    \r\n                    R_arc = 1.5 * spacing\r\n                    drop = tile_radius * 2.0\r\n                    \r\n                    pM = Point.ByCoordinates((pA.X+pB.X)/2, (pA.Y+pB.Y)/2, (pA.Z+pB.Z)/2)\r\n                    pC = pM.Translate(v_down, drop)\r\n                    \r\n                    dist_AB = pA.DistanceTo(pB)\r\n                    if R_arc > dist_AB / 2.0:\r\n                        h_T = R_arc - math.sqrt(R_arc**2 - (dist_AB / 2.0)**2)\r\n                        pT = pM.Translate(v_down, h_T)\r\n                    else: pT = pM\r\n                    \r\n                    vec_AC = Vector.ByTwoPoints(pA, pC)\r\n                    L_AC = vec_AC.Length\r\n                    pM_AC = Point.ByCoordinates((pA.X+pC.X)/2, (pA.Y+pC.Y)/2, (pA.Z+pC.Z)/2)\r\n                    N_AC = vec_AC.Cross(v_in).Normalized()\r\n                    dir_left = Vector.ByCoordinates(-vec_AB.X + v_down.X, -vec_AB.Y + v_down.Y, -vec_AB.Z + v_down.Z)\r\n                    if N_AC.Dot(dir_left) < 0: N_AC = N_AC.Reverse()\r\n                    \r\n                    if R_arc > L_AC / 2.0:\r\n                        h_AC = R_arc - math.sqrt(R_arc**2 - (L_AC / 2.0)**2)\r\n                        pL = pM_AC.Translate(N_AC, h_AC)\r\n                    else: pL = pM_AC\r\n                    \r\n                    vec_CB = Vector.ByTwoPoints(pC, pB)\r\n                    L_CB = vec_CB.Length\r\n                    pM_CB = Point.ByCoordinates((pC.X+pB.X)/2, (pC.Y+pB.Y)/2, (pC.Z+pB.Z)/2)\r\n                    N_CB = vec_CB.Cross(v_in).Normalized()\r\n                    dir_right = Vector.ByCoordinates(vec_AB.X + v_down.X, vec_AB.Y + v_down.Y, vec_AB.Z + v_down.Z)\r\n                    if N_CB.Dot(dir_right) < 0: N_CB = N_CB.Reverse()\r\n                    \r\n                    if R_arc > L_CB / 2.0:\r\n                        h_CB = R_arc - math.sqrt(R_arc**2 - (L_CB / 2.0)**2)\r\n                        pR = pM_CB.Translate(N_CB, h_CB)\r\n                    else: pR = pM_CB\r\n                    \r\n                    arc1 = Arc.ByThreePoints(pA, pT, pB)\r\n                    arc2 = Arc.ByThreePoints(pB, pR, pC)\r\n                    arc3 = Arc.ByThreePoints(pC, pL, pA)\r\n                    drip_profile = PolyCurve.ByJoinedCurves([arc1, arc2, arc3])\r\n                    \r\n                    # 💡 滴水片(花邊)套用 IN[7] 厚度\r\n                    drip_head = drip_profile.ExtrudeAsSolid(v_in.Reverse(), drip_thickness)\r\n                    solids.append(drip_head)\r\n                    \r\n                    drip_body = drip_profile.ExtrudeAsSolid(v_in, depth)\r\n                    solids.append(drip_body)\r\n                    \r\n                success_count += 1\r\n            except Exception as e: pass\r\n            \r\n        debug_log.append(\"🌟 成功生成 {} 組客製厚度的邊緣勾頭與滴水！\".format(success_count))\r\n        \r\n        # --- 5. 處理材質與寫入 Revit ---\r\n        mat_id = ElementId.InvalidElementId\r\n        mat_collector = FilteredElementCollector(doc).OfClass(Material)\r\n        for m in mat_collector:\r\n            if m.Name == mat_name:\r\n                mat_id = m.Id\r\n                break\r\n        if mat_id == ElementId.InvalidElementId:\r\n            try:\r\n                mat_id = Material.Create(doc, mat_name)\r\n                new_mat = doc.GetElement(mat_id)\r\n                new_mat.Color = Color(100, 100, 100) \r\n            except: pass\r\n\r\n        revit_elements = []\r\n        cat_id = ElementId(BuiltInCategory.OST_Roofs) \r\n\r\n        for d_solid in solids:\r\n            if d_solid is None or isinstance(d_solid, str): continue\r\n            try:\r\n                r_geom = d_solid.ToRevitType()\r\n                geom_list = List[GeometryObject]()\r\n                if isinstance(r_geom, list) or type(r_geom).__name__ in [\"Array[GeometryObject]\", \"tuple\"]:\r\n                    for g in r_geom: \r\n                        if mat_id != ElementId.InvalidElementId and hasattr(g, \"MaterialId\"): g.MaterialId = mat_id\r\n                        geom_list.Add(g)\r\n                else: \r\n                    if mat_id != ElementId.InvalidElementId and hasattr(r_geom, \"MaterialId\"): r_geom.MaterialId = mat_id\r\n                    geom_list.Add(r_geom)\r\n                    \r\n                ds = DirectShape.CreateElement(doc, cat_id)\r\n                ds.SetShape(geom_list)\r\n                ds.Name = \"Traditional_Edge_Tiles\"\r\n                revit_elements.append(ds)\r\n            except: pass\r\n\r\n        group_element = None\r\n        if revit_elements:\r\n            id_list = List[ElementId]()\r\n            for el in revit_elements: id_list.Add(el.Id)\r\n            try:\r\n                group_element = doc.Create.NewGroup(id_list)\r\n                group_element.GroupType.Name = \"山牆邊緣收邊瓦_\" + str(int(time.time())) \r\n            except: pass\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        OUT = [revit_elements if group_element is None else group_element, debug_log]\r\n\r\n    except Exception as e:\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        OUT = [\"❌ 發生錯誤: \" + str(e), debug_log]\r\nelse:\r\n    OUT = [\"⚠️ 請確認 IN[0]屋頂曲面、IN[1]參考平面、IN[2]邊緣線 皆已正確輸入。\", debug_log]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
