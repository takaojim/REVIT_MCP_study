{
  "Uuid": "8fcacbc5-4b48-48eb-8c24-45d1628638e9",
  "IsCustomNode": false,
  "Description": "",
  "Name": "明細-欄位暫時獨立編號",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "ed8525cf6d6c4668bf0629ab15726e78",
      "Name": "要排序的欄位",
      "Type": "string",
      "Type2": "string",
      "Value": "類型標記",
      "Description": "建立一個字串。"
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "SerializedWidth": 0.0,
      "SerializedHeight": 0.0,
      "Id": "ed8525cf6d6c4668bf0629ab15726e78",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "146591d3275a4f279d5871c66ed3263e",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "建立一個字串。",
      "InputValue": "類型標記"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nactive_view = doc.ActiveView\r\n\r\n# IN[0]: 要重新編號的目標欄位 (例如 \"類型標記\")\r\nif len(IN) < 1 or not IN[0]:\r\n    OUT = \"⚠️ 錯誤：小明哥哥，請給妹妹 IN[0] (要處理的欄位名稱) 喔！\"\r\nelse:\r\n    param_name = IN[0]\r\n    prefix = \"T\" # 小明指定的臨時前置字母\r\n\r\n    # 超強大參數尋找器：無視唯讀分身\r\n    def get_writable_param(element, p_name):\r\n        params = element.GetParameters(p_name)\r\n        for p in params:\r\n            if not p.IsReadOnly:\r\n                return p\r\n        return None\r\n\r\n    if isinstance(active_view, ViewSchedule):\r\n        elements = list(FilteredElementCollector(doc, active_view.Id).WhereElementIsNotElementType().ToElements())\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        \r\n        count = 1\r\n        processed_types = []\r\n        \r\n        for el in elements:\r\n            target_param = None\r\n            is_type_param = False\r\n            \r\n            # 先找實體，找不到就去挖類型\r\n            p_inst = get_writable_param(el, param_name)\r\n            if p_inst:\r\n                target_param = p_inst\r\n            else:\r\n                tid = el.GetTypeId()\r\n                if tid != ElementId.InvalidElementId:\r\n                    etype = doc.GetElement(tid)\r\n                    if etype:\r\n                        p_type = get_writable_param(etype, param_name)\r\n                        if p_type:\r\n                            target_param = p_type\r\n                            is_type_param = True\r\n                            \r\n            if not target_param:\r\n                continue\r\n                \r\n            # 如果是類型參數，確保每個「類型」只發一次臨時編號\r\n            if is_type_param:\r\n                tid = el.GetTypeId()\r\n                if tid in processed_types:\r\n                    continue\r\n                processed_types.append(tid)\r\n\r\n            # 執行寫入：賦予絕對獨立的 T 編號\r\n            try:\r\n                target_param.Set(prefix + str(count))\r\n                count += 1\r\n            except:\r\n                pass\r\n                    \r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        \r\n        OUT = \"【臨時獨立編號大成功】！成功為「{}」欄位產生了 {} 個不重複的 T 編號！現在可以安心去排序囉！優呵！啾咪！\".format(param_name, count - 1)\r\n    else:\r\n        OUT = \"錯誤：小明哥哥，請記得切換到明細表視窗喔！\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "529e8e717b8a4316bd1910748eb6b453",
      "NodeType": "PythonScriptNode",
