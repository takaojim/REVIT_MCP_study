{
  "Uuid": "2a5727f3-b82d-43f2-bb9f-f11de39690f1",
  "IsCustomNode": false,
  "Description": "",
  "Name": "建築-全部取消接合",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "1e776e9f155c42a9a3d8e5487dd25b57",
      "Name": "說明",
      "Type": "string",
      "Type2": "string",
      "Value": "取消所有物件的接合",
      "Description": "建立一個字串。"
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nunjoined_count = 0\r\n\r\n# 🌟 開門密語\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# 妹妹的防呆過濾網：直接在內部撈出「所有不是類型(Type)」的實體物件\r\nall_elements = FilteredElementCollector(doc).WhereElementIsNotElementType().ToElements()\r\n\r\nfor el in all_elements:\r\n    # 效能優化：如果這個物件連 Category (類別) 都沒有，通常是系統隱藏物件，直接跳過不處理\r\n    if el.Category is None: continue \r\n    \r\n    try:\r\n        # 直接問 Revit：這個物件現在跟誰接合在一起？\r\n        joined_ids = JoinGeometryUtils.GetJoinedElements(doc, el)\r\n        \r\n        # 如果沒有跟別人接合，就換下一個\r\n        if not joined_ids: continue\r\n        \r\n        for j_id in joined_ids:\r\n            joined_el = doc.GetElement(j_id)\r\n            if joined_el is not None:\r\n                # 無情地把它們切開！\r\n                JoinGeometryUtils.UnjoinGeometry(doc, el, joined_el)\r\n                unjoined_count += 1\r\n    except:\r\n        # 遇到天生不支援接合的物件（例如文字、線條），直接忽略，保護腳本不崩潰\r\n        continue\r\n\r\n# 🌟 關門密語\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = \"報告哥哥！全域無差別大掃除完成！共無情拆散了 {} 組接合關係。\".format(unjoined_count)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a73401567893400d8e6c10538ea2f1fc",
      "NodeType": "PythonScriptNode",
      "Inputs": [],
