      "Description": "建立一個數字。",
      "InputValue": 42.854
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ncycle_len_cm = IN[0] if IN[0] else 42.854\r\nis_detailed = IN[1]\r\n\r\nlist_8 = [\"吉-財\",\"凶-病\",\"凶-離\",\"吉-義\",\"吉-官\",\"凶-劫\",\"凶-害\",\"吉-本\"]\r\nlist_32 = [\"_財德\",\"_寶庫\",\"_六合\",\"_迎福\",\"_退財\",\"_公事\",\"_牢執\",\"_孤寡\",\r\n           \"_長庫\",\"_劫財\",\"_官鬼\",\"_失脫\",\"_添丁\",\"_益利\",\"_貴子\",\"_大吉\",\r\n           \"_順科\",\"_橫財\",\"_進益\",\"_富貴\",\"_死別\",\"_退口\",\"_離鄉\",\"_財失\",\r\n           \"_災至\",\"_死絕\",\"_病臨\",\"_口舌\",\"_財至\",\"_登科\",\"_進寶\",\"_興旺\"]\r\n\r\ndef get_fengshui_text(val_feet, L_cm, detailed):\r\n    val_cm = round(val_feet * 30.48, 2)\r\n    rem = val_cm % L_cm\r\n    \r\n    idx8 = int(rem / (L_cm / 8.0))\r\n    if idx8 >= 8: idx8 = 7\r\n    \r\n    idx32 = int(rem / (L_cm / 32.0))\r\n    if idx32 >= 32: idx32 = 31\r\n    \r\n    return list_8[idx8] + list_32[idx32] if detailed else list_8[idx8]\r\n\r\ndims = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Dimensions).WhereElementIsNotElementType().ToElements()\r\n\r\ncount = 0\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor dim in dims:\r\n    try:\r\n        dim_name = dim.Name\r\n        \r\n        if dim_name is None or \"文公尺\" not in dim_name:\r\n            continue\r\n            \r\n        is_multi = False\r\n        try:\r\n            if dim.Segments is not None and dim.Segments.Size > 0:\r\n                is_multi = True\r\n        except: pass\r\n            \r\n        if is_multi:\r\n            for seg in dim.Segments:\r\n                try:\r\n                    if seg.Value is not None:\r\n                        txt = get_fengshui_text(seg.Value, cycle_len_cm, is_detailed)\r\n                        # 溫柔地把原本後面的字擦掉，然後寫到下面去！\r\n                        seg.Suffix = \"\" \r\n                        seg.Below = txt\r\n                        count += 1\r\n                except: pass\r\n        else:\r\n            try:\r\n                if dim.Value is not None:\r\n                    txt = get_fengshui_text(dim.Value, cycle_len_cm, is_detailed)\r\n                    # 溫柔地把原本後面的字擦掉，然後寫到下面去！\r\n                    dim.Suffix = \"\" \r\n                    dim.Below = txt\r\n                    count += 1\r\n            except: pass\r\n            \r\n    except: pass\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nif count > 0:\r\n    OUT = \"優喝！妹妹溫柔地幫 {} 個段落的文字搬家到「下方」囉！啾咪！\".format(count)\r\nelse:\r\n    OUT = \"報告哥哥：沒抓到可以修改的標註喔！\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "771083792130480dbd5e0c9a1de9e575",
      "NodeType": "PythonScriptNode",
