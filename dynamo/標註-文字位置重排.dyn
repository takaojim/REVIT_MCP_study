{
  "Uuid": "7dd9faa7-5a50-447b-afff-1aaa8d10e850",
  "IsCustomNode": false,
  "Description": "",
  "Name": "標註-文字位置重排",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "59b90a7549274ff09fdde2ae1ad738bf",
      "Name": "String",
      "Type": "string",
      "Type2": "string",
      "Value": "因為比例的不同會產生文字的間距由所不同甚至文字重疊利用此程式來重新安排文字的位置\r\n",
      "Description": "建立一個字串。"
    },
    {
      "Id": "98f88cb50b954e76ab3e964a39212845",
      "Name": "選取要重新安排的尺寸",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "b7e0612b-da0c-4700-a9fb-e9ab6227a236-00117af7,b7e0612b-da0c-4700-a9fb-e9ab6227a236-00117af8,b7e0612b-da0c-4700-a9fb-e9ab6227a236-00117af9,b7e0612b-da0c-4700-a9fb-e9ab6227a236-00117afa",
      "Description": "從 Revit 文件中選取多個元素。"
    }
  ],
  "Outputs": [
    {
      "Id": "a5585fc589444899973e0c6fb4a6cbfb",
      "Name": "Watch",
      "Type": "string",
      "InitialValue": "報告小明哥！接收愛心能量，除蟲成功！\n多行文字高度已正確乘上比例。\n成功將 3 段文字完美往下排好啦！",
      "Description": "視覺化節點的輸出"
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\n\r\ndef to_list(obj):\r\n    if hasattr(obj, '__iter__') and not isinstance(obj, dict) and not isinstance(obj, str):\r\n        return obj\r\n    return [obj]\r\n\r\nif not IN[0]:\r\n    OUT = \"小明哥！Select 節點沒抓到文字喔，快去 Revit 框選那些重疊的文字！\"\r\nelse:\r\n    elements = to_list(UnwrapElement(IN[0]))\r\n    valid_texts = [t for t in elements if isinstance(t, TextNote)]\r\n\r\n    if not valid_texts:\r\n        OUT = \"小明哥，選取範圍內沒有找到 Revit 的文字標註（TextNote）喔！\"\r\n    else:\r\n        scale = view.Scale\r\n        \r\n        # 抓取單行字高，用來設定段落間距\r\n        text_type = valid_texts[0].TextNoteType\r\n        size_param = text_type.get_Parameter(BuiltInParameter.TEXT_SIZE)\r\n        text_size_feet = size_param.AsDouble() if size_param else (3 / 304.8)\r\n        \r\n        # === 💡 小明哥專屬設定區 ===\r\n        block_gap_multiplier = 0.5  # 段落之間的空白間距倍率 (0.5 = 半個字高的留白距離)\r\n        # ==========================\r\n        \r\n        # 段落留白間距 (轉換為模型空間的真實距離)\r\n        gap_between_blocks = text_size_feet * scale * block_gap_multiplier\r\n\r\n        up_dir = view.UpDirection\r\n        \r\n        text_info = []\r\n        for t in valid_texts:\r\n            origin = t.Coord\r\n            proj_dist = origin.DotProduct(up_dir)\r\n            \r\n            # 🧠 關鍵除蟲修正：t.Height 是圖紙高度，必須乘上「視圖比例(scale)」才會是模型裡的實際尺寸！\r\n            model_height = t.Height * scale \r\n            \r\n            text_info.append({\r\n                \"text\": t, \r\n                \"dist\": proj_dist, \r\n                \"origin\": origin,\r\n                \"height\": model_height \r\n            })\r\n\r\n        # 由上往下排，高度投影值由大到小排序\r\n        text_info.sort(key=lambda x: x[\"dist\"], reverse=True)\r\n\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        \r\n        base_origin = text_info[0][\"origin\"]\r\n        moved_count = 0\r\n        current_cumulative_drop = 0.0\r\n\r\n        for i in range(len(text_info)):\r\n            current_text = text_info[i][\"text\"]\r\n            current_origin = text_info[i][\"origin\"]\r\n            current_model_height = text_info[i][\"height\"]\r\n            \r\n            # 目標位置 = 基準點 - 目前累積的下降距離\r\n            offset_vector = up_dir.Multiply(-current_cumulative_drop)\r\n            target_pos = base_origin.Add(offset_vector)\r\n            \r\n            translation = target_pos.Subtract(current_origin)\r\n            \r\n            if translation.GetLength() > 0.001:\r\n                ElementTransformUtils.MoveElement(doc, current_text.Id, translation)\r\n                moved_count += 1\r\n                \r\n            # 🧠 往下累積距離：加上「這塊文字的真實高度」+「段落留白」\r\n            current_cumulative_drop += (current_model_height + gap_between_blocks)\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n        OUT = \"報告小明哥！接收愛心能量，除蟲成功！\\n多行文字高度已正確乘上比例。\\n成功將 {} 段文字完美往下排好啦！\".format(moved_count)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f1e241b9f9bd40a29d99563b494e544d",
