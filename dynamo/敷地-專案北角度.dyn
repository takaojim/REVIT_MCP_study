      "Description": "視覺化節點的輸出"
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 載入 Dynamo 的 Revit 節點與交易管理員\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# 取得當前文件\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 你的整體參數名稱\r\nparam_name = \"專案與正北角度\"\r\n\r\n# 1. 取得專案北與正北的夾角\r\nproject_location = doc.ActiveProjectLocation\r\nproject_position = project_location.GetProjectPosition(XYZ.Zero)\r\nangle_rad = project_position.Angle\r\nangle_deg = math.degrees(angle_rad)\r\n\r\nresult_msg = \"\"\r\n\r\n# 2. 透過 GlobalParametersManager 處理整體參數\r\nif GlobalParametersManager.AreGlobalParametersAllowed(doc):\r\n    # 開啟交易以修改/建立文件元素\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    try:\r\n        # 尋找參數是否存在\r\n        gp_id = GlobalParametersManager.FindByName(doc, param_name)\r\n        \r\n        if gp_id != ElementId.InvalidElementId:\r\n            # 【狀況 A：參數已存在】取得該元件\r\n            gp = doc.GetElement(gp_id)\r\n            action_msg = \"已更新現有參數\"\r\n        else:\r\n            # 【狀況 B：參數不存在】讓程式自動建立\r\n            try:\r\n                # 嘗試 Revit 2022 (含) 以後版本的 API 寫法 (SpecTypeId)\r\n                gp = GlobalParameter.Create(doc, param_name, SpecTypeId.Angle)\r\n            except:\r\n                # 若報錯，則退回 Revit 2021 (含) 以前版本的 API 寫法 (ParameterType)\r\n                gp = GlobalParameter.Create(doc, param_name, ParameterType.Angle)\r\n            \r\n            action_msg = \"已自動建立新參數並寫入\"\r\n            \r\n        # 將數值寫入整體參數 (必須包裝為 DoubleParameterValue，且為弧度)\r\n        new_value = DoubleParameterValue(angle_rad)\r\n        gp.SetValue(new_value)\r\n        \r\n        # 提交交易\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        result_msg = \"成功：{} (角度: {:.4f}°)。\".format(action_msg, angle_deg)\r\n        \r\n    except Exception as e:\r\n        # 若發生意外錯誤，退回交易\r\n        TransactionManager.Instance.ForceCloseTransaction()\r\n        result_msg = \"執行失敗發生錯誤：\" + str(e)\r\nelse:\r\n    result_msg = \"錯誤：當前的 Revit 專案檔案不支援整體參數功能。\"\r\n\r\n# 將度數與執行狀態輸出\r\nOUT = [angle_deg, result_msg]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "c87aebd564d64baca81bf9e5024b7cd2",
      "NodeType": "PythonScriptNode",
