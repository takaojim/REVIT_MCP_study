  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\nimport traceback\r\n\r\nclr.AddReference('ProtoGeometry')\r\nimport Autodesk.DesignScript.Geometry as DS\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nfrom Revit.GeometryConversion import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 將整個程式包裝在 try-except 中\r\ntry:\r\n    # ================= 1. 輸入與資料整理 =================\r\n    dyn_floor = IN[0]\r\n    floor = UnwrapElement(dyn_floor)\r\n\r\n    raw_lines = IN[1]\r\n    if not hasattr(raw_lines, '__iter__'):\r\n        raw_lines = [raw_lines]\r\n\r\n    dyn_curves = []\r\n    for item in raw_lines:\r\n        if hasattr(item, \"PointAtParameter\"):\r\n            dyn_curves.append(item)\r\n        else:\r\n            unwrapped = UnwrapElement(item)\r\n            if hasattr(unwrapped, \"GeometryCurve\"):\r\n                dyn_curves.append(unwrapped.GeometryCurve.ToProtoType())\r\n            elif hasattr(unwrapped, \"ToProtoType\"):\r\n                dyn_curves.append(unwrapped.ToProtoType())\r\n\r\n    try: delta_z_cm = float(IN[2]) if IN[2] is not None else 0.0\r\n    except: delta_z_cm = 0.0\r\n    \r\n    try: dist_cm = float(IN[3]) if IN[3] is not None else 50.0\r\n    except: dist_cm = 50.0\r\n\r\n    if not dyn_curves: raise ValueError(\"找不到線條！\")\r\n\r\n    polycurve = dyn_curves[0] if len(dyn_curves) == 1 else DS.PolyCurve.ByJoinedCurves(dyn_curves)\r\n    \r\n    # 將中心線投影到 Z=0 的 2D 平面上\r\n    xy_plane = DS.Plane.ByOriginNormal(DS.Point.Origin(), DS.Vector.ZAxis())\r\n    polycurve_2d = polycurve.PullOntoPlane(xy_plane)\r\n    total_length_2d = polycurve_2d.Length\r\n\r\n    # ================= 2. 幾何運算：計算放射交點 =================\r\n    floor_solids = dyn_floor.Geometry()\r\n    floor_solid = next((geo for geo in floor_solids if isinstance(geo, DS.Solid)), None)\r\n\r\n    if not floor_solid:\r\n        raise ValueError(\"無法取得樓板實體幾何\")\r\n\r\n    bbox = floor_solid.BoundingBox\r\n    mid_z = (bbox.MinPoint.Z + bbox.MaxPoint.Z) / 2.0\r\n\r\n    def get_furthest_pt(center_pt, intersect_results):\r\n        max_dist = -1\r\n        furthest_pt = None\r\n        for item in intersect_results:\r\n            if hasattr(item, \"StartPoint\") and hasattr(item, \"EndPoint\"):\r\n                for p in [item.StartPoint, item.EndPoint]:\r\n                    d = ((center_pt.X - p.X)**2 + (center_pt.Y - p.Y)**2)**0.5\r\n                    if d > max_dist:\r\n                        max_dist = d; furthest_pt = p\r\n            elif hasattr(item, \"X\"):\r\n                d = ((center_pt.X - item.X)**2 + (center_pt.Y - item.Y)**2)**0.5\r\n                if d > max_dist:\r\n                    max_dist = d; furthest_pt = item\r\n        return furthest_pt\r\n\r\n    num_segments = int(total_length_2d / dist_cm)\r\n    if num_segments < 1: num_segments = 1\r\n\r\n    split_lines_2d = []\r\n\r\n    for i in range(1, num_segments):\r\n        t = (i * dist_cm) / total_length_2d\r\n        if t >= 1.0: continue\r\n\r\n        pt_2d = polycurve_2d.PointAtParameter(t)\r\n        tangent = polycurve_2d.TangentAtParameter(t)\r\n        perp_vec = tangent.Cross(DS.Vector.ZAxis()).Normalized()\r\n\r\n        ray_start_pt = DS.Point.ByCoordinates(pt_2d.X, pt_2d.Y, mid_z)\r\n        line1 = DS.Line.ByStartPointDirectionLength(ray_start_pt, perp_vec, 100000)\r\n        line2 = DS.Line.ByStartPointDirectionLength(ray_start_pt, perp_vec.Reverse(), 100000)\r\n\r\n        int1 = line1.Intersect(floor_solid)\r\n        int2 = line2.Intersect(floor_solid)\r\n\r\n        p1 = get_furthest_pt(ray_start_pt, int1)\r\n        p2 = get_furthest_pt(ray_start_pt, int2)\r\n\r\n        if p1 and p2:\r\n            dyn_p1 = DS.Point.ByCoordinates(p1.X, p1.Y, 0)\r\n            dyn_p2 = DS.Point.ByCoordinates(p2.X, p2.Y, 0)\r\n            split_lines_2d.append((dyn_p1.ToXyz(), dyn_p2.ToXyz()))\r\n\r\n    # ================= 3. Revit API 修改：切割與變高 =================\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    editor = floor.GetSlabShapeEditor() if hasattr(floor, \"GetSlabShapeEditor\") else floor.SlabShapeEditor\r\n    \r\n    # 【關鍵修正】：順序對調！先重置樓板，再啟用編輯器！\r\n    editor.ResetSlabShape()\r\n    editor.Enable()\r\n    doc.Regenerate()\r\n\r\n    for rp1, rp2 in split_lines_2d:\r\n        try:\r\n            if hasattr(editor, \"AddPoint\"):\r\n                v1 = editor.AddPoint(rp1)\r\n                v2 = editor.AddPoint(rp2)\r\n                editor.AddSplitLine(v1, v2)\r\n            else:\r\n                v1 = editor.DrawPoint(rp1)\r\n                v2 = editor.DrawPoint(rp2)\r\n                editor.DrawSplitLine(v1, v2)\r\n        except Exception as e:\r\n            pass # 忽略極少數太靠近邊界無法畫線的情況\r\n\r\n    doc.Regenerate()\r\n\r\n    # 抓取「所有」頂點\r\n    vertices = list(editor.SlabShapeVertices)\r\n    \r\n    for v in vertices:\r\n        pt_dyn = v.Position.ToPoint()\r\n        pt_2d = DS.Point.ByCoordinates(pt_dyn.X, pt_dyn.Y, 0)\r\n        \r\n        closest_pt = polycurve_2d.ClosestPointTo(pt_2d)\r\n        t = polycurve_2d.ParameterAtPoint(closest_pt)\r\n        \r\n        offset_feet = (delta_z_cm * t) / 30.48\r\n        \r\n        editor.ModifySubElement(v, offset_feet)\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    OUT = f\"Success: 完美切割並調整高程！共處理了 {len(vertices)} 個節點。\"\r\n\r\nexcept Exception as e:\r\n    OUT = traceback.format_exc()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
