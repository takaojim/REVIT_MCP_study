    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# 載入 Python 標準資源庫和 DesignScript 資源庫\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# 此節點的輸入將在 IN 變數中儲存為一個清單。\r\ndataEnteringNode = IN\r\n\r\n# 在此行下方放入您的程式碼\r\nA=IN[0]\r\nB=IN[1]\r\nC=0\r\nfor i in A:\r\n\tif (i == B):\r\n\t\tK=C\r\n\telse:\r\n\t\tC+=1\t\r\n\t \t\r\n\r\n\r\n\r\n# 指定輸出至 OUT 變數。\r\nOUT =  K",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "c27ace8f8b9d4d1e9b8f61f43afee835",
      "Inputs": [
        {
          "Id": "72333fef5817474e8336857a68029c44",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "12c16b89b9264da49cecbaeb82d59bac",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "25211a55d17447d5a4528dc265f01a34",
          "Name": "OUT",
          "Description": "Python 腳本的結果",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "執行嵌入的 Python 腳本。"
    },
