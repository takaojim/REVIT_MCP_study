      "Description": "建立一個字串。"
    },
    {
      "Id": "c13731ab06b74b9a97edd9813b8b8858",
      "Name": "3.定義上段界線",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "啟用在 True 與 False 之間選取"
    },
    {
      "Id": "f35500fcd3ad41fe9dfaa4dd94847555",
      "Name": "2.上段界線-選參考平面",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "86ad6ae5-67d6-484d-a7e6-2157b8ab556a-000c686f",
