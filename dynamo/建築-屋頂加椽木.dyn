      "Id": "0b486441f9fb41a3ace22142505cf59a",
      "Name": "6.椽木邊長度",
      "Type": "number",
      "Type2": "number",
      "Value": "7.5",
      "NumberType": "Double",
      "Description": "建立一個數字。"
    },
