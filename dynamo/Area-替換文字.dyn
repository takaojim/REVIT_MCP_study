  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- [修正區] 更暴力的清單防呆機制 ---\r\n# 檢查輸入的是不是清單 (list)，如果不是，就硬把它包成清單 [ ]\r\nraw_input = IN[0]\r\nif isinstance(raw_input, list):\r\n    elements = UnwrapElement(raw_input)\r\nelse:\r\n    elements = [UnwrapElement(raw_input)]\r\n\r\n# 強制把尋找與取代的內容轉成字串 (避免輸入數字時報錯)\r\nfind_str = str(IN[1])    \r\nreplace_str = str(IN[2]) \r\n\r\nmodified_elements = []\r\n\r\n# 開啟 Transaction 準備修改模型\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor elem in elements:\r\n    try:\r\n        # 確保有這個物件，而且它是文字註解 (TextNote)\r\n        if elem and isinstance(elem, TextNote):\r\n            current_text = elem.Text\r\n            # 檢查要找的字串有沒有在裡面\r\n            if find_str in current_text:\r\n                # 執行置換\r\n                elem.Text = current_text.replace(find_str, replace_str)\r\n                modified_elements.append(elem)\r\n    except Exception as e:\r\n        # 發生其他例外就略過\r\n        pass\r\n\r\n# 結束 Transaction\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = modified_elements",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "bf86772b1f814dcd84c4d61806be4fdd",
      "NodeType": "PythonScriptNode",
