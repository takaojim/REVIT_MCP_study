  },
  "Inputs": [
    {
      "Id": "3deaebade68146efb821eba91b8b725a",
      "Name": "要修改的文字",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "d62f80d7-89eb-4c4c-9fa6-71ff9d04e0d5-000eca81",
      "Description": "從 Revit 文件中選取多個元素。"
    },
    {
