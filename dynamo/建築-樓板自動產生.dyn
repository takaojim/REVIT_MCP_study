{
  "Uuid": "8f644fdb-d19b-4e1b-bf57-104b81acc1e1",
  "IsCustomNode": false,
  "Description": "",
  "Name": "建築-自動產生樓版",
  "ElementResolver": {
    "ResolutionMap": {}
  },
