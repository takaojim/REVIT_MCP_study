      "Replication": "Disabled",
      "Description": "從文件中選取模型元素。"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 容差與輸入\r\nMIN_TOLERANCE = 0.0053 \r\nfam_name = IN[0]  # \"25x25坵塊圖A\"\r\nterrain = UnwrapElement(IN[1])\r\n# 【PRO 升級】：讀取 IN[2] 作為邊長，若無輸入則預設為 25\r\nL_meters = float(IN[2]) if IN[2] is not None else 25.0\r\n\r\n# --- 純數學 2D 交點判定 ---\r\ndef ccw(A, B, C):\r\n    return (C.Y - A.Y) * (B.X - A.X) > (B.Y - A.Y) * (C.X - A.X)\r\n\r\ndef intersect_2d(A, B, C, D):\r\n    return ccw(A, C, D) != ccw(B, C, D) and ccw(A, B, C) != ccw(A, B, D)\r\n\r\ndef get_inter_count(boundary_pts, contours_pts):\r\n    if not boundary_pts: return 0\r\n    pA, pB = boundary_pts\r\n    count = 0\r\n    for pC, pD in contours_pts:\r\n        if intersect_2d(pA, pB, pC, pD):\r\n            count += 1\r\n    return count\r\n\r\n# --- 1. 取得視圖專屬等高線 ---\r\nopt = Options()\r\nopt.View = doc.ActiveView\r\ngeo = terrain.get_Geometry(opt)\r\n\r\ndef extract_flat_contours(geom_elem):\r\n    result = []\r\n    if geom_elem is None: return result\r\n    for g in geom_elem:\r\n        if isinstance(g, Solid): continue\r\n        elif isinstance(g, GeometryInstance):\r\n            result.extend(extract_flat_contours(g.GetInstanceGeometry()))\r\n        elif isinstance(g, Curve):\r\n            p1, p2 = g.GetEndPoint(0), g.GetEndPoint(1)\r\n            p1_f, p2_f = XYZ(p1.X, p1.Y, 0), XYZ(p2.X, p2.Y, 0)\r\n            if p1_f.DistanceTo(p2_f) > MIN_TOLERANCE: result.append((p1_f, p2_f))\r\n        elif isinstance(g, PolyLine):\r\n            pts = g.GetCoordinates()\r\n            for i in range(pts.Count - 1):\r\n                p1_f, p2_f = XYZ(pts[i].X, pts[i].Y, 0), XYZ(pts[i+1].X, pts[i+1].Y, 0)\r\n                if p1_f.DistanceTo(p2_f) > MIN_TOLERANCE: result.append((p1_f, p2_f))\r\n    return result\r\n\r\nflat_contours = extract_flat_contours(geo)\r\n\r\n# --- 2. 處理族群 ---\r\ncollector = FilteredElementCollector(doc).OfClass(FamilyInstance)\r\ninstances = [i for i in collector if i.Symbol.Family.Name == fam_name]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\nprocessed_count = 0\r\ng_opt = Options()\r\ng_opt.DetailLevel = ViewDetailLevel.Fine\r\n\r\nfor inst in instances:\r\n    rot = inst.Location.Rotation\r\n    inst_geo = inst.get_Geometry(g_opt)\r\n    edge_lines = []\r\n    \r\n    for g_obj in inst_geo:\r\n        if isinstance(g_obj, GeometryInstance):\r\n            for e in g_obj.GetInstanceGeometry():\r\n                if isinstance(e, Curve):\r\n                    p1, p2 = e.GetEndPoint(0), e.GetEndPoint(1)\r\n                    p1_f, p2_f = XYZ(p1.X, p1.Y, 0), XYZ(p2.X, p2.Y, 0)\r\n                    if p1_f.DistanceTo(p2_f) > MIN_TOLERANCE:\r\n                        edge_lines.append((p1_f, p2_f, p1_f.DistanceTo(p2_f)))\r\n\r\n    if len(edge_lines) >= 4:\r\n        edge_lines.sort(key=lambda x: x[2], reverse=True)\r\n        top_4 = edge_lines[:4]\r\n        cx = sum((l[0].X + l[1].X)/2.0 for l in top_4)/4.0\r\n        cy = sum((l[0].Y + l[1].Y)/2.0 for l in top_4)/4.0\r\n        \r\n        line_A, line_B, line_C, line_D = None, None, None, None\r\n        for l in top_4:\r\n            mx, my = (l[0].X + l[1].X)/2.0, (l[0].Y + l[1].Y)/2.0\r\n            lx = (mx-cx)*math.cos(-rot)-(my-cy)*math.sin(-rot)\r\n            ly = (mx-cx)*math.sin(-rot)+(my-cy)*math.cos(-rot)\r\n            ang = math.degrees(math.atan2(ly, lx)) % 360\r\n            if 45 <= ang < 135: line_A = (l[0], l[1])     # 上\r\n            elif 135 <= ang < 225: line_D = (l[0], l[1])   # 左\r\n            elif 225 <= ang < 315: line_C = (l[0], l[1])   # 下\r\n            else: line_B = (l[0], l[1])                  # 右\r\n\r\n        # --- 3. 計算與寫入 ---\r\n        vA, vB, vC, vD = [get_inter_count(line, flat_contours) for line in [line_A, line_B, line_C, line_D]]\r\n        vN = vA + vB + vC + vD\r\n        slope = (vN * math.pi) / (8.0 * L_meters) * 100.0 if L_meters > 0 else 0\r\n        \r\n        if slope < 5: lvl = \"1\"\r\n        elif slope < 15: lvl = \"2\"\r\n        elif slope < 30: lvl = \"3\"\r\n        elif slope < 40: lvl = \"4\"\r\n        elif slope < 55: lvl = \"5\"\r\n        else: lvl = \"6\"\r\n        \r\n        # 寫入文字參數\r\n        data = {\"A\":vA, \"B\":vB, \"C\":vC, \"D\":vD, \"N\":vN, \"S\":\"{:.2f}%\".format(slope), \"級坡\":lvl}\r\n        for k, v in data.items():\r\n            p = inst.LookupParameter(k)\r\n            if p: p.Set(str(v))\r\n        processed_count += 1\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\nOUT = \"哥哥，邊長設定為 \" + str(L_meters) + \"m，已處理 \" + str(processed_count) + \" 個坵塊！\"",
