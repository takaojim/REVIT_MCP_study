    },
    {
      "ConcreteType": "Dynamo.Nodes.DSModelElementSelection, DSRevitNodesUI",
      "NodeType": "ExtensionNode",
      "InstanceId": [
        "e3e3855a-b588-4a73-a51d-bf8f641156fc-000c52f2"
      ],
      "Id": "76e9921f4d9c429aa29fc370b2b09be8",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "70cccd7d4888466cbb68aba567fc8be7",
          "Name": "Element",
          "Description": "選取的元素。",
          "UsingDefaultValue": false,
          "Level": 2,
