  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 載入 Revit 節點與事務處理\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 接收 Dynamo 輸入\r\nsource_view = UnwrapElement(IN[0]) # 天花板平面圖\r\ntarget_view = doc.ActiveView       # 當前作用中的視圖\r\n\r\ndef flatten_curve(curve, z_val):\r\n    \"\"\"將曲線精準投影(壓平)到目標視圖的 Z 高度\"\"\"\r\n    try:\r\n        if isinstance(curve, Line):\r\n            p1 = curve.GetEndPoint(0)\r\n            p2 = curve.GetEndPoint(1)\r\n            return Line.CreateBound(XYZ(p1.X, p1.Y, z_val), XYZ(p2.X, p2.Y, z_val))\r\n        elif isinstance(curve, Arc):\r\n            p1 = curve.GetEndPoint(0)\r\n            p2 = curve.GetEndPoint(1)\r\n            pm = curve.Evaluate(0.5, True)\r\n            return Arc.Create(XYZ(p1.X, p1.Y, z_val), XYZ(p2.X, p2.Y, z_val), XYZ(pm.X, pm.Y, z_val))\r\n        else:\r\n            start_z = curve.GetEndPoint(0).Z\r\n            translation = Transform.CreateTranslation(XYZ(0, 0, z_val - start_z))\r\n            return curve.CreateTransformed(translation)\r\n    except:\r\n        return None\r\n\r\n# 確保當前視圖是平面視圖 (包含一般平面圖與面積平面圖)\r\nif not isinstance(source_view, View) or not isinstance(target_view, ViewPlan):\r\n    OUT = \"錯誤：IN[0] 必須是視圖，且您目前 Revit 的作用中視圖必須是平面圖或面積平面圖。\"\r\nelse:\r\n    # 取得目標視圖的基準高度\r\n    if target_view.GenLevel:\r\n        target_z = target_view.GenLevel.Elevation\r\n    else:\r\n        target_z = target_view.Origin.Z\r\n\r\n    # 篩選天花板\r\n    ceilings = FilteredElementCollector(doc, source_view.Id)\\\r\n                .OfCategory(BuiltInCategory.OST_Ceilings)\\\r\n                .WhereElementIsNotElementType()\\\r\n                .ToElements()\r\n\r\n    opt = Options()\r\n    opt.ComputeReferences = True\r\n    opt.View = source_view\r\n\r\n    created_lines = []\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    # 處理 SketchPlane (面積邊界線必須要有草圖平面才能建立)\r\n    sketch_plane = target_view.SketchPlane\r\n    if not sketch_plane and target_view.GenLevel:\r\n        try:\r\n            sketch_plane = SketchPlane.Create(doc, target_view.GenLevel.Id)\r\n            target_view.SketchPlane = sketch_plane\r\n        except:\r\n            pass\r\n\r\n    # 判斷當下是否為「面積平面圖」\r\n    is_area_plan = (target_view.ViewType == ViewType.AreaPlan)\r\n\r\n    for ceiling in ceilings:\r\n        geom_elem = ceiling.get_Geometry(opt)\r\n        if not geom_elem: continue\r\n\r\n        for geom_obj in geom_elem:\r\n            if isinstance(geom_obj, Solid) and geom_obj.Volume > 0:\r\n                for face in geom_obj.Faces:\r\n                    # 尋找底面\r\n                    if isinstance(face, PlanarFace) and face.FaceNormal.Z < -0.5:\r\n                        curve_loops = face.GetEdgesAsCurveLoops()\r\n                        \r\n                        if curve_loops:\r\n                            # 篩選最外圍邊界 (過濾掉內部開孔)\r\n                            outer_loop = max(curve_loops, key=lambda loop: loop.GetExactLength())\r\n                            \r\n                            for curve in outer_loop:\r\n                                flat_curve = flatten_curve(curve, target_z)\r\n                                if flat_curve and sketch_plane:\r\n                                    try:\r\n                                        if is_area_plan:\r\n                                            # 如果是面積視圖，直接建立「面積邊界線」\r\n                                            line = doc.Create.NewAreaBoundaryLine(sketch_plane, flat_curve, target_view)\r\n                                        else:\r\n                                            # 如果是一般視圖，建立「一般詳圖線」\r\n                                            line = doc.Create.NewDetailCurve(target_view, flat_curve)\r\n                                        \r\n                                        created_lines.append(line)\r\n                                    except Exception as e:\r\n                                        pass\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    \r\n    OUT = created_lines",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "c530479042984fffa85f2aafd002d59b",
      "NodeType": "PythonScriptNode",
