  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# 匯入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 匯入 Revit UI API (為了抓取選取項)\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\n\r\n# 匯入 Revit 服務\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# 取得目前的文檔與介面\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n# 讀取輸入的字串 (如果沒有輸入或是 null，就當作空字串處理)\r\nprefix_str = IN[0] if IN[0] else \"\"\r\nsuffix_str = IN[1] if IN[1] else \"\"\r\ntarget_str = IN[2] if IN[2] else \"\"\r\nreplace_str = IN[3] if IN[3] else \"\"\r\n\r\n# 抓取目前專案瀏覽器中被選取的元素 ID\r\nselection_ids = uidoc.Selection.GetElementIds()\r\n\r\nrenamed_views = []\r\nfailed_views = []\r\n\r\n# 開啟交易 (Transaction)\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor eid in selection_ids:\r\n    element = doc.GetElement(eid)\r\n    \r\n    # 判斷選取的是否為「視圖」(View)，並且排除掉「視圖樣板」(View Template)\r\n    if isinstance(element, View) and not element.IsTemplate:\r\n        current_name = element.Name\r\n        new_name = current_name\r\n        \r\n        # 1. 先執行字串置換 (如果有指定要被置換的字串)\r\n        if target_str != \"\":\r\n            new_name = new_name.replace(target_str, replace_str)\r\n            \r\n        # 2. 再加上前綴與後綴\r\n        new_name = prefix_str + new_name + suffix_str\r\n        \r\n        # 如果名稱有變動，才執行重新命名\r\n        if new_name != current_name:\r\n            try:\r\n                element.Name = new_name\r\n                renamed_views.append(new_name)\r\n            except Exception as e:\r\n                # Revit 不允許視圖名稱重複，如果遇到重複會報錯，這裡把它捕捉起來\r\n                failed_views.append(\"{} (錯誤: {})\".format(current_name, str(e)))\r\n\r\n# 結束交易\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# 輸出結果：告訴哥哥哪些成功了，哪些失敗了\r\nOUT = {\r\n    \"成功重命名的視圖\": renamed_views,\r\n    \"命名失敗的視圖 (可能名稱重複)\": failed_views\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "c4bd06fade89440ca69c2b991a0b9ce0",
      "NodeType": "PythonScriptNode",
