  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==============================================================================\r\n# 腳本名稱: 傳統建築中式屋脊 BIM 參數化生成器 (Dynamo to Revit API)\r\n# 版本編號: VER: 2026.07-V11.0-FINAL (絕對零三角形·純 B-Rep 平滑實體終極版)\r\n# 開發對象: 小明專屬 / 徹底拋棄 Dynamo 材質節點，保證 0% 三角碎線、線條完美流暢\r\n# ==============================================================================\r\n\r\nimport clr\r\nimport sys\r\n\r\n# 0. 引入 .NET 泛型列表\r\nfrom System.Collections.Generic import List\r\n\r\n# 1. 引入 Dynamo 幾何庫\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# 2. 引入 Revit 節點與幾何擴充庫\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n# 3. 引入 Revit API 核心庫 (絕對不碰任何會導致 Mesh 的材質封裝)\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import BuiltInCategory, ElementId, DirectShape, GeometryObject\r\n\r\n# 4. 引入 Revit 交易與文件管理工具\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# ==============================================================================\r\n# [輸入區] 讀取 Dynamo 前端參數\r\n# ==============================================================================\r\nif isinstance(IN[0], list):\r\n    curves = IN[0]\r\nelif IN[0] is not None:\r\n    curves = [IN[0]]\r\nelse:\r\n    curves = []\r\n\r\nridge_input = IN[1]\r\nif isinstance(ridge_input, list):\r\n    ridge_type = ridge_input[0] if (len(ridge_input) > 0 and isinstance(ridge_input[0], str)) else \"垂脊\"\r\nelif isinstance(ridge_input, str):\r\n    ridge_type = ridge_input\r\nelse:\r\n    ridge_type = \"垂脊\"\r\n\r\nscale = IN[2] if (IN[2] is not None and IN[2] > 0) else 1.0\r\nt_start = IN[3] if (len(IN) > 3 and IN[3] is not None) else 0.0\r\nt_end   = IN[4] if (len(IN) > 4 and IN[4] is not None) else 1.0\r\n\r\n# ==============================================================================\r\n# [資料庫] 傳統屋脊標準尺寸查表 (單位: cm)\r\n# ==============================================================================\r\nridge_db = {\r\n    \"正脊\": {\"bw\": 50, \"mw\": 40, \"tw\": 30, \"h\": 90},\r\n    \"垂脊\": {\"bw\": 40, \"mw\": 30, \"tw\": 20, \"h\": 60},\r\n    \"戧脊\": {\"bw\": 35, \"mw\": 26, \"tw\": 18, \"h\": 50},\r\n    \"圍脊\": {\"bw\": 35, \"mw\": 26, \"tw\": 20, \"h\": 45},\r\n    \"博脊\": {\"bw\": 30, \"mw\": 22, \"tw\": 16, \"h\": 40}\r\n}\r\n\r\ndim = ridge_db.get(ridge_type, ridge_db[\"垂脊\"])\r\nbw = dim[\"bw\"] * scale\r\nmw = dim[\"mw\"] * scale\r\ntw = dim[\"tw\"] * scale\r\nh  = dim[\"h\"] * scale\r\n\r\ngenerated_solids = []\r\nworld_z = Vector.ByCoordinates(0, 0, 1)\r\n\r\n# ==============================================================================\r\n# [運算區 1] 解析幾何一體純化 (維護絕對平滑軌跡)\r\n# ==============================================================================\r\nfor crv in curves:\r\n    if crv is None:\r\n        continue\r\n    \r\n    crv_length = crv.Length\r\n    if crv_length < 0.01:\r\n        continue\r\n    \r\n    start_pt = crv.StartPoint\r\n    end_pt   = crv.EndPoint\r\n    chord_len = start_pt.DistanceTo(end_pt)\r\n    \r\n    if abs(crv_length - chord_len) < (crv_length * 0.001) or isinstance(crv, Line):\r\n        tan_start = crv.TangentAtParameter(0.0).Normalized()\r\n        tan_end   = crv.TangentAtParameter(1.0).Normalized()\r\n        \r\n        if t_start < 0.0:\r\n            pure_start = start_pt.Subtract(tan_start.Scale(abs(t_start) * crv_length))\r\n        else:\r\n            pure_start = crv.PointAtParameter(min(t_start, 1.0))\r\n            \r\n        if t_end > 1.0:\r\n            pure_end = end_pt.Add(tan_end.Scale((t_end - 1.0) * crv_length))\r\n        else:\r\n            pure_end = crv.PointAtParameter(max(t_end, 0.0))\r\n            \r\n        new_path = Line.ByStartPointEndPoint(pure_start, pure_end)\r\n    else:\r\n        sample_pts = [crv.PointAtParameter(i / 35.0) for i in range(36)]\r\n        new_path = NurbsCurve.ByPoints(sample_pts, 3)\r\n        \r\n    pts = [\r\n        Point.ByCoordinates(-bw/2, 0, 0),\r\n        Point.ByCoordinates(-mw/2, h*0.3, 0),\r\n        Point.ByCoordinates(-tw/2, h, 0),\r\n        Point.ByCoordinates(tw/2, h, 0),\r\n        Point.ByCoordinates(mw/2, h*0.3, 0),\r\n        Point.ByCoordinates(bw/2, 0, 0)\r\n    ]\r\n    profile_poly = Polygon.ByPoints(pts)\r\n    tangent = new_path.TangentAtParameter(0)\r\n    \r\n    if abs(tangent.Z) > 0.999:\r\n        right_vec = tangent.Cross(Vector.ByCoordinates(1, 0, 0)).Normalized()\r\n    else:\r\n        right_vec = world_z.Cross(tangent).Normalized()\r\n        \r\n    up_vec = tangent.Cross(right_vec).Normalized()\r\n    corrected_cs = CoordinateSystem.ByOriginVectors(new_path.StartPoint, right_vec, up_vec)\r\n    oriented_profile = profile_poly.Transform(CoordinateSystem.Identity(), corrected_cs)\r\n    \r\n    ridge_solid = Solid.BySweep(oriented_profile, new_path)\r\n    if ridge_solid is not None:\r\n        generated_solids.append(ridge_solid)\r\n\r\n# ==============================================================================\r\n# [運算區 2] 純 Revit API 平滑烘焙 (100% 拒絕網格化，還原完美 B-Rep 外框)\r\n# ==============================================================================\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nrevit_baked_elements = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\ncat_id = ElementId(BuiltInCategory.OST_Roofs)\r\n\r\nfor sol in generated_solids:\r\n    if sol is None:\r\n        continue\r\n    try:\r\n        revit_geom = sol.ToRevitType()\r\n        if revit_geom is None:\r\n            continue\r\n            \r\n        geom_list = List[GeometryObject]()\r\n        if hasattr(revit_geom, \"__iter__\"):\r\n            for g in revit_geom:\r\n                geom_list.Add(g)\r\n        else:\r\n            geom_list.Add(revit_geom)\r\n        \r\n        # 建立最純淨的 DirectShape B-Rep 實體，絕不觸發網格化\r\n        ds = DirectShape.CreateElement(doc, cat_id)\r\n        ds.ApplicationId = \"Dynamo_Traditional_Ridge_V11.0\"\r\n        ds.ApplicationDataId = ridge_type\r\n        ds.Name = f\"傳統屋脊_{ridge_type}\"\r\n        ds.SetShape(geom_list)\r\n        \r\n        revit_baked_elements.append(ds)\r\n    except Exception as e:\r\n        revit_baked_elements.append(f\"建立失敗: {str(e)}\")\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# ==============================================================================\r\n# [輸出] 傳回 Revit 實體\r\n# ==============================================================================\r\nOUT = revit_baked_elements",
      "Engine": "CPython3",
      "VariableInputPorts": true,
