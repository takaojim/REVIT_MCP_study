    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "SerializedWidth": 0.0,
      "SerializedHeight": 0.0,
      "Id": "0b66da1664674aba9b79d5e8a355a2f4",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "cbff0ef587d94d7ea9989147f7355f0a",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "建立一個字串。",
      "InputValue": "注意:\r\nexcel的頁面名稱為\"參數表\"\r\n第一行為參數名稱"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- 接收輸入 ---\r\n# IN[0]: 來自我們「橫著走萬用搜尋器」抓到的圖框 Element\r\ninput_element = UnwrapElement(IN[0]) if IN[0] else None\r\n# IN[1]: 來自 Excel 的資料\r\nexcel_data = IN[1]\r\n\r\ncreated_sheets = []\r\nerror_log = []\r\n\r\n# 直接提取圖框的 ID (我們百分之百信任哥哥搜出來的東西！)\r\ntb_id = ElementId.InvalidElementId\r\nif input_element:\r\n    try:\r\n        tb_id = input_element.Id\r\n    except:\r\n        error_log.append(\"⚠️ 無法讀取圖框 ID，將建立空白圖紙。\")\r\nelse:\r\n    error_log.append(\"⚠️ 沒有收到圖框，將建立空白圖紙。\")\r\n\r\n# 取得目前專案中所有的圖紙編號，避免重複當機\r\nexisting_sheets = FilteredElementCollector(doc).OfClass(ViewSheet).ToElements()\r\nexisting_numbers = [s.SheetNumber for s in existing_sheets]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# 從第 2 列開始跑 (跳過標題)\r\nfor i in range(1, len(excel_data)):\r\n    row = excel_data[i]\r\n    if not row or len(row) < 2: continue\r\n        \r\n    sheet_num = str(row[0]).strip()\r\n    sheet_name = str(row[1]).strip()\r\n    \r\n    # 清理 Excel 可能帶來的 .0 尾巴\r\n    if sheet_num.endswith('.0'):\r\n        sheet_num = sheet_num[:-2]\r\n\r\n    # 防呆：如果圖紙已經存在，安全跳過\r\n    if sheet_num in existing_numbers:\r\n        error_log.append(\"跳過：編號 {} 已存在\".format(sheet_num))\r\n        continue\r\n\r\n    try:\r\n        # 🌟 建立圖紙 (強制掛上我們指定的圖框 ID)\r\n        new_sheet = ViewSheet.Create(doc, tb_id)\r\n        new_sheet.SheetNumber = sheet_num\r\n        new_sheet.Name = sheet_name\r\n        created_sheets.append(new_sheet)\r\n    except Exception as e:\r\n        error_log.append(\"編號 {} 建立失敗: {}\".format(sheet_num, str(e)))\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# 輸出結果\r\nOUT = created_sheets, \"✅ 成功建立了 {} 張帶有圖框的圖紙！\".format(len(created_sheets)), error_log",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7e31aa037b414663a05a17f2e1b3bd3f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
