    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 1. 取得關鍵字，轉小寫、去空白\r\nraw_input = IN[0]\r\nif isinstance(raw_input, list): \r\n    raw_input = raw_input[0]\r\nkeyword = str(raw_input).replace(\" \", \"\").lower()\r\n\r\n# 2. 萬用大客廳：搜集所有 ElementType (無差別全搜，真正橫著走！)\r\ncollector = FilteredElementCollector(doc).WhereElementIsElementType().ToElements()\r\n\r\ntarget_elem = None\r\ndebug_msg = \"報告哥哥：還是沒找到😭\"\r\n\r\nfor elem in collector:\r\n    f_name = \"\"\r\n    t_name = \"\"\r\n    \r\n    # 🛡️ 獨立防護罩 A：只保護族群名稱\r\n    try:\r\n        f_name = str(elem.FamilyName)\r\n    except:\r\n        pass\r\n        \r\n    # 🛡️ 獨立防護罩 B：只保護類型名稱\r\n    try:\r\n        t_name = str(elem.Name)\r\n    except:\r\n        pass\r\n        \r\n    # 如果兩個都抓不到，才跳過這個隱形人\r\n    if not f_name and not t_name:\r\n        continue\r\n        \r\n    # 將名字組合、去空白、轉小寫，進行嚴酷比對\r\n    full_string = (f_name + t_name).replace(\" \", \"\").lower()\r\n    \r\n    if keyword in full_string:\r\n        # 找到了！馬上包裝成 Dynamo 綠色元件\r\n        target_elem = elem.ToDSType(True)\r\n        debug_msg = \"✅ 橫著走成功！抓到啦：{} : {} (ID: {})\".format(f_name, t_name, elem.Id)\r\n        break\r\n\r\n# 輸出 [0]目標元件, [1]妹妹的回報\r\nOUT = target_elem",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "201ad6d2c1c840df838076fdc869d4c7",
      "NodeType": "PythonScriptNode",
