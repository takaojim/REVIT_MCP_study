    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 1. 取得哥哥輸入的關鍵字\r\nraw_input = IN[0]\r\nif isinstance(raw_input, list): \r\n    raw_input = raw_input[0]\r\nkeyword = str(raw_input).replace(\" \", \"\").lower()\r\n\r\n# 2. 萬用大客廳：搜集所有 ElementType\r\ncollector = FilteredElementCollector(doc).WhereElementIsElementType().ToElements()\r\n\r\ntarget_elem = None\r\n\r\nfor elem in collector:\r\n    f_name = \"\"\r\n    t_name = \"\"\r\n    \r\n    # 防護罩\r\n    try: f_name = str(elem.FamilyName)\r\n    except: pass\r\n    try: t_name = str(elem.Name)\r\n    except: pass\r\n        \r\n    if not f_name and not t_name: continue\r\n        \r\n    full_string = (f_name + t_name).replace(\" \", \"\").lower()\r\n    \r\n    # 🎯 只要字串命中，立刻抓取這個元件，並且馬上停止搜尋 (break)\r\n    if keyword in full_string:\r\n        target_elem = elem.ToDSType(True)\r\n        break\r\n\r\n# 🚀 妹妹極簡輸出：只給單一個綠色元件！(如果沒找到就會是 null)\r\nOUT = target_elem",
      "Engine": "CPython3",
