    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "SerializedWidth": 0.0,
      "SerializedHeight": 0.0,
      "Id": "7c9c7eb7b1d7493397e641c6fd037bae",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "c66b81fd77b94d0696a9a55de06a5a0a",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "建立一個字串。",
      "InputValue": "注意:\r\nexcel的頁面名稱為\"參數表\"\r\n第一行為參數名稱"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# IN[0]: 基準族群類型 (用來複製的母體)\r\nbase_type = UnwrapElement(IN[0])\r\n# IN[1]: 來自 Data.ImportExcel 的資料清單\r\nexcel_data = IN[1]\r\n\r\nheaders = excel_data[0]\r\nprocessed_types = []  \r\nlog_messages = []     \r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# 🔍 妹妹的防當機魔法：建立母體族群的「現有類型點名單」\r\nbase_family = base_type.Family\r\nexisting_types_dict = {}\r\n\r\n# 抓出這個族群底下所有已經存在的類型\r\nfor symbol_id in base_family.GetFamilySymbolIds():\r\n    try:\r\n        symbol = doc.GetElement(symbol_id)\r\n        if symbol:\r\n            s_name = \"\"\r\n            # 🛡️ 防護罩 A：正常問名字\r\n            try:\r\n                s_name = symbol.Name\r\n            except:\r\n                # 🔨 破門鎚 B：如果它傲嬌報錯，直接從底層參數挖名字！\r\n                param = symbol.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\r\n                if param:\r\n                    s_name = param.AsString()\r\n            \r\n            # 確實有抓到名字才放進名單\r\n            if s_name:\r\n                existing_types_dict[s_name] = symbol\r\n    except Exception as e:\r\n        pass # 遇到真的很怪的殘缺元件，直接安全略過\r\n\r\n# 開始處理 Excel 資料\r\nfor i in range(1, len(excel_data)):\r\n    row = excel_data[i]\r\n    if not row or not row[0]: continue\r\n\r\n    new_type_name = str(row[0]).strip()\r\n    if new_type_name.endswith('.0'):\r\n        new_type_name = new_type_name[:-2]\r\n\r\n    target_type = None\r\n\r\n    # 🚀 核心 Upsert 邏輯：判斷是「更新」還是「新建」\r\n    if new_type_name in existing_types_dict:\r\n        target_type = existing_types_dict[new_type_name]\r\n        log_messages.append(\"🔄 類型 [{}] 已存在 -> 執行參數更新\".format(new_type_name))\r\n    else:\r\n        try:\r\n            target_type = base_type.Duplicate(new_type_name)\r\n            existing_types_dict[new_type_name] = target_type \r\n            log_messages.append(\"✨ 類型 [{}] 成功建立 -> 執行參數寫入\".format(new_type_name))\r\n        except Exception as e:\r\n            log_messages.append(\"❌ 類型 [{}] 建立失敗: {}\".format(new_type_name, str(e)))\r\n            continue\r\n\r\n    # 🎯 開始填入/更新參數\r\n    if target_type:\r\n        processed_types.append(target_type)\r\n        \r\n        for j in range(1, len(headers)):\r\n            if j >= len(row): break\r\n\r\n            param_name = str(headers[j]).strip()\r\n            val = row[j]\r\n\r\n            if val is None or str(val).strip() == \"\":\r\n                continue\r\n\r\n            param = target_type.LookupParameter(param_name)\r\n            if param and not param.IsReadOnly:\r\n                s_type = param.StorageType\r\n                clean_str_val = str(int(val)) if isinstance(val, float) and val.is_integer() else str(val)\r\n\r\n                try:\r\n                    if s_type == StorageType.Double:\r\n                        param.SetValueString(clean_str_val)\r\n                    elif s_type == StorageType.String:\r\n                        param.Set(clean_str_val)\r\n                    elif s_type == StorageType.Integer:\r\n                        param.Set(int(float(val)))\r\n                except Exception as e:\r\n                    pass\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# 輸出結果\r\nOUT = processed_types, \"✅ 順利搞定！新建與更新雙引擎運作中！\", log_messages",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7f063ab2fe3f4213a8a90151542c099e",
      "NodeType": "PythonScriptNode",
