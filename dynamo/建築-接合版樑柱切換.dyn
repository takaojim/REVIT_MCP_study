{
  "Uuid": "a2a8f28a-c928-4048-93be-e86399671651",
  "IsCustomNode": false,
  "Description": "",
  "Name": "建築-版樑切換接合",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "dbafc07f69e643cf8c4a42bd4c8faea6",
      "Name": "說明",
      "Type": "string",
      "Type2": "string",
      "Value": "因為rvit的樓版非常有強勢會剪掉所有的物件我們就做切換接合模式把柱樑的主權抓回\r\n結構柱\r\n結構構架\r\n牆\r\n樓板",
      "Description": "建立一個字串。"
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 1. 鎖定目標大掃描\r\ncolumns = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_StructuralColumns).WhereElementIsNotElementType().ToElements()\r\nbeams = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_StructuralFraming).WhereElementIsNotElementType().ToElements()\r\nfloors = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Floors).WhereElementIsNotElementType().ToElements()\r\n\r\nfloor_ids = List[ElementId]([f.Id for f in floors])\r\n\r\nclean_cut_count = 0\r\njoined_count = 0\r\nswitch_count = 0\r\nfail_count = 0\r\nerror_log = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# 🛠️ 定義核心作戰流程\r\ndef process_pair(boss, sub):\r\n    global clean_cut_count, joined_count, switch_count, fail_count, error_log\r\n    \r\n    # 🔪 步驟 A：盲目解除實體剪切詛咒\r\n    try:\r\n        SolidSolidCutUtils.RemoveCutBetweenSolids(doc, boss, sub)\r\n        clean_cut_count += 1\r\n    except: pass\r\n        \r\n    try:\r\n        SolidSolidCutUtils.RemoveCutBetweenSolids(doc, sub, boss)\r\n        clean_cut_count += 1\r\n    except: pass\r\n\r\n    # 🤝 步驟 B：重新建立接合，並強制切換\r\n    try:\r\n        if not JoinGeometryUtils.AreElementsJoined(doc, boss, sub):\r\n            JoinGeometryUtils.JoinGeometry(doc, boss, sub)\r\n            joined_count += 1\r\n            \r\n        doc.Regenerate() # 強制刷新大腦\r\n        \r\n        # 👑 步驟 C：強制切換順序 (妹妹修正過 API 的版本！)\r\n        if JoinGeometryUtils.AreElementsJoined(doc, boss, sub):\r\n            if not JoinGeometryUtils.IsCuttingElementInJoin(doc, boss, sub):\r\n                JoinGeometryUtils.SwitchJoinOrder(doc, boss, sub)\r\n                switch_count += 1\r\n                \r\n    except Exception as e:\r\n        fail_count += 1\r\n        error_msg = str(e)\r\n        if error_msg not in error_log:\r\n            error_log.append(error_msg)\r\n\r\n# ==========================================\r\n# 🌟 全軍出擊\r\n# ==========================================\r\nif floor_ids.Count > 0:\r\n    for col in columns:\r\n        bbox = col.get_BoundingBox(None)\r\n        if not bbox: continue\r\n        outline = Outline(bbox.Min, bbox.Max)\r\n        filter = BoundingBoxIntersectsFilter(outline)\r\n        for f in FilteredElementCollector(doc, floor_ids).WherePasses(filter).ToElements():\r\n            process_pair(col, f)\r\n            \r\n    for beam in beams:\r\n        bbox = beam.get_BoundingBox(None)\r\n        if not bbox: continue\r\n        outline = Outline(bbox.Min, bbox.Max)\r\n        filter = BoundingBoxIntersectsFilter(outline)\r\n        for f in FilteredElementCollector(doc, floor_ids).WherePasses(filter).ToElements():\r\n            process_pair(beam, f)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# 整理錯誤訊息\r\nerror_summary = \"無\"\r\nif error_log:\r\n    error_summary = \"\\n   👉 \".join(error_log[:3])\r\n\r\n# 🌟 妹妹的防崩潰設計：改用逐行拼接，絕對不會再噴 EOL 錯誤！\r\nout_str = \"【終極解咒與篡位報告】\\n\"\r\nout_str += \"🧹 清除舊有詛咒：{}\\n\".format(clean_cut_count)\r\nout_str += \"🤝 成功重新牽手：{}\\n\".format(joined_count)\r\nout_str += \"👑 成功篡位奪權：{}\\n\".format(switch_count)\r\nout_str += \"💀 失敗次數：{}\\n\".format(fail_count)\r\nout_str += \"⚠️ Revit 殘留報錯：\\n   👉 {}\".format(error_summary)\r\n\r\nOUT = out_str",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "36e27e92f3e74a72aced862db10cb563",
      "NodeType": "PythonScriptNode",
      "Inputs": [],
