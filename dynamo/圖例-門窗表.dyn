    },
    {
      "Id": "a84552ffc5ef492285151b31c97371a6",
      "Name": "2.顯示帷幕窗?",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "false",
      "Description": "啟用在 True 與 False 之間選取"
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==========================================\r\n# VER: v3.3.0 (完美降落・最終版)\r\n# 修正：1. 新增「智能防飄浮機制」：偵測並解決 Revit 圖例自帶主體牆導致的 BoundingBox 虛胖問題。\r\n#      2. 完美繼承 v3.2.0 的數學絕對定位、帷幕開關、自然排序與階段過濾。\r\n# ==========================================\r\nimport clr\r\nimport math\r\nimport re\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef get_input(i, default):\r\n    try:\r\n        if i < len(IN) and IN[i] is not None: return float(IN[i])\r\n    except: pass\r\n    return float(default)\r\n\r\ndef get_input_bool(i, default):\r\n    try:\r\n        if i < len(IN) and IN[i] is not None:\r\n            val = IN[i]\r\n            if isinstance(val, bool): return val\r\n            if isinstance(val, str): return val.lower() in ['true', '1', 't', 'yes', '是']\r\n            if isinstance(val, int): return val != 0\r\n    except: pass\r\n    return default\r\n\r\nphase_input = IN[5] if len(IN) > 5 else None\r\nPHASE_STR = \"\"\r\nif phase_input:\r\n    if hasattr(phase_input, \"Name\"): PHASE_STR = phase_input.Name\r\n    elif isinstance(phase_input, str): PHASE_STR = phase_input\r\n\r\nSHOW_CURTAIN = get_input_bool(6, True) \r\n\r\nBASE_X_CM = get_input(0, 346.259) + get_input(1, 550.0) \r\nOFF_X_CM  = get_input(1, 550.0)\r\nOFF_Y_CM  = get_input(2, 880.0)\r\nCOLS      = int(get_input(3, 7))\r\nFL_OFF_CM = get_input(4, 200.0) \r\nMIN_GRID  = 21 \r\nSHIFT_DOWN_CM = 1342.2 \r\n\r\ndef run_script():\r\n    doc = DocumentManager.Instance.CurrentDBDocument\r\n    view = doc.ActiveView\r\n    \r\n    # --- 0. 階段時間軸解析 ---\r\n    phase_dict = {p.Id.ToString(): idx for idx, p in enumerate(doc.Phases)}\r\n    target_phase_idx = -1\r\n    if PHASE_STR:\r\n        for p in doc.Phases:\r\n            if p.Name == PHASE_STR:\r\n                target_phase_idx = phase_dict.get(p.Id.ToString(), -1); break\r\n    if target_phase_idx == -1:\r\n        view_phase_id = view.get_Parameter(BuiltInParameter.VIEW_PHASE).AsElementId()\r\n        if view_phase_id: target_phase_idx = phase_dict.get(view_phase_id.ToString(), -1)\r\n    if target_phase_idx == -1: return \"❌ 找不到有效的階段，請確認專案設定！\"\r\n\r\n    # --- 1. 資料收集與帷幕判定 ---\r\n    all_inst = list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Doors).WhereElementIsNotElementType()) + \\\r\n               list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Windows).WhereElementIsNotElementType())\r\n    \r\n    type_counts = {}\r\n    first_inst_dict = {} \r\n    for inst in all_inst:\r\n        c_id, d_id = inst.CreatedPhaseId, inst.DemolishedPhaseId\r\n        c_val = c_id.ToString() if c_id else \"-1\"\r\n        d_val = d_id.ToString() if d_id else \"-1\"\r\n        c_idx = phase_dict.get(c_val, 999)\r\n        d_idx = phase_dict.get(d_val, 999) \r\n        \r\n        if c_idx <= target_phase_idx and target_phase_idx < d_idx:\r\n            tid = inst.GetTypeId()\r\n            if tid != ElementId.InvalidElementId:\r\n                type_counts[tid] = type_counts.get(tid, 0) + 1\r\n                if tid not in first_inst_dict: first_inst_dict[tid] = inst\r\n            \r\n    def get_dim_val(t, names):\r\n        for n in names:\r\n            p = t.LookupParameter(n)\r\n            if p and p.StorageType == StorageType.Double:\r\n                return str(int(round(p.AsDouble() * 30.48)))\r\n        return \"0\"\r\n    def get_str_val(t, names):\r\n        for n in names:\r\n            p = t.LookupParameter(n)\r\n            if p:\r\n                if p.StorageType == StorageType.String: return p.AsString() or \"\"\r\n                return p.AsValueString() or str(p.AsInteger())\r\n        return \"\"\r\n    def natural_sort_key(s):\r\n        return [int(text) if text.isdigit() else text.lower() for text in re.split('([0-9]+)', s)]\r\n\r\n    data_list = []\r\n    for tid, count in type_counts.items():\r\n        t = doc.GetElement(tid)\r\n        if not t or not getattr(t, \"Category\", None): continue\r\n        is_d = \"Door\" in t.Category.Name or \"門\" in t.Category.Name\r\n        inst = first_inst_dict[tid]\r\n        sill_param = inst.get_Parameter(BuiltInParameter.INSTANCE_SILL_HEIGHT_PARAM)\r\n        sill_ft = sill_param.AsDouble() if sill_param else 0.0\r\n        \r\n        w_str = get_dim_val(t, [\"Width\", \"寬度\", \"寬\"])\r\n        h_str = get_dim_val(t, [\"Height\", \"高度\", \"高\"])\r\n        fname = t.Family.Name if hasattr(t, \"Family\") else \"\"\r\n        tname = get_str_val(t, [\"Type Name\", \"類型名稱\"])\r\n        \r\n        is_curtain = \"帷幕\" in fname or \"帷幕\" in tname or w_str == \"0\" or h_str == \"0\"\r\n        if is_curtain and not SHOW_CURTAIN: continue\r\n\r\n        remark = get_str_val(t, [\"門窗備註\", \"備註\", \"Type Comments\", \"類型備註\"])\r\n        if not remark: remark = get_str_val(inst, [\"門窗備註\", \"備註\", \"Comments\"])\r\n        \r\n        data_list.append({\r\n            \"Type\": t, \"Mark\": get_str_val(t, [\"Type Mark\", \"類型標記\"]),\r\n            \"Spec\": get_str_val(t, [\"門窗規格\"]), \"W_str\": w_str, \"H_str\": h_str, \r\n            \"Fire\": get_str_val(t, [\"防火等級\", \"防火時效\"]), \"Glass\": get_str_val(t, [\"玻璃厚度\"]), \r\n            \"Qty\": str(count), \"is_d\": is_d, \"Sill_ft\": sill_ft, \"Remark\": remark, \r\n            \"is_curtain\": is_curtain \r\n        })\r\n    data_list.sort(key=lambda d: ((\"1\" if d[\"is_d\"] else \"2\"), natural_sort_key(d[\"Mark\"])))\r\n\r\n    # --- 2. 視圖種子搜尋 ---\r\n    leg_s, ann_s, blk_s = None, None, None\r\n    view_collector = FilteredElementCollector(doc, view.Id)\r\n    for el in view_collector.OfClass(FamilyInstance).OfCategory(BuiltInCategory.OST_GenericAnnotation):\r\n        try:\r\n            fn, tn = el.Symbol.Family.Name, el.Name\r\n            if \"門詳圖標註\" in fn:\r\n                if \"空白\" in tn: blk_s = el\r\n                else: ann_s = el\r\n        except: continue\r\n    for el in FilteredElementCollector(doc, view.Id):\r\n        if el.get_Parameter(BuiltInParameter.LEGEND_COMPONENT): leg_s = el; break\r\n    if not leg_s or not ann_s: return \"❌ 找不到種子！請確認目前視圖有圖例與標註。\"\r\n\r\n    # --- 3. 事務執行 ---\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n    try:\r\n        total_slots = max(MIN_GRID, int(math.ceil(len(data_list)/float(COLS))*COLS))\r\n        for i in range(total_slots):\r\n            col, row = i % COLS, i // COLS\r\n            vec_grid = XYZ((BASE_X_CM + col * OFF_X_CM) / 30.48, (row * OFF_Y_CM) / 30.48, 0)\r\n            \r\n            if i < len(data_list):\r\n                d = data_list[i]\r\n                na_ids = ElementTransformUtils.CopyElement(doc, ann_s.Id, vec_grid)\r\n                nl_ids = ElementTransformUtils.CopyElement(doc, leg_s.Id, vec_grid)\r\n                if not na_ids or not nl_ids: continue\r\n                na, nl = doc.GetElement(na_ids[0]), doc.GetElement(nl_ids[0])\r\n                \r\n                nl.get_Parameter(BuiltInParameter.LEGEND_COMPONENT).Set(d[\"Type\"].Id)\r\n                \r\n                display_w = \"依現場尺寸\" if d[\"is_curtain\"] else d[\"W_str\"]\r\n                display_h = \"依現場尺寸\" if d[\"is_curtain\"] else d[\"H_str\"]\r\n\r\n                def set_p(el, names, v):\r\n                    for n in names:\r\n                        p = el.LookupParameter(n)\r\n                        if p and not p.IsReadOnly:\r\n                            try:\r\n                                if p.StorageType == StorageType.Integer: p.Set(int(float(v)))\r\n                                elif p.StorageType == StorageType.Double: p.Set(float(v)/30.48)\r\n                                else: p.Set(str(v))\r\n                            except: pass\r\n                            break\r\n                set_p(na, [\"類型標記\", \"編號\"], d[\"Mark\"]); set_p(na, [\"寬度\"], display_w)\r\n                set_p(na, [\"高度\"], display_h); set_p(na, [\"數量\"], d[\"Qty\"])\r\n                set_p(na, [\"門窗規格\"], d[\"Spec\"]); set_p(na, [\"防火等級\", \"防火時效\"], d[\"Fire\"])\r\n                set_p(na, [\"玻璃厚度\"], d[\"Glass\"]); set_p(na, [\"門窗備註\", \"備註\", \"門窗備註 \"], d[\"Remark\"])\r\n\r\n                doc.Regenerate() \r\n                na_bb, nl_bb = na.get_BoundingBox(view), nl.get_BoundingBox(view)\r\n                if na_bb and nl_bb:\r\n                    na_center_x, na_bottom_y = (na_bb.Min.X + na_bb.Max.X)/2.0, na_bb.Min.Y\r\n                    abs_fl_y = na_bottom_y + (FL_OFF_CM / 30.48) - (SHIFT_DOWN_CM / 30.48)\r\n                    nl_center_x, nl_bottom_y = (nl_bb.Min.X + nl_bb.Max.X)/2.0, nl_bb.Min.Y\r\n                    target_nl_y = abs_fl_y + d[\"Sill_ft\"]\r\n                    \r\n                    # 🌟 v3.3.0 智能防飄浮機制 (Anti-Floating Logic) 🌟\r\n                    bb_h = nl_bb.Max.Y - nl_bb.Min.Y\r\n                    h_ft = float(d[\"H_str\"]) / 30.48 if not d[\"is_curtain\"] else 0\r\n                    extra_h = bb_h - h_ft\r\n                    \r\n                    # 如果多出來的高度大於 30cm 或大於半個台度，認定它包含了「長到地板的主體牆」\r\n                    if not d[\"is_curtain\"] and not d[\"is_d\"] and extra_h > max(1.0, d[\"Sill_ft\"] * 0.5):\r\n                        actual_move_y = abs_fl_y - nl_bottom_y # 對齊地板\r\n                    else:\r\n                        actual_move_y = target_nl_y - nl_bottom_y # 對齊窗台\r\n                        \r\n                    ElementTransformUtils.MoveElement(doc, nl.Id, XYZ(na_center_x - nl_center_x, actual_move_y, 0))\r\n                    \r\n                    doc.Regenerate() \r\n                    nl_bb_new = nl.get_BoundingBox(view)\r\n                    if nl_bb_new:\r\n                        fl_curve = doc.Create.NewDetailCurve(view, Line.CreateBound(XYZ(na_center_x - 2.0, abs_fl_y, 0), XYZ(na_center_x + 2.0, abs_fl_y, 0)))\r\n                        dot_len = 0.02 \r\n                        \r\n                        if not d[\"is_curtain\"]:\r\n                            w_ft = (float(d[\"W_str\"]) / 2.0) / 30.48\r\n                            l, r = na_center_x - w_ft, na_center_x + w_ft\r\n                            h_ft = float(d[\"H_str\"]) / 30.48\r\n                            b, t = target_nl_y, target_nl_y + h_ft\r\n                            dim_w_txt, dim_h_txt = d[\"W_str\"] + \"\\u200b\", d[\"H_str\"] + \"\\u200b\"\r\n                        else:\r\n                            l, r = nl_bb_new.Min.X, nl_bb_new.Max.X\r\n                            b, t = nl_bb_new.Min.Y, nl_bb_new.Max.Y\r\n                            dim_w_txt = dim_h_txt = \"依現場尺寸\"\r\n                        \r\n                        # 1. 寬度標註\r\n                        line_w = Line.CreateBound(XYZ(l, t + 0.8, 0), XYZ(r, t + 0.8, 0))\r\n                        ref_l = doc.Create.NewDetailCurve(view, Line.CreateBound(XYZ(l, t + 0.8, 0), XYZ(l, t + 0.8 + dot_len, 0)))\r\n                        ref_r = doc.Create.NewDetailCurve(view, Line.CreateBound(XYZ(r, t + 0.8, 0), XYZ(r, t + 0.8 + dot_len, 0)))\r\n                        ref_arr_w = ReferenceArray()\r\n                        ref_arr_w.Append(ref_l.GeometryCurve.Reference); ref_arr_w.Append(ref_r.GeometryCurve.Reference)\r\n                        try: \r\n                            dim_w = doc.Create.NewDimension(view, line_w, ref_arr_w)\r\n                            dim_w.ValueOverride = dim_w_txt \r\n                        except: pass\r\n                        \r\n                        # 2. 高度與台度標註\r\n                        line_h = Line.CreateBound(XYZ(l - 0.8, abs_fl_y, 0), XYZ(l - 0.8, t + 0.5, 0))\r\n                        ref_arr_h = ReferenceArray()\r\n                        ref_arr_h.Append(fl_curve.GeometryCurve.Reference) \r\n                        if abs(b - abs_fl_y) > 0.03: \r\n                            ref_b = doc.Create.NewDetailCurve(view, Line.CreateBound(XYZ(l - 0.8, b, 0), XYZ(l - 0.8 - dot_len, b, 0)))\r\n                            ref_arr_h.Append(ref_b.GeometryCurve.Reference)\r\n                        ref_t = doc.Create.NewDetailCurve(view, Line.CreateBound(XYZ(l - 0.8, t, 0), XYZ(l - 0.8 - dot_len, t, 0)))\r\n                        ref_arr_h.Append(ref_t.GeometryCurve.Reference)\r\n                        try: \r\n                            dim_h = doc.Create.NewDimension(view, line_h, ref_arr_h)\r\n                            dim_h.ValueOverride = dim_h_txt \r\n                        except: pass\r\n\r\n            elif blk_s:\r\n                vec_blank = XYZ((BASE_X_CM + col * OFF_X_CM) / 30.48, (row * OFF_Y_CM - OFF_Y_CM) / 30.48, 0)\r\n                ElementTransformUtils.CopyElement(doc, blk_s.Id, vec_blank)\r\n                \r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        return \"✅ v3.3.0 大功告成！防飄浮機制啟動，所有門窗已完美降落，尺寸精準無誤！\"\r\n        \r\n    except Exception as e:\r\n        TransactionManager.Instance.ForceCloseTransaction()\r\n        return \"❌ 錯誤: \" + str(e)\r\n\r\nOUT = run_script()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6b4a670024b94091b1d9ee41070a8f45",
