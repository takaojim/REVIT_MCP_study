c6-19b1-4459-80c7-257827179a14-000d29e4,160392c6-19b1-4459-80c7-257827179a14-000d29e5,160392c6-19b1-4459-80c7-257827179a14-000d29e6,160392c6-19b1-4459-80c7-257827179a14-000d29e7,160392c6-19b1-4459-80c7-257827179a14-000d29e8,160392c6-19b1-4459-80c7-257827179a14-000d29e9,160392c6-19b1-4459-80c7-257827179a14-000d29ea,160392c6-19b1-4459-80c7-257827179a14-000d29eb,160392c6-19b1-4459-80c7-257827179a14-000d29ec,160392c6-19b1-4459-80c7-257827179a14-000d29ed,160392c6-19b1-4459-80c7-257827179a14-000d29ee,160392c6-19b1-4459-80c7-257827179a14-000d29ef,160392c6-19b1-4459-80c7-257827179a14-000d29f0,160392c6-19b1-4459-80c7-257827179a14-000d29f1,160392c6-19b1-4459-80c7-257827179a14-000d29f2,160392c6-19b1-4459-80c7-257827179a14-000d29f3",
      "Description": "從 Revit 文件中選取多個元素。"
    }
  ],
  "Outputs": [
    {
      "Id": "062caf7c99184742bff0da33d49e4201",
      "Name": "Watch",
      "Type": "string",
      "InitialValue": "妹妹報告：採用小明哥的「原地重建大法」！成功將 59 個文字轉回水平 0 度！",
      "Description": "視覺化節點的輸出"
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# 載入 Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# 載入 Revit Services\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# 取得目前的 Revit 文件\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# 取得輸入的元素\r\nelements = UnwrapElement(IN[0])\r\n\r\n# 確保輸入是扁平清單，避免框選時的巢狀結構報錯\r\ndef flatten(lst):\r\n    res = []\r\n    for i in lst:\r\n        if isinstance(i, list) or isinstance(i, tuple):\r\n            res.extend(flatten(i))\r\n        else:\r\n            res.append(i)\r\n    return res\r\n\r\nif isinstance(elements, list) or isinstance(elements, tuple):\r\n    elements = flatten(elements)\r\nelse:\r\n    elements = [elements]\r\n\r\n# 開啟交易\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nreplaced_count = 0\r\nerror_count = 0\r\n\r\nfor elem in elements:\r\n    if elem:\r\n        try:\r\n            # 確認是文字註釋\r\n            if elem.GetType().Name == \"TextNote\":\r\n                \r\n                # 1. 記住舊文字的所有重要屬性\r\n                text_str = elem.Text                  # 文字內容\r\n                location = elem.Coord                 # 插入點座標\r\n                type_id = elem.GetTypeId()            # 文字類型 (字體、大小等)\r\n                view_id = elem.OwnerViewId            # 所屬視圖 ID\r\n                \r\n                # 2. 在同一個視圖、同一個位置，用同一個文字類型，建立全新的文字\r\n                # 預設建立出來的文字絕對是 0 度水平的\r\n                TextNote.Create(doc, view_id, location, text_str, type_id)\r\n                \r\n                # 3. 毀屍滅跡 (刪除原本傾斜的舊文字)\r\n                doc.Delete(elem.Id)\r\n                \r\n                replaced_count += 1\r\n                \r\n        except Exception as e:\r\n            error_count += 1\r\n            pass # 如果有鎖定 (Pinned) 或其他權限問題，先略過\r\n\r\n# 結束交易\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# 輸出執行結果\r\nif error_count == 0:\r\n    OUT = f\"妹妹報告：採用小明哥的「原地重建大法」！成功將 {replaced_count} 個文字轉回水平 0 度！\"\r\nelse:\r\n    OUT = f\"妹妹報告：成功重建 {replaced_count} 個文字。但有 {error_count} 個處理失敗 (可能被圖釘鎖定了)。\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6c5029959cef4bee8d50ce2a28b4c9ad",
      "NodeType": "PythonScriptNode",
