  "Outputs": [
    {
      "Id": "d9328d7d2219421a9d5d69bfef27052e",
      "Name": "Watch",
      "Type": "unknown",
      "InitialValue": "",
      "Description": "視覺化節點的輸出"
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport time\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- [參數解析] ---\r\nraw_data = IN[0]  \r\nactive_view = doc.ActiveView\r\n\r\n# 處理字體\r\ntext_types = FilteredElementCollector(doc).OfClass(TextNoteType)\r\nmy_text_type = next((t for t in text_types if \"3mm_Red\" in t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString()), None)\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\nif not my_text_type:\r\n    base_type = text_types.FirstElement()\r\n    my_text_type = base_type.Duplicate(\"3mm_Red\")\r\n    my_text_type.get_Parameter(BuiltInParameter.LINE_COLOR).Set(255) \r\n    my_text_type.get_Parameter(BuiltInParameter.TEXT_SIZE).Set(3.0 / 304.8) \r\n\r\n# --- [暴力破解資料結構] ---\r\nclean_data = []\r\n\r\ndef extract_rows(data):\r\n    try:\r\n        for row in data:\r\n            try:\r\n                r = list(row)\r\n                if len(r) >= 3:\r\n                    pt_id = str(r[0]).strip()\r\n                    x_val = str(r[1]).strip()\r\n                    y_val = str(r[2]).strip()\r\n                    \r\n                    if \"點\" in pt_id or \"X\" in x_val or not pt_id or pt_id.lower() == \"null\":\r\n                        continue\r\n                        \r\n                    x = float(x_val) * 100\r\n                    y = float(y_val) * 100\r\n                    clean_data.append([pt_id, x, y])\r\n            except:\r\n                if hasattr(row, '__iter__') and not isinstance(row, str):\r\n                    extract_rows(row)\r\n    except:\r\n        pass\r\n\r\nextract_rows(raw_data)\r\n\r\n# --- [生成圖元與群組] ---\r\nif clean_data:\r\n    min_x = min(r[1] for r in clean_data)\r\n    min_y = min(r[2] for r in clean_data)\r\n    \r\n    base_x, base_y = min_x - 100.0, min_y - 100.0\r\n    \r\n    xyz_pts = [] \r\n    cross_size = 20.0 / 30.48 \r\n    \r\n    # 建立一個專門裝 ElementId 的籃子\r\n    element_ids = List[ElementId]()\r\n    \r\n    for pt_name, x, y in clean_data:\r\n        rev_x = (x - base_x) / 30.48\r\n        rev_y = (y - base_y) / 30.48\r\n        pos = XYZ(rev_x, rev_y, 0)\r\n        xyz_pts.append(pos)\r\n        \r\n        # 1. 建立文字標註並把 ID 丟進籃子\r\n        t_note = TextNote.Create(doc, active_view.Id, pos, pt_name, my_text_type.Id)\r\n        element_ids.Add(t_note.Id)\r\n        \r\n        # 2. 畫十字標記並把 ID 丟進籃子\r\n        p1 = XYZ(rev_x - cross_size/2, rev_y, 0)\r\n        p2 = XYZ(rev_x + cross_size/2, rev_y, 0)\r\n        p3 = XYZ(rev_x, rev_y - cross_size/2, 0)\r\n        p4 = XYZ(rev_x, rev_y + cross_size/2, 0)\r\n        \r\n        try:\r\n            line1 = doc.Create.NewDetailCurve(active_view, Line.CreateBound(p1, p2))\r\n            line2 = doc.Create.NewDetailCurve(active_view, Line.CreateBound(p3, p4))\r\n            element_ids.Add(line1.Id)\r\n            element_ids.Add(line2.Id)\r\n        except:\r\n            pass\r\n\r\n    # 3. 將點位依序連線並把 ID 丟進籃子\r\n    if len(xyz_pts) > 1:\r\n        for i in range(len(xyz_pts)):\r\n            ptA = xyz_pts[i]\r\n            ptB = xyz_pts[(i + 1) % len(xyz_pts)] \r\n            \r\n            try:\r\n                bound_line = doc.Create.NewDetailCurve(active_view, Line.CreateBound(ptA, ptB))\r\n                element_ids.Add(bound_line.Id)\r\n            except:\r\n                pass\r\n\r\n    # 4. 將籃子裡的所有東西打包成一個 2D 詳圖群組\r\n    if element_ids.Count > 0:\r\n        new_group = doc.Create.NewGroup(element_ids)\r\n        \r\n        # 給群組一個好辨識的名字 (加上 timestamp 防止重複報錯)\r\n        try:\r\n            group_name = \"地籍圖匯入_\" + str(int(time.time()))\r\n            new_group.GroupType.Name = group_name\r\n        except:\r\n            pass\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    OUT = \"完美殺青！畫了 {} 個點位，並已全部打包成群組！\\n原點偏移至(CM): X={}, Y={}\".format(len(clean_data), base_x, base_y)\r\nelse:\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    OUT = \"抓不到資料喔！\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "40bf5e35d9ba48fc9ea06e821c48759d",
      "NodeType": "PythonScriptNode",
