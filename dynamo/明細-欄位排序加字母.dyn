      "Replication": "Disabled",
      "Description": "建立一個字串。",
      "InputValue": "編號"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nactive_view = doc.ActiveView\r\n\r\n# 只需要 2 個輸入端 (IN[0]目標欄位, IN[1]前綴字)\r\nif len(IN) < 2:\r\n    OUT = \"⚠️ 錯誤：只需要 2 個輸入端 (IN[0]目標欄位, IN[1]前綴字) 喔！\"\r\nelse:\r\n    param_name = IN[0] \r\n    prefix = str(IN[1]) if IN[1] else \"\"\r\n\r\n    def get_parameter_value(el, p_name):\r\n        p = el.LookupParameter(p_name)\r\n        if p and p.HasValue:\r\n            return p.AsValueString() or p.AsString() or str(p.AsDouble())\r\n        \r\n        tid = el.GetTypeId()\r\n        if tid != ElementId.InvalidElementId:\r\n            etype = doc.GetElement(tid)\r\n            if etype:\r\n                p_type = etype.LookupParameter(p_name)\r\n                if p_type and p_type.HasValue:\r\n                    return p_type.AsValueString() or p_type.AsString() or str(p_type.AsDouble())\r\n        return \"\"\r\n\r\n    if isinstance(active_view, ViewSchedule):\r\n        elements = list(FilteredElementCollector(doc, active_view.Id).WhereElementIsNotElementType().ToElements())\r\n        \r\n        # 【小明核心智慧】：自動偵測是「實體參數」還是「類型參數」\r\n        is_type_param = False\r\n        is_instance_param = False\r\n        \r\n        if elements:\r\n            test_el = elements[0]\r\n            p_inst = test_el.LookupParameter(param_name)\r\n            if p_inst and not p_inst.IsReadOnly:\r\n                is_instance_param = True\r\n            else:\r\n                tid = test_el.GetTypeId()\r\n                if tid != ElementId.InvalidElementId:\r\n                    etype = doc.GetElement(tid)\r\n                    if etype:\r\n                        p_type = etype.LookupParameter(param_name)\r\n                        if p_type and not p_type.IsReadOnly:\r\n                            is_type_param = True\r\n\r\n        existing_values = []\r\n        for el in elements:\r\n            val = get_parameter_value(el, param_name)\r\n            if val and val not in existing_values:\r\n                existing_values.append(val)\r\n\r\n        table_data = active_view.GetTableData()\r\n        body_data = table_data.GetSectionData(SectionType.Body)\r\n        num_rows = body_data.NumberOfRows\r\n        num_cols = body_data.NumberOfColumns\r\n        \r\n        visual_order_list = []\r\n        for r in range(num_rows):\r\n            for c in range(num_cols):\r\n                cell_text = active_view.GetCellText(SectionType.Body, r, c)\r\n                if cell_text in existing_values and cell_text not in visual_order_list:\r\n                    visual_order_list.append(cell_text)\r\n\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        \r\n        count = 1\r\n        processed_types = [] \r\n        \r\n        for target_old_val in visual_order_list:\r\n            updated_type_this_turn = False\r\n            \r\n            for el in elements:\r\n                old_val = get_parameter_value(el, param_name)\r\n                \r\n                if old_val == target_old_val:\r\n                    if is_type_param:\r\n                        # 【類型參數】：改完族群類型後做記號\r\n                        tid = el.GetTypeId()\r\n                        if tid != ElementId.InvalidElementId and tid not in processed_types:\r\n                            etype = doc.GetElement(tid)\r\n                            p_type = etype.LookupParameter(param_name)\r\n                            if p_type and not p_type.IsReadOnly:\r\n                                try:\r\n                                    p_type.Set(prefix + str(count))\r\n                                    updated_type_this_turn = True\r\n                                    processed_types.append(tid) \r\n                                except:\r\n                                    pass\r\n                    \r\n                    elif is_instance_param:\r\n                        # 【實體參數】：每發出一個號碼，號碼機立刻 +1！絕對不重複！\r\n                        p_inst = el.LookupParameter(param_name)\r\n                        if p_inst and not p_inst.IsReadOnly:\r\n                            try:\r\n                                p_inst.Set(prefix + str(count))\r\n                                count += 1 \r\n                            except:\r\n                                pass\r\n                                \r\n            # 如果是類型參數，同一款全部處理完，號碼機才 +1\r\n            if is_type_param and updated_type_this_turn:\r\n                count += 1\r\n                \r\n        TransactionManager.Instance.TransactionTaskDone()\r\n        \r\n        param_type_str = \"類型參數\" if is_type_param else (\"實體參數\" if is_instance_param else \"唯讀參數\")\r\n        OUT = \"【突破盲點大成功】！目標為「{}」！成功發放了 {} 個不重複的獨立號碼！優呵！\".format(param_type_str, count - 1)\r\n    else:\r\n        OUT = \"錯誤：請確認你在明細表視窗喔！\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "4adf134563954f47accd8a68037b638d",
