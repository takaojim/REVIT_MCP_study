    {
      "Id": "667f6ad3dfa444e2997f300df6f9d062",
      "Name": "1.選你要放瓦的屋頂",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "c2848c47-a1cd-45b5-869c-a8764490e072-0009e1a1,c2848c47-a1cd-45b5-869c-a8764490e072-0009e1a4,ace0d3ff-f026-4133-b9c1-64fc956a7b13-0009e36a",
      "Description": "從 Revit 文件中選取多個元素。"
