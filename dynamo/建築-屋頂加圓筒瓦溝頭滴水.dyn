      "Description": "視覺化節點的輸出"
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\nimport math\r\nimport time\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef flatten_list(lst):\r\n    result = []\r\n    for i in lst:\r\n        if isinstance(i, list) or type(i).__name__ == 'list':\r\n            result.extend(flatten_list(i))\r\n        else:\r\n            result.append(i)\r\n    return result\r\n\r\ndef get_midpoint(p1, p2):\r\n    return Point.ByCoordinates((p1.X+p2.X)/2.0, (p1.Y+p2.Y)/2.0, (p1.Z+p2.Z)/2.0)\r\n\r\ndef add_vec(v1, v2):\r\n    return Vector.ByCoordinates(v1.X+v2.X, v1.Y+v2.Y, v1.Z+v2.Z)\r\n\r\n# --- 1. 取得所有輸入參數 ---\r\ninput_objs = flatten_list(IN[0] if isinstance(IN[0], list) else [IN[0]])\r\nradius = float(IN[1])\r\nspacing = float(IN[2])\r\nref_plane_element = UnwrapElement(IN[3])\r\ndrip_thick = float(IN[4])\r\nwadang_thick = float(IN[5])\r\nextend_len = drip_thick + wadang_thick\r\nmat_name = IN[6] if len(IN) > 6 and IN[6] else \"傳統青灰瓦\"\r\n\r\n# 💡 新增：讀取 IN[7] 的布林值切換選集模式\r\nuse_selection_set = IN[7] if len(IN) > 7 else False\r\nsel_set_name = \"000\"\r\n\r\nif spacing <= 0: spacing = 28.0\r\n\r\nsolids = []\r\ndebug_log = [\"--- 妹妹的選集升級版追蹤器報告 ---\"] \r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# --- 💡 新增：選集攔截系統 ---\r\nif use_selection_set:\r\n    debug_log.append(\"🔍 [模式] 啟用「儲存選集」：正在尋找名為 '{}' 的選集...\".format(sel_set_name))\r\n    collector = FilteredElementCollector(doc).OfClass(SelectionFilterElement)\r\n    sel_filter = None\r\n    for f in collector:\r\n        if f.Name == sel_set_name:\r\n            sel_filter = f\r\n            break\r\n            \r\n    if sel_filter is not None:\r\n        sel_ids = sel_filter.GetElementIds()\r\n        input_objs = [doc.GetElement(e_id) for e_id in sel_ids]\r\n        debug_log.append(\"  ➔ 成功載入選集 '{}'，共提取出 {} 個物件！\".format(sel_set_name, len(input_objs)))\r\n    else:\r\n        debug_log.append(\"  ⚠️ 找不到名為 '{}' 的選集！自動退回使用 IN[0] 的選取物件。\".format(sel_set_name))\r\nelse:\r\n    debug_log.append(\"🔍 [模式] 啟用「直接選取」：讀取 IN[0] 的物件...\")\r\n\r\n# --- 2. 雙軌修復過濾器 (實體過橋 + 邊緣織皮救磚術) ---\r\nsurfaces = []\r\nfor obj_idx, obj in enumerate(input_objs):\r\n    if obj is None: continue\r\n    \r\n    revit_el = UnwrapElement(obj)\r\n    if hasattr(revit_el, \"get_Geometry\"):\r\n        opt = Options()\r\n        opt.ComputeReferences = True\r\n        opt.DetailLevel = ViewDetailLevel.Fine\r\n        geom_element = revit_el.get_Geometry(opt)\r\n        \r\n        el_srf_count = 0\r\n        if geom_element is not None:\r\n            def extract_solids(geom_sel):\r\n                res = []\r\n                for g in geom_sel:\r\n                    if type(g).__name__ == \"Solid\" and g.Faces.Size > 0:\r\n                        res.append(g)\r\n                    elif type(g).__name__ == \"GeometryInstance\":\r\n                        res.extend(extract_solids(g.GetInstanceGeometry()))\r\n                return res\r\n                \r\n            all_solids = extract_solids(geom_element)\r\n            \r\n            for solid in all_solids:\r\n                is_closed = solid.Volume > 0\r\n                solid_success = False\r\n                try:\r\n                    proto_solid = solid.ToProtoType()\r\n                    if proto_solid is not None:\r\n                        for pf in proto_solid.Faces:\r\n                            norm = pf.NormalAtParameter(0.5, 0.5)\r\n                            if (is_closed and norm.Z > 0.1) or (not is_closed and abs(norm.Z) > 0.1):\r\n                                surfaces.append(pf)\r\n                                el_srf_count += 1\r\n                        solid_success = True\r\n                except: pass\r\n                    \r\n                if solid_success: continue \r\n                \r\n                for f in solid.Faces:\r\n                    try:\r\n                        uv_box = f.GetBoundingBox()\r\n                        uv_center = Autodesk.Revit.DB.UV((uv_box.Min.U + uv_box.Max.U) / 2.0, (uv_box.Min.V + uv_box.Max.V) / 2.0)\r\n                        native_norm = f.ComputeNormal(uv_center)\r\n                        \r\n                        is_candidate = (is_closed and native_norm.Z > 0.1) or (not is_closed and abs(native_norm.Z) > 0.1)\r\n                        if not is_candidate: continue\r\n                        \r\n                        try:\r\n                            proto_res = f.ToProtoType()\r\n                            srfs_to_test = proto_res if isinstance(proto_res, list) else [proto_res]\r\n                            for srf_geo in srfs_to_test:\r\n                                surfaces.append(srf_geo)\r\n                                el_srf_count += 1\r\n                        except:\r\n                            curves = []\r\n                            for loop in f.EdgeLoops:\r\n                                for edge in loop:\r\n                                    curves.append(edge.AsCurve().ToProtoType())\r\n                            if curves:\r\n                                try:\r\n                                    joined_poly = PolyCurve.ByJoinedCurves(curves)\r\n                                    patched_srf = Surface.ByPatch(joined_poly) \r\n                                    surfaces.append(patched_srf)\r\n                                    el_srf_count += 1\r\n                                except: pass\r\n                    except: pass\r\n                    \r\n        debug_log.append(\"🏠 解析第 {} 個屋頂元件：成功提取出 {} 個完美的排水面！\".format(obj_idx + 1, el_srf_count))\r\n    else:\r\n        surfaces.append(obj)\r\n\r\nvalid_surfaces = [s for s in surfaces if s is not None]\r\ndebug_log.append(\"✅ 最終進入核心計算的有效表面總數: {} 個\".format(len(valid_surfaces)))\r\n\r\nif len(valid_surfaces) == 0:\r\n    debug_log.append(\"⚠️ [警告] 找不到任何有效的排水面！請確認選取物件。\")\r\nelse:\r\n    # --- 3. 處理材質 ---\r\n    mat_id = ElementId.InvalidElementId\r\n    collector = FilteredElementCollector(doc).OfClass(Material)\r\n    for m in collector:\r\n        if m.Name == mat_name:\r\n            mat_id = m.Id\r\n            break\r\n    if mat_id == ElementId.InvalidElementId:\r\n        try:\r\n            mat_id = Material.Create(doc, mat_name)\r\n            new_mat = doc.GetElement(mat_id)\r\n            new_mat.Color = Color(100, 100, 100)\r\n        except: pass\r\n\r\n    # --- 4. 計算參考平面與強制排序陣列 ---\r\n    try:\r\n        revit_plane = ref_plane_element.GetPlane()\r\n        base_plane = revit_plane.ToPlane()\r\n        plane_normal = base_plane.Normal\r\n        \r\n        min_pts, max_pts = [], []\r\n        for srf in valid_surfaces:\r\n            bbox = srf.BoundingBox\r\n            min_pts.append(bbox.MinPoint)\r\n            max_pts.append(bbox.MaxPoint)\r\n                \r\n        if min_pts:\r\n            min_x, min_y, min_z = min([p.X for p in min_pts]), min([p.Y for p in min_pts]), min([p.Z for p in min_pts])\r\n            max_x, max_y, max_z = max([p.X for p in max_pts]), max([p.Y for p in max_pts]), max([p.Z for p in max_pts])\r\n            corners = [\r\n                Point.ByCoordinates(min_x, min_y, min_z), Point.ByCoordinates(max_x, min_y, min_z),\r\n                Point.ByCoordinates(max_x, max_y, min_z), Point.ByCoordinates(min_x, max_y, min_z),\r\n                Point.ByCoordinates(min_x, min_y, max_z), Point.ByCoordinates(max_x, min_y, max_z),\r\n                Point.ByCoordinates(max_x, max_y, max_z), Point.ByCoordinates(min_x, max_y, max_z)\r\n            ]\r\n            \r\n            max_dist, min_dist = 0.0, 0.0\r\n            for pt in corners:\r\n                vec = Vector.ByTwoPoints(base_plane.Origin, pt)\r\n                dist = vec.Dot(plane_normal)\r\n                if dist > max_dist: max_dist = dist\r\n                if dist < min_dist: min_dist = dist\r\n                \r\n            d_values = []\r\n            d = 0.0\r\n            while d <= max_dist + spacing:\r\n                d_values.append(d)\r\n                d += spacing\r\n            d = -spacing\r\n            while d >= min_dist - spacing:\r\n                d_values.append(d)\r\n                d -= spacing\r\n                \r\n            d_values.sort() \r\n            \r\n            cutting_planes = []\r\n            for d in d_values:\r\n                vec_offset = plane_normal.Scale(d)\r\n                new_origin = base_plane.Origin.Translate(vec_offset)\r\n                cutting_planes.append(Plane.ByOriginNormal(new_origin, plane_normal))\r\n                \r\n            # --- 5. 產生圓柱筒瓦並將基準線投入「全域大熔爐」 ---\r\n            global_curves = [] \r\n            \r\n            for srf_idx, srf in enumerate(valid_surfaces):\r\n                srf_crv_count = 0\r\n                for cp in cutting_planes:\r\n                    intersections = srf.Intersect(cp)\r\n                    try: intersections = list(intersections) if not isinstance(intersections, list) else intersections\r\n                    except: intersections = [intersections]\r\n                            \r\n                    for geom in intersections:\r\n                        try:\r\n                            if extend_len > 0:\r\n                                test_ext_start = geom.ExtendStart(extend_len)\r\n                                test_ext_end = geom.ExtendEnd(extend_len)\r\n                                if test_ext_start.StartPoint.Z < test_ext_end.EndPoint.Z: ext_crv = test_ext_start\r\n                                else: ext_crv = test_ext_end\r\n                            else: ext_crv = geom\r\n                            \r\n                            z_diff = abs(ext_crv.StartPoint.Z - ext_crv.EndPoint.Z)\r\n                            if z_diff < 0.1: continue \r\n                                \r\n                            crv_plane = ext_crv.PlaneAtParameter(0.0) if ext_crv.StartPoint.Z < ext_crv.EndPoint.Z else ext_crv.PlaneAtParameter(1.0)\r\n                            circle = Circle.ByPlaneRadius(crv_plane, radius)\r\n                            solids.append(Solid.BySweep(circle, ext_crv))\r\n                            \r\n                            eval_pt = ext_crv.StartPoint\r\n                            sort_val = Vector.ByTwoPoints(base_plane.Origin, eval_pt).Dot(plane_normal)\r\n                            global_curves.append((sort_val, ext_crv))\r\n                            srf_crv_count += 1\r\n                        except Exception: pass \r\n                debug_log.append(\"  ➔ 面 {} 切割出 {} 條基準線\".format(srf_idx + 1, srf_crv_count))\r\n                \r\n            # --- 6. 全域排序與跨面滴水無縫生成 ---\r\n            global_curves.sort(key=lambda x: x[0])\r\n            sorted_curves = [item[1] for item in global_curves]\r\n            \r\n            success_count = 0\r\n            for i in range(len(sorted_curves) - 1):\r\n                try:\r\n                    crvA = sorted_curves[i]\r\n                    crvB = sorted_curves[i+1]\r\n                    \r\n                    if crvA.StartPoint.Z < crvA.EndPoint.Z:\r\n                        ptA, vec_upA = crvA.StartPoint, crvA.TangentAtParameter(0)\r\n                    else:\r\n                        ptA, vec_upA = crvA.EndPoint, crvA.TangentAtParameter(1).Reverse()\r\n                        \r\n                    if crvB.StartPoint.Z < crvB.EndPoint.Z:\r\n                        ptB, vec_upB = crvB.StartPoint, crvB.TangentAtParameter(0)\r\n                    else:\r\n                        ptB, vec_upB = crvB.EndPoint, crvB.TangentAtParameter(1).Reverse()\r\n                    \r\n                    dist_AB = ptA.DistanceTo(ptB)\r\n                    \r\n                    if dist_AB > spacing * 2.5 or dist_AB < 1.0: continue \r\n                    \r\n                    vec_up_sum = add_vec(vec_upA, vec_upB)\r\n                    vec_up = vec_up_sum.Normalized()\r\n                    \r\n                    drip_ptA = ptA.Translate(vec_up, wadang_thick)\r\n                    drip_ptB = ptB.Translate(vec_up, wadang_thick)\r\n                    \r\n                    vec_X = Vector.ByTwoPoints(drip_ptA, drip_ptB).Normalized()\r\n                    vec_down = vec_up.Cross(vec_X).Normalized()\r\n                    if vec_down.Z > 0: vec_down = vec_down.Reverse() \r\n                    \r\n                    R_arc = 1.5 * spacing\r\n                    drop = radius * 2.0\r\n                    \r\n                    pM = get_midpoint(drip_ptA, drip_ptB)\r\n                    pC = pM.Translate(vec_down, drop) \r\n                    \r\n                    dist_dripAB = drip_ptA.DistanceTo(drip_ptB)\r\n                    if R_arc > dist_dripAB / 2.0:\r\n                        h_T = R_arc - math.sqrt(R_arc**2 - (dist_dripAB / 2.0)**2)\r\n                        pT = pM.Translate(vec_down, h_T)\r\n                    else: pT = pM\r\n                    \r\n                    vec_AC = Vector.ByTwoPoints(drip_ptA, pC)\r\n                    L_AC = vec_AC.Length\r\n                    pM_AC = get_midpoint(drip_ptA, pC) \r\n                    N_AC = vec_AC.Cross(vec_up).Normalized()\r\n                    dir_left = add_vec(vec_X.Scale(-1), vec_down)\r\n                    if N_AC.Dot(dir_left) < 0: N_AC = N_AC.Reverse()\r\n                    \r\n                    if R_arc > L_AC / 2.0:\r\n                        h_AC = R_arc - math.sqrt(R_arc**2 - (L_AC / 2.0)**2) \r\n                        pL = pM_AC.Translate(N_AC, h_AC)\r\n                    else: pL = pM_AC\r\n                    \r\n                    vec_CB = Vector.ByTwoPoints(pC, drip_ptB)\r\n                    L_CB = vec_CB.Length\r\n                    pM_CB = get_midpoint(pC, drip_ptB) \r\n                    N_CB = vec_CB.Cross(vec_up).Normalized()\r\n                    dir_right = add_vec(vec_X, vec_down)\r\n                    if N_CB.Dot(dir_right) < 0: N_CB = N_CB.Reverse()\r\n                    \r\n                    if R_arc > L_CB / 2.0:\r\n                        h_CB = R_arc - math.sqrt(R_arc**2 - (L_CB / 2.0)**2) \r\n                        pR = pM_CB.Translate(N_CB, h_CB)\r\n                    else: pR = pM_CB\r\n                    \r\n                    arc1 = Arc.ByThreePoints(drip_ptA, pT, drip_ptB)\r\n                    arc2 = Arc.ByThreePoints(drip_ptB, pR, pC)\r\n                    arc3 = Arc.ByThreePoints(pC, pL, drip_ptA)\r\n                    drip_profile = PolyCurve.ByJoinedCurves([arc1, arc2, arc3])\r\n                    drip_solid = drip_profile.ExtrudeAsSolid(vec_up, drip_thick)\r\n                    \r\n                    planeA = Plane.ByOriginNormal(ptA, vec_upA)\r\n                    circleA = Circle.ByPlaneRadius(planeA, radius * 1.1)\r\n                    wadangA = circleA.ExtrudeAsSolid(vec_upA, wadang_thick)\r\n                    \r\n                    planeB = Plane.ByOriginNormal(ptB, vec_upB)\r\n                    circleB = Circle.ByPlaneRadius(planeB, radius * 1.1)\r\n                    wadangB = circleB.ExtrudeAsSolid(vec_upB, wadang_thick)\r\n                    \r\n                    try:\r\n                        union_solid = Solid.ByUnion([drip_solid, wadangA, wadangB])\r\n                        solids.append(union_solid)\r\n                        success_count += 1\r\n                    except:\r\n                        solids.extend([drip_solid, wadangA, wadangB])\r\n                        success_count += 1\r\n                except Exception: pass\r\n            debug_log.append(\"\\n🌟 全域跨面融合：成功生成 {} 組滴水與瓦當！\".format(success_count))\r\n            \r\n    except Exception as e:\r\n        debug_log.append(\"❌ 重大錯誤: \" + str(e))\r\n\r\n# --- 7. 寫入 Revit 並自動群組 ---\r\nrevit_elements = []\r\ncat_id = ElementId(BuiltInCategory.OST_Roofs) \r\n\r\nfor d_solid in solids:\r\n    if d_solid is None or isinstance(d_solid, str): continue\r\n    try:\r\n        r_geom = d_solid.ToRevitType()\r\n        geom_list = List[GeometryObject]()\r\n        if isinstance(r_geom, list) or type(r_geom).__name__ in [\"Array[GeometryObject]\", \"tuple\"]:\r\n            for g in r_geom: \r\n                if mat_id != ElementId.InvalidElementId and hasattr(g, \"MaterialId\"): g.MaterialId = mat_id\r\n                geom_list.Add(g)\r\n        else: \r\n            if mat_id != ElementId.InvalidElementId and hasattr(r_geom, \"MaterialId\"): r_geom.MaterialId = mat_id\r\n            geom_list.Add(r_geom)\r\n            \r\n        ds = DirectShape.CreateElement(doc, cat_id)\r\n        ds.SetShape(geom_list)\r\n        ds.Name = \"Traditional_Roof_System\"\r\n        revit_elements.append(ds)\r\n    except: pass\r\n\r\ngroup_element = None\r\nif revit_elements:\r\n    id_list = List[ElementId]()\r\n    for el in revit_elements: id_list.Add(el.Id)\r\n    try:\r\n        group_element = doc.Create.NewGroup(id_list)\r\n        group_element.GroupType.Name = \"瓦當與滴水系統_\" + str(int(time.time())) \r\n    except: pass\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = [revit_elements if group_element is None else group_element, debug_log]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0e1798bc7122401e89e9eea3046b4ef0",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "d09510d2ea524731902362f802f4e1f1",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "095880b23ec44b21bfd121decaf8fb6a",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "87ca49b5036a4a73b96c9df562f6d83a",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a621755ec6c3436e8d74c38c4758cf22",
          "Name": "IN[3]",
